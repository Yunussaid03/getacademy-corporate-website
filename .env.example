# Korporatly Group Corporate Website - Google SMTP Email Dispatch Configuration
# Never commit real credentials or expose these values to client-side code.
# Configure these environment variables in your Vercel Project Settings:
# Settings > Environment Variables, or in a local .env file (already gitignored).

# SMTP Server Settings (Google SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Authentication Account (Use Google Workspace App Password, not main account password)
SMTP_USER=corporatewellness@korporatlygroup.com
SMTP_PASS=your-google-workspace-app-password

# Email Routing & Headers
# Initial recipient: corporatewellness@korporatlygroup.com
# To switch recipient to admin@korporatlygroup.com later, simply update this variable in Vercel.
ENQUIRY_RECIPIENT_EMAIL=corporatewellness@korporatlygroup.com
ENQUIRY_SENDER_EMAIL="Korporatly Group Enquiries <corporatewellness@korporatlygroup.com>"

