---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import PageHero from '@/components/ui/PageHero.astro';
import {
  Mail,
  MapPin,
  Send,
  ShieldCheck,
  Clock,
  ExternalLink,
  Building2
} from 'lucide-astro';
import { site, mapsUrl } from '@/data/site';

const trainingTracks = [
  'Digital Marketing & E-Commerce (CDMS)',
  'Business Incubation: Done For You (DFY)',
  'Global IT Certification (CompTIA, ITIL)',
  'Professional Development & Leadership',
  'Artificial Intelligence Capacity Building',
  'Custom In-House Programme'
];

const sectors = [
  'Private Enterprise / Corporation',
  'Government / Statutory Body',
  'School / College / University',
  'Business Owner / SME',
  'Individual Professional / Student'
];
---

<BaseLayout
  title="Contact Us — Corporate Training Consultation"
  description="Connect with GET Academy's training advisors for tailored training proposals, course outlines and HRDC claimable programmes. Level 33, Ilham Tower, Kuala Lumpur."
>
  <PageHero
    eyebrow="Get in Touch"
    title="Contact GET Academy"
    description="Connect with our training advisors for tailored proposals, course outlines, trainer profiles and HRD Corp application support."
  />

  <!-- Main Content Grid -->
  <section class="py-20 bg-brand-light">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        <!-- Left Column: Direct Consultation Channels -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <SectionHeader
              eyebrow="Direct Enquiry Channels"
              title="We Are Ready to Assist Your Organisation"
              subtitle="Whether you represent an enterprise requiring customized team upskilling, a statutory body seeking institutional transformation, or an HR professional exploring HRD Corp funding, our training team is ready to consult with you."
            />
          </div>

          <!-- Official Channels Card -->
          <div class="bg-white rounded-2xl p-7 border border-brand-border shadow-sm space-y-5">
            <h3 class="font-bold text-brand-dark text-base border-b border-brand-border pb-3">
              Official Corporate Desk
            </h3>

            <address class="not-italic space-y-5 text-sm">
              <div class="flex items-start gap-3.5">
                <Building2 class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold block text-xs uppercase tracking-wider text-brand-muted">Corporate Entity</span>
                  <p class="text-brand-dark font-medium mt-0.5">{site.legalName}</p>
                  <span class="text-[11px] text-brand-muted">{site.llpNumber}</span>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <MapPin class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold block text-xs uppercase tracking-wider text-brand-muted">Registered Office Address</span>
                  <p class="text-brand-dark font-medium mt-0.5 leading-relaxed">
                    {site.address.lines.map((line, i) => (
                      <>
                        {line}
                        {i < site.address.lines.length - 1 && <br />}
                      </>
                    ))}
                  </p>
                  <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1.5 inline-flex items-center gap-1 text-xs font-bold text-brand-sage hover:text-brand-sage-dark">
                    <span>Open in Google Maps</span>
                    <ExternalLink class="w-3 h-3" />
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <Mail class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold block text-xs uppercase tracking-wider text-brand-muted">Enquiry Email</span>
                  <a href={`mailto:${site.email}`} class="text-brand-dark font-medium mt-0.5 inline-block hover:text-brand-sage transition-colors">{site.email}</a>
                </div>
              </div>
            </address>

            <!-- Response Commitment Badge -->
            <div class="p-4 bg-brand-light rounded-xl border border-brand-border flex items-center gap-3">
              <Clock class="w-5 h-5 text-brand-sage shrink-0" />
              <p class="text-xs text-brand-muted leading-relaxed">
                <strong>Response Commitment:</strong> Custom proposals, syllabus details and HRD Corp application documents are provided within <strong>{site.responseTime}</strong> upon enquiry.
              </p>
            </div>
          </div>

          <!-- Training Consultation Assistance Box -->
          <div class="bg-brand-sage text-white rounded-2xl p-7 border border-brand-sage-dark shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-gold">Advisory Support</span>
              <ShieldCheck class="w-5 h-5 text-brand-gold" />
            </div>
            <h3 class="text-lg font-bold text-white">Dedicated Training Consultation</h3>
            <p class="text-xs text-gray-100 leading-relaxed">
              Our capability advisors work alongside corporate HR directors and training coordinators to structure tailored learning calendars, custom course syllabi, and itemized proposals.
            </p>
            <div class="pt-1 text-xs text-brand-gold font-semibold flex flex-wrap items-center gap-x-4 gap-y-1">
              <span>• Custom syllabus preparation</span>
              <span>• Transparent proposal schedules</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Corporate Enquiry Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl p-8 sm:p-10 border border-brand-border shadow-sm">
            <div class="mb-8">
              <span class="text-xs font-extrabold uppercase tracking-widest text-brand-sage block mb-1">Corporate Enquiry</span>
              <h2 class="text-2xl font-extrabold text-brand-dark">Send a Training Enquiry</h2>
              <p class="text-sm text-brand-muted mt-1">
                Complete the form below and our training consultants will respond to your requirements.
              </p>
            </div>

            <form id="corporate-enquiry-form" class="space-y-5">
              <!-- Full Name -->
              <div>
                <label for="contact-name" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="e.g. Sarah Jenkins"
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                />
              </div>

              <!-- Corporate Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-email" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Corporate / Work Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="name@company.com.my"
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  />
                </div>
                <div>
                  <label for="contact-phone" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Contact Phone / WhatsApp <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="contact-phone"
                    name="phone"
                    required
                    autocomplete="tel"
                    placeholder="+60 12-345 6789"
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  />
                </div>
              </div>

              <!-- Organisation & Sector -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-org" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Organisation / Company <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-org"
                    name="organisation"
                    required
                    autocomplete="organization"
                    placeholder="e.g. Apex Logistics Sdn Bhd"
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  />
                </div>
                <div>
                  <label for="contact-sector" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Sector / Entity Type <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="contact-sector"
                    name="sector"
                    required
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  >
                    <option value="">Select your sector...</option>
                    {sectors.map((s) => (
                      <option value={s}>{s}</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Training Category of Interest -->
              <div>
                <label for="contact-track" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Training Category of Interest <span class="text-red-500">*</span>
                </label>
                <select
                  id="contact-track"
                  name="track"
                  required
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                >
                  <option value="">Select course track...</option>
                  {trainingTracks.map((t) => (
                    <option value={t}>{t}</option>
                  ))}
                </select>
              </div>

              <!-- Estimated Participants -->
              <div>
                <label for="contact-participants" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Estimated Participant Count
                </label>
                <select
                  id="contact-participants"
                  name="participants"
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                >
                  <option value="1-5">1 – 5 Participants</option>
                  <option value="6-15" selected>6 – 15 Participants (Standard Cohort)</option>
                  <option value="16-30">16 – 30 Participants (Full Department)</option>
                  <option value="31+">30+ Participants (Enterprise-Wide)</option>
                </select>
              </div>

              <!-- Requirements Message -->
              <div>
                <label for="contact-message" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Specific Requirements or Target Schedule
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  placeholder="Outline your departmental objectives, target training month, or questions about HRD Corp claims..."
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                ></textarea>
              </div>

              <!-- Honeypot: hidden from visitors, catches automated submissions -->
              <div class="hidden" aria-hidden="true">
                <label for="contact-website">Website</label>
                <input type="text" id="contact-website" name="website_url" tabindex="-1" autocomplete="off" />
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-sage text-white font-bold rounded-xl hover:bg-brand-sage-dark transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-sage disabled:opacity-60"
                >
                  <Send class="w-4 h-4" />
                  <span>Submit Training Enquiry</span>
                </button>
              </div>
            </form>

            <div id="form-status" class="hidden" role="status" aria-live="polite"></div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initEnquiryForm } from '@/lib/enquiry-form';
  import { site } from '@/data/site';

  const form = document.getElementById('corporate-enquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  // Pre-fill course from URL query parameter (e.g. ?course=Critical%20Thinking)
  const urlParams = new URLSearchParams(window.location.search);
  const courseParam = urlParams.get('course');
  if (courseParam) {
    const messageBox = document.getElementById('contact-message') as HTMLTextAreaElement | null;
    if (messageBox) {
      messageBox.value = `Enquiring about the course: "${courseParam}". Please furnish the syllabus outline, fee quotation and HRD Corp claim details.`;
    }
  }

  if (form && status) {
    initEnquiryForm({
      form,
      status,
      formSource: 'contact-page',
      fallbackEmail: site.email,
      responseTime: site.responseTime,
    });
  }
</script>
