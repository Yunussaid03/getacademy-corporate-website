---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { 
  Mail, 
  Phone, 
  MapPin, 
  Send, 
  ShieldCheck, 
  Clock, 
  CheckCircle2, 
  ExternalLink,
  HelpCircle,
  AlertCircle
} from 'lucide-astro';

const trainingTracks = [
  '19 HRDC Claimable Courses',
  'Leadership & Management',
  'Workplace Performance & Essential Skills',
  'Digital Strategy (CDMS)',
  'Technical & IT Skills',
  'On-the-Job Training (OJT)',
  'Custom In-House Enterprise Package'
];

const sectors = [
  'Private Enterprise / Corporation',
  'Government / Statutory Body',
  'School / College / University',
  'Individual Professional'
];
---

<BaseLayout
  title="Contact Us — Corporate Training Consultation"
  description="Connect with GET Academy corporate training advisors for tailored training proposals, course outlines, and HRD Corp grant assistance."
>
  <!-- Header Banner -->
  <section class="bg-brand-dark text-white py-16 lg:py-20 border-b border-brand-sage/40">
    <div class="container-custom max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-brand-gold text-xs font-bold uppercase tracking-wider mb-4">
        <span>Get in Touch</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6">
        Contact GET Academy
      </h1>
      <p class="text-lg text-gray-200 leading-relaxed">
        Connect with our corporate training advisors for tailored training proposals, course outlines, trainer CVs, and HRD Corp SBL-Khas grant assistance.
      </p>
    </div>
  </section>

  <!-- Main Content Grid -->
  <section class="py-20 bg-brand-light">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Direct Consultation Channels & Decoupled Portal Card -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <SectionHeader
              eyebrow="Direct Enquiry Channels"
              title="We Are Ready to Assist Your Organisation"
              subtitle="Whether you represent an enterprise requiring customized team upskilling, a statutory body seeking institutional governance transformation, or an HR professional exploring HRD Corp levy claims, our training team is ready to consult with you."
            />
          </div>

          <!-- Official Channels Card with Awaiting Confirmation Disclaimers -->
          <div class="bg-white rounded-2xl p-7 border border-brand-border shadow-sm space-y-5">
            <h3 class="font-bold text-brand-dark text-base border-b border-brand-border pb-3">
              Official Corporate Desk
            </h3>

            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3.5">
                <MapPin class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-brand-dark block text-xs uppercase tracking-wider text-brand-muted">Registered Office Address</span>
                  <p class="text-brand-dark font-medium mt-0.5">Kuala Lumpur, Malaysia</p>
                  <span class="inline-block mt-1 text-[11px] bg-amber-50 text-amber-800 border border-amber-200 rounded px-2 py-0.5">
                    Specific street address awaiting client sign-off
                  </span>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <Mail class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-brand-dark block text-xs uppercase tracking-wider text-brand-muted">Enquiry Email</span>
                  <span class="inline-block mt-1 text-[11px] bg-amber-50 text-amber-800 border border-amber-200 rounded px-2 py-0.5">
                    Official inbox address awaiting client sign-off
                  </span>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <Phone class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-brand-dark block text-xs uppercase tracking-wider text-brand-muted">Office Telephone & WhatsApp</span>
                  <span class="inline-block mt-1 text-[11px] bg-amber-50 text-amber-800 border border-amber-200 rounded px-2 py-0.5">
                    Direct phone lines awaiting client sign-off
                  </span>
                </div>
              </div>
            </div>

            <!-- Response Commitment Badge -->
            <div class="p-4 bg-brand-light rounded-xl border border-brand-border flex items-center gap-3">
              <Clock class="w-5 h-5 text-brand-sage shrink-0" />
              <p class="text-xs text-brand-muted leading-relaxed">
                <strong>Response Commitment:</strong> Custom proposals, syllabus details, and HRDC grant documentation are provided within <strong>1–2 business days</strong> upon inquiry.
              </p>
            </div>
          </div>

          <!-- Training Consultation Assistance Box -->
          <div class="bg-brand-sage text-white rounded-2xl p-7 border border-brand-sage-dark shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-gold">Advisory Support</span>
              <ShieldCheck class="w-5 h-5 text-brand-gold" />
            </div>
            <h3 class="text-lg font-bold text-white">Dedicated Training Consultation</h3>
            <p class="text-xs text-gray-100 leading-relaxed">
              Our capability advisors work alongside corporate HR directors and training coordinators to structure tailored learning calendars, custom course syllabi, and itemized proposals.
            </p>
            <div class="pt-1 text-xs text-brand-gold font-semibold flex items-center gap-1.5">
              <span>• Custom syllabus preparation</span>
              <span>• Transparent proposal schedules</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Corporate Enquiry Form UI -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl p-8 sm:p-10 border border-brand-border shadow-sm">
            <div class="mb-6">
              <span class="text-xs font-extrabold uppercase tracking-widest text-brand-sage block mb-1">Corporate Enquiry</span>
              <h2 class="text-2xl font-extrabold text-brand-dark">Send a Training Enquiry</h2>
              <p class="text-sm text-brand-muted mt-1">
                Complete the form below and our corporate training consultants will respond to your requirements.
              </p>
            </div>

            <!-- Endpoint disclaimer banner -->
            <div class="mb-8 p-3.5 bg-blue-50 border border-blue-200 rounded-xl flex items-start gap-3">
              <AlertCircle class="w-4 h-4 text-blue-700 shrink-0 mt-0.5" />
              <p class="text-xs text-blue-800 leading-relaxed">
                <strong>Notice:</strong> This form UI is currently operating in presentation preview mode. No live CRM or mail delivery endpoint has been configured until approved credentials (e.g. Resend, SendGrid, or corporate webhook) are supplied. Submitting will show a local validation preview.
              </p>
            </div>

            <form id="corporate-enquiry-form" class="space-y-5">
              <!-- Full Name -->
              <div>
                <label for="contact-name" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Sarah Jenkins"
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                />
              </div>

              <!-- Corporate Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-email" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Corporate / Work Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="name@company.com.my"
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  />
                </div>
                <div>
                  <label for="contact-phone" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Contact Phone / WhatsApp <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="contact-phone"
                    name="phone"
                    required
                    placeholder="+60 12-345 6789"
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  />
                </div>
              </div>

              <!-- Organisation & Sector -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-org" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Organisation / Company <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-org"
                    name="organisation"
                    required
                    placeholder="e.g. Apex Logistics Sdn Bhd"
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  />
                </div>
                <div>
                  <label for="contact-sector" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                    Sector / Entity Type <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="contact-sector"
                    name="sector"
                    required
                    class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                  >
                    <option value="">Select your sector...</option>
                    {sectors.map((s) => (
                      <option value={s}>{s}</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Training Category of Interest -->
              <div>
                <label for="contact-track" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Training Category of Interest <span class="text-red-500">*</span>
                </label>
                <select
                  id="contact-track"
                  name="track"
                  required
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                >
                  <option value="">Select course track...</option>
                  {trainingTracks.map((t) => (
                    <option value={t}>{t}</option>
                  ))}
                </select>
              </div>

              <!-- Estimated Participants -->
              <div>
                <label for="contact-participants" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Estimated Participant Count
                </label>
                <select
                  id="contact-participants"
                  name="participants"
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                >
                  <option value="1-5">1 – 5 Participants</option>
                  <option value="6-15" selected>6 – 15 Participants (Standard Cohort)</option>
                  <option value="16-30">16 – 30 Participants (Full Department)</option>
                  <option value="31+">30+ Participants (Enterprise-Wide)</option>
                </select>
              </div>

              <!-- Requirements Message -->
              <div>
                <label for="contact-message" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">
                  Specific Requirements or Target Schedule
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  placeholder="Outline your departmental objectives, target training month, or questions regarding HRD Corp SBL-Khas claim procedures..."
                  class="w-full px-4 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-sage text-white font-bold rounded-xl hover:bg-brand-sage-dark transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-sage"
                >
                  <Send class="w-4 h-4" />
                  <span>Submit Training Enquiry</span>
                </button>
              </div>
            </form>

            <!-- Submission Confirmation Message Banner (Client-side JS simulated) -->
            <div id="form-success-banner" class="hidden mt-6 p-6 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-900 space-y-2">
              <div class="flex items-center gap-2 font-bold text-emerald-950">
                <CheckCircle2 class="w-5 h-5 text-emerald-700" />
                <span>Enquiry Recorded (Demonstration Mode)</span>
              </div>
              <p class="text-xs text-emerald-800 leading-relaxed">
                Thank you for your training interest. In this static preview environment, form data is validated locally. Once connected to GET Academy's live CRM/email endpoint, notifications will route directly to training coordinators.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Form submission preview handling
  const form = document.getElementById('corporate-enquiry-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success-banner');

  // Pre-fill course from URL query parameter (e.g. ?course=Critical%20Thinking)
  const urlParams = new URLSearchParams(window.location.search);
  const courseParam = urlParams.get('course');
  if (courseParam) {
    const messageBox = document.getElementById('contact-message') as HTMLTextAreaElement | null;
    if (messageBox) {
      messageBox.value = `Enquiring about the course: "${courseParam}". Please furnish official syllabus, fee schedule, and HRD Corp claim details.`;
    }
  }

  if (form && successBanner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Show preview success message
      successBanner.classList.remove('hidden');
      form.reset();
      successBanner.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>
