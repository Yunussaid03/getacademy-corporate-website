---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CourseCard from '@/components/ui/CourseCard.astro';
import coursesData from '@/data/courses.json';
import { 
  ArrowRight, 
  ShieldCheck, 
  Building2, 
  Award, 
  TrendingUp, 
  CheckCircle2, 
  Target, 
  Sparkles, 
  GraduationCap, 
  Cpu, 
  Globe2, 
  Briefcase, 
  Users2, 
  ExternalLink, 
  Clock, 
  Send,
  AlertCircle
} from 'lucide-astro';

// 4 Main Capability Pillars as documented in Company Profile Page 2-4
const capabilityPillars = [
  {
    number: '01',
    icon: Cpu,
    title: 'Artificial Intelligence Capacity Building',
    subtitle: 'Institutional AI Readiness & Workforce Adoption',
    description: 'Empowering enterprise workforces, educators, and public institutions with applied AI competencies, executive transformation pathways, and responsible AI governance frameworks.',
    href: '/corporate-solutions',
    highlights: ['Institutional AI transformation', 'Chief Digital Officer (CDO) briefings', 'Educator & workforce adoption']
  },
  {
    number: '02',
    icon: ShieldCheck,
    title: 'Global IT Certification',
    subtitle: 'Industry-Standard Credentials',
    description: 'Structured curricula aligned to international standards, including CompTIA technical tracks (Security+, Network+, Cloud+, CySA+, CASP+) and cybersecurity readiness for non-IT personnel.',
    href: '/courses',
    highlights: ['CompTIA Authorized Partner curriculum', 'Cybersecurity resilience tracks', 'Cloud infrastructure fundamentals']
  },
  {
    number: '03',
    icon: Award,
    title: 'Professional Development',
    subtitle: 'Managerial & Workplace Capability',
    description: 'Outcome-driven leadership and operational modules focusing on root-cause problem solving, customer experience management (CEM), design thinking, team synergy, and supervisory excellence.',
    href: '/courses?category=workplace-performance',
    highlights: ['Executive leadership & governance', 'Design thinking & problem-solving', 'Customer experience & sales management']
  },
  {
    number: '04',
    icon: Globe2,
    title: 'Entrepreneurship & Cross-Border Business',
    subtitle: 'Incubation & Market Acceleration',
    description: 'Supporting high-potential enterprises, SMEs, and startups with strategic business incubation, market research, digital marketing strategies (CDMS), and cross-border commercial pathways.',
    href: '/corporate-solutions',
    highlights: ['SEGi certified digital marketing (CDMS)', 'SME & startup business incubation', 'Cross-border trade & market entry']
  }
];

// Documented Institutional Experience & Engagements from Company Profile Pages 14-24, 26-30
const documentedEngagements = [
  {
    entity: 'Ministry of Higher Education (MOHE)',
    role: 'Public University AI Readiness',
    scope: 'Invited by Deputy Secretary-General to present strategic AI transformation and adoption pathways to 30+ Chief Digital Officers (CDOs) across Malaysia’s public universities.',
    category: 'Government & Higher Education'
  },
  {
    entity: 'Ministry of Education (MOE)',
    role: 'Organizational & Leadership Transformation',
    scope: 'Awarded project to conduct organizational Gap Analysis, formulate targeted capability improvement roadmaps, and champion executive leadership transformation.',
    category: 'Federal Ministry'
  },
  {
    entity: 'National AI Skilling Ecosystem (AINSI)',
    role: 'Ecosystem-Wide Workforce Impact',
    scope: 'Participated in national skilling efforts advancing AI adoption across government ministries, education bodies, and communities, contributing to ecosystem initiatives reaching 800,000+ Malaysians.',
    category: 'National Initiative'
  },
  {
    entity: 'Malaysia Healthcare Travel Council (MHTC)',
    role: 'Sectoral Digital Capability',
    scope: 'Conducted specialized corporate training for the MHTC team on navigating digital marketing strategies and patient engagement in the healthcare travel industry.',
    category: 'Statutory Body'
  },
  {
    entity: 'Unit Transformasi Masyarakat India (SEDIC - MITRA)',
    role: 'Socio-Economic Development (B40 / M40)',
    scope: 'Designed and executed end-to-end entrepreneurship development and business strategy digitalization coaching programs for 50 participating business owners.',
    category: 'Socio-Economic Initiative'
  },
  {
    entity: 'Higher Education & Educator Partnerships',
    role: 'Academic & Institutional Capacity',
    scope: 'Collaborated with JPN Pulau Pinang, Institut Pendidikan Guru (IPG), and Tech Dome Penang for educator AI training, alongside first-time employment programs with universities.',
    category: 'Academic Institutions'
  }
];

// Accreditations & Institutional Relationships Classified by Relationship Type (Pages 1, 8, 9, 11, 26, 28)
const relationshipGroups = [
  {
    type: 'Authorised Training Partnership',
    description: 'Certified curriculum and global certification delivery',
    items: [
      { name: 'CompTIA Authorized Partner', logo: '/assets/partners/CompTIA.png', note: 'Endorsed Computing Technology Industry Association Partner' }
    ]
  },
  {
    type: 'Academic & University Partnership',
    description: 'Joint credentialing and strategic education frameworks',
    items: [
      { name: 'SEGi University & Colleges', logo: '/assets/partners/SEGI.png', note: 'Strategic Educational Partner & Franchisee for certified modules' }
    ]
  },
  {
    type: 'Government & Digital Agency Appointments',
    description: 'Official capacity building and digital solution appointments',
    items: [
      { name: 'Malaysia Digital Economy Corporation (MDEC)', logo: '/assets/brand/getacademy-banner.png', note: 'Appointed Digital Training Partner (Digital Up & Let’s Learn Digital)' },
      { name: 'Malaysia Productivity Corporation (MPC)', logo: '/assets/partners/mosti.png', note: 'Appointed Digital Solution Provider & Digitalization Committee Member' }
    ]
  },
  {
    type: 'Statutory Membership & Trade Engagements',
    description: 'Institutional memberships and bilateral trade facilitation',
    items: [
      { name: 'MATRADE Member', logo: '/assets/partners/Kuala-Lumpur.png', note: 'Official member & contributor to international trade sourcing programmes' },
      { name: 'HRD Corp Registered Provider', logo: '/assets/partners/HRDF.png', note: 'Registered training provider (LLP0019343-LGN; certificate renewal verification note applies)' }
    ]
  }
];

// Documented Enterprise & Institutional Client Logos (PDF Page 25, 31)
const clientLogos = [
  { name: 'Ministry of Education', file: 'Ministry-of-Education.png' },
  { name: 'MOSTI', file: 'mosti.png' },
  { name: 'Dewan Bandaraya Kuala Lumpur', file: 'Kuala-Lumpur.png' },
  { name: 'SEGi University', file: 'SEGI.png' },
  { name: 'Kings College', file: 'Kings-College.png' },
  { name: 'Malaysia Airlines', file: 'malaysia-airlines.png' },
  { name: 'Shopee', file: 'shopee.png' },
  { name: 'Lazada', file: 'lazada.png' },
  { name: 'HP', file: 'hp.png' },
  { name: 'IBM', file: 'IBM.png' },
  { name: 'Digi', file: 'digi.png' },
  { name: 'Atos', file: 'ATOS.png' }
];

// Documented Differentiators (PDF Page 6)
const differentiators = [
  {
    title: 'Practitioner-Led Expertise',
    desc: 'Our facilitators possess extensive real-world sector backgrounds, translating theoretical models into actionable workplace tools with deep domain understanding.'
  },
  {
    title: 'Flexible On-Site & Virtual Delivery',
    desc: 'Training sessions conducted on-site at client premises or virtually in high-engagement formats, accommodating organizational shift patterns and timelines.'
  },
  {
    title: 'Practical, Applied Learning',
    desc: 'Hands-on workshop dynamics, live discussions, simulation exercises, and actionable rubrics designed for immediate workplace implementation.'
  },
  {
    title: 'Global Certification Alignment',
    desc: 'Curricula structured in accordance with globally recognized certification frameworks (CompTIA, SEGi) validating specialized workforce competencies.'
  },
  {
    title: 'Measurable Capability & Business Outcomes',
    desc: 'Focusing on verified skill transfer, enhanced operational efficiency, employee satisfaction, and quantifiable capability improvement.'
  }
];

// Curated verified course sample
const featuredCourses = coursesData.slice(0, 6);
---

<BaseLayout 
  title="Global Experiential Training Academy PLT — Human Capital Development Partner"
  description="GET Academy is an established human capital development and skills training partner for enterprises, government agencies, and educational institutions across Malaysia."
>
  <!-- Section 1 — Hero: Who We Are (Visual-First Modern Corporate Design) -->
  <section class="relative bg-gradient-to-b from-[#244336] via-[#2D5444] to-[#244336] text-white overflow-hidden py-14 sm:py-20 lg:py-24 border-b border-brand-sage/30">
    <!-- Subtle Background Texture -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FADB50_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-sage/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy: Clean, Direct, and Uncluttered -->
        <div class="lg:col-span-6 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-brand-gold/30 text-brand-gold text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
            <span>Human Capital Development Partner</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-tight text-white">
            Your Unbeatable <span class="text-brand-gold">Human Capital</span> Development Partner
          </h1>

          <p class="text-base sm:text-lg text-gray-200 leading-relaxed max-w-xl">
            We partner with enterprises, government agencies, and educational institutions across Malaysia to build practical capabilities in artificial intelligence, technology, leadership, and operational excellence.
          </p>

          <!-- Two Clear Actions -->
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href="#corporate-enquiry"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-brand-dark bg-brand-gold hover:bg-brand-gold-deep shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
            >
              <span>Discuss Your Training Needs</span>
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="#what-we-do"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-white bg-transparent border-2 border-white/70 hover:bg-white/10 hover:border-white transition-all"
            >
              Explore Our Capabilities
            </a>
          </div>
        </div>

        <!-- Hero Visual: Prominent Authentic Photograph from Company Profile PDF -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 group">
            <img 
              src="/assets/photos/live-workshop-facilitator.jpeg" 
              alt="GET Academy corporate workshop facilitator conducting an interactive training session" 
              class="w-full h-80 sm:h-[420px] lg:h-[460px] object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>
            
            <div class="absolute bottom-4 left-4 right-4 bg-brand-dark/85 backdrop-blur-md p-4 rounded-xl border border-white/15 text-white flex items-center justify-between gap-4">
              <div class="space-y-0.5">
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-gold block">
                  Interactive Adult Learning
                </span>
                <p class="text-xs text-gray-200 font-medium">
                  Practitioner-led workshop delivery for corporate and institutional cohorts
                </p>
              </div>
              <span class="shrink-0 px-2.5 py-1 rounded bg-brand-sage text-[10px] font-bold text-white uppercase tracking-wider">
                GET Academy
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 — What We Do: 4 Capability Pillars -->
  <section class="py-20 bg-white" id="what-we-do">
    <div class="container-custom">
      <SectionHeader 
        eyebrow="Core Competency Pillars"
        title="What We Do"
        subtitle="Specialized training expertise structured across four primary capability domains to support workforce modernization and enterprise competitiveness."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {capabilityPillars.map((pillar) => (
          <div class="bg-brand-light rounded-xl p-6 border border-brand-border hover:border-brand-sage/60 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono font-extrabold text-brand-sage px-2 py-0.5 rounded bg-white border border-brand-border">{pillar.number}</span>
                <div class="w-10 h-10 rounded-lg bg-white border border-brand-border flex items-center justify-center text-brand-sage group-hover:bg-brand-sage group-hover:text-white transition-colors shadow-sm">
                  <pillar.icon class="w-5 h-5" />
                </div>
              </div>
              <h3 class="text-lg font-bold text-brand-dark mb-1.5 group-hover:text-brand-sage transition-colors">
                {pillar.title}
              </h3>
              <p class="text-xs font-bold text-brand-sage uppercase tracking-wider mb-3">
                {pillar.subtitle}
              </p>
              <p class="text-xs text-brand-muted leading-relaxed mb-5">
                {pillar.description}
              </p>
              <div class="space-y-1.5 border-t border-brand-border/60 pt-3 mb-5">
                {pillar.highlights.map((h) => (
                  <div class="flex items-center gap-1.5 text-[11px] text-brand-dark font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-gold shrink-0"></span>
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </div>
            <a
              href={pillar.href}
              class="inline-flex items-center text-xs font-bold text-brand-sage group-hover:text-brand-sage-dark hover:underline pt-2 border-t border-brand-border/60"
            >
              <span>Explore Capability Track &rarr;</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3 — Institutional Experience and Impact -->
  <section class="py-20 bg-brand-light border-y border-brand-border" id="institutional-experience">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-12">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage">Demonstrated Track Record</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Institutional Experience & Public Sector Impact</h2>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
            GET Academy is entrusted by federal ministries, higher education councils, and statutory agencies to design and champion strategic capability roadmaps, leadership transformation, and technological readiness.
          </p>
        </div>
        <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-brand-border shadow-sm">
          <span class="text-xs font-extrabold uppercase text-brand-sage block mb-1">Ecosystem-Wide Reach Context</span>
          <p class="text-xs text-brand-muted leading-relaxed">
            * Through national collaborative ecosystems (including Microsoft Malaysia’s AI National Skilling Initiative - AINSI), our leadership contributed to multi-stakeholder programs reaching <strong>800,000+ Malaysians</strong> across ministries, universities, and industry bodies.
          </p>
        </div>
      </div>

      <!-- Experience Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {documentedEngagements.map((eng) => (
          <div class="bg-white p-6 rounded-xl border border-brand-border shadow-sm hover:border-brand-sage/60 transition-all flex flex-col justify-between">
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-brand-sage-light text-brand-sage mb-3">
                {eng.category}
              </span>
              <h3 class="text-base font-bold text-brand-dark mb-1 leading-snug">
                {eng.entity}
              </h3>
              <p class="text-xs font-semibold text-brand-sage mb-3">
                {eng.role}
              </p>
              <p class="text-xs text-brand-muted leading-relaxed">
                {eng.scope}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center gap-1.5 text-[11px] font-semibold text-emerald-800">
              <CheckCircle2 class="w-3.5 h-3.5" />
              <span>Documented Engagement</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4 — Accreditations and Institutional Relationships -->
  <section class="py-20 bg-white" id="accreditations">
    <div class="container-custom">
      <SectionHeader 
        eyebrow="Institutional Relationships"
        title="Accreditations & Organizational Affiliations"
        subtitle="Transparently categorized by formal partnership status, authorized training agreements, and statutory memberships."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto mb-10">
        {relationshipGroups.map((group) => (
          <div class="bg-brand-light p-6 rounded-xl border border-brand-border flex flex-col justify-between">
            <div>
              <span class="text-xs font-extrabold uppercase tracking-wider text-brand-sage block mb-1">
                {group.type}
              </span>
              <p class="text-xs text-brand-muted mb-4">{group.description}</p>
              <div class="space-y-3">
                {group.items.map((item) => (
                  <div class="p-3 bg-white rounded-lg border border-brand-border flex items-center gap-4">
                    <img 
                      src={item.logo} 
                      alt={item.name} 
                      class="max-h-8 max-w-[90px] object-contain shrink-0" 
                      loading="lazy"
                    />
                    <div>
                      <h4 class="text-xs font-bold text-brand-dark">{item.name}</h4>
                      <p class="text-[11px] text-brand-muted">{item.note}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Verification Status Notice regarding HRD Corp Certificate -->
      <div class="max-w-4xl mx-auto bg-amber-50/80 border border-amber-200 rounded-xl p-4 sm:p-5 flex items-start gap-3 text-xs text-amber-900">
        <ShieldCheck class="w-5 h-5 text-amber-800 shrink-0 mt-0.5" />
        <div class="space-y-1">
          <p class="font-bold uppercase tracking-wide">Accreditation Verification Transparency:</p>
          <p class="leading-relaxed">
            The HRD Corp Training Provider Certificate in the profile documents registration validity through 2 September 2025. Current active renewal certificates and individual trainer HRD Corp TTT credentials are confirmed and furnished directly to corporate procurement teams upon formal inquiry.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5 — Why GET Academy: Documented Differentiators -->
  <section class="py-20 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-brand-border relative">
            <img 
              src="/assets/photos/about-team.jpg" 
              alt="GET Academy corporate capability session" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-5 inset-x-5 text-white">
              <span class="text-xs font-bold text-brand-gold uppercase tracking-wider block mb-1">Corporate Delivery Standard</span>
              <p class="text-xs text-gray-200">
                Combining interactive workshops, hands-on diagnostics, and post-session milestone tracking.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <SectionHeader 
            eyebrow="The GET Academy Advantage"
            title="Why Enterprises & Government Institutions Choose Us"
            subtitle="Engineered for measurable talent transformation through actionable tools and practitioner-led instruction."
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {differentiators.map((diff, idx) => (
              <div class="p-4 bg-white rounded-xl border border-brand-border hover:border-brand-sage/60 transition-all">
                <span class="text-brand-sage font-extrabold font-mono text-sm block mb-1">0{idx + 1}</span>
                <h4 class="font-bold text-brand-dark text-sm mb-1">{diff.title}</h4>
                <p class="text-xs text-brand-muted leading-relaxed">{diff.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Showcase -->
  <section class="py-14 bg-white border-b border-brand-border">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-xs font-extrabold uppercase tracking-widest text-brand-sage block mb-1">Ecosystem & Client Reach</span>
        <h3 class="text-xl font-extrabold text-brand-dark">Trusted Across Corporate & Public Sectors</h3>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5 items-center">
        {clientLogos.map((client) => (
          <div class="p-3 bg-brand-light rounded-xl border border-brand-border flex items-center justify-center h-16 hover:bg-white hover:shadow-sm transition-all">
            <img 
              src={`/assets/partners/${client.file}`} 
              alt={client.name} 
              class="max-h-9 max-w-[100px] object-contain grayscale hover:grayscale-0 opacity-80 hover:opacity-100 transition-all"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 6 — Training Programmes (Curated Portfolio) -->
  <section class="py-20 bg-brand-light border-b border-brand-border" id="programmes">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Curriculum Offerings</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Structured Corporate Training Programmes</h2>
          <p class="text-sm sm:text-base text-brand-muted mt-2 max-w-xl">
            Choose from comprehensive programs spanning artificial intelligence, IT infrastructure, digital marketing strategy (CDMS), and organizational leadership.
          </p>
        </div>
        <div>
          <a
            href="/courses"
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm"
          >
            <span>Browse Full Catalogue</span>
            <ArrowRight class="w-4 h-4 ml-1.5" />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {featuredCourses.map((course) => (
          <CourseCard {...course} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 7 — Corporate and Government Enquiries -->
  <section class="py-20 bg-brand-dark text-white" id="corporate-enquiry">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Left: Official Contact Desk -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-extrabold uppercase tracking-widest text-brand-gold block">B2B & Institutional Engagement</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Discuss Your Training Needs</h2>
          <p class="text-gray-200 text-sm leading-relaxed">
            We partner with corporate HR directors, government training coordinators, and higher education leaders to formulate tailored capability frameworks and proposal schedules.
          </p>

          <div class="p-6 bg-white/5 rounded-2xl border border-white/10 space-y-4 text-xs text-gray-300">
            <h4 class="text-brand-gold font-bold uppercase tracking-wider">Official Corporate Desk (Profile Reference)</h4>
            <div class="space-y-3">
              <div>
                <span class="block font-bold text-white uppercase text-[11px]">Corporate Entity</span>
                <span class="text-gray-200">Global Experiential Training Academy PLT (LLP0019343-LGN)</span>
              </div>
              <div>
                <span class="block font-bold text-white uppercase text-[11px]">Registered Corporate Office</span>
                <span class="text-gray-200">Level 33, Ilham Tower, No. 8, Jalan Binjai, 50450 Kuala Lumpur</span>
              </div>
              <div>
                <span class="block font-bold text-white uppercase text-[11px]">Enquiry Email</span>
                <span class="text-gray-200">ask@geta.com.my</span>
              </div>
              <div>
                <span class="block font-bold text-white uppercase text-[11px]">Coordinator Contact (PIC)</span>
                <span class="text-gray-200">+60 16-328 8684 (Ganesh Kumar Manokara, COO)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Inquiry Form with Clear Notice -->
        <div class="lg:col-span-7 bg-white text-brand-dark p-8 sm:p-10 rounded-2xl border border-brand-border shadow-xl">
          <div class="mb-6">
            <h3 class="text-xl font-extrabold text-brand-dark">Request an Enterprise or Institutional Proposal</h3>
            <p class="text-xs text-brand-muted mt-1">
              Submit your departmental requirements below and our advisory team will respond within 1–2 business days.
            </p>
          </div>

          <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg text-xs text-blue-900 mb-6 flex items-start gap-2">
            <AlertCircle class="w-4 h-4 text-blue-700 shrink-0 mt-0.5" />
            <p class="leading-relaxed">
              <strong>Form Status Notice:</strong> Operating in demonstration/preview mode. Submission endpoints will be activated upon client mail API configuration.
            </p>
          </div>

          <form id="hero-enquiry-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="org-name" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Full Name *</label>
                <input type="text" id="org-name" required placeholder="e.g. Ts. Ahmad Faizal" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
              <div>
                <label for="org-email" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Official Work Email *</label>
                <input type="email" id="org-email" required placeholder="name@agency.gov.my" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="org-entity" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Organization / Entity *</label>
                <input type="text" id="org-entity" required placeholder="Ministry / Corporation Name" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
              <div>
                <label for="org-sector" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Sector Type *</label>
                <select id="org-sector" required class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage">
                  <option value="government">Government Body / Statutory Agency</option>
                  <option value="enterprise">Corporate Enterprise / MNC</option>
                  <option value="education">University / Higher Learning Institution</option>
                  <option value="sme">SME / Private Company</option>
                </select>
              </div>
            </div>

            <div>
              <label for="org-pillar" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Primary Capability Track *</label>
              <select id="org-pillar" required class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage">
                <option value="ai">Artificial Intelligence Capacity Building</option>
                <option value="it">Global IT Certification (CompTIA, Cyber Security)</option>
                <option value="leadership">Professional Development & Leadership Transformation</option>
                <option value="entrepreneurship">Entrepreneurship & Cross-Border Business</option>
                <option value="custom">Custom In-House Capability Outline</option>
              </select>
            </div>

            <div>
              <label for="org-notes" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Brief Objectives or Target Schedule</label>
              <textarea id="org-notes" rows="3" placeholder="Outline your team upskilling objectives, target month, or specific cohort requirements..." class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage"></textarea>
            </div>

            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 bg-brand-sage text-white font-bold rounded-lg hover:bg-brand-sage-dark transition-all text-xs shadow-sm">
              <Send class="w-3.5 h-3.5" />
              <span>Submit Training Consultation Request</span>
            </button>
          </form>

          <div id="hero-form-feedback" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-lg text-xs text-emerald-900">
            <p class="font-bold">Consultation Request Recorded (Demonstration Mode)</p>
            <p class="mt-0.5">Thank you. In production, this inquiry will route directly to GET Academy's training coordination desk at ask@geta.com.my.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const heroForm = document.getElementById('hero-enquiry-form') as HTMLFormElement | null;
  const heroFeedback = document.getElementById('hero-form-feedback');

  if (heroForm && heroFeedback) {
    heroForm.addEventListener('submit', (e) => {
      e.preventDefault();
      heroFeedback.classList.remove('hidden');
      heroForm.reset();
    });
  }
</script>
