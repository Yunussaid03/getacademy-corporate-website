} as const;

// Hand-picked programmes across the four pathways
const featuredCourses = coursesData.filter((course) => course.featured);
---

<BaseLayout
  title="Digital Transformation Centre — Consulting, Implementation & Training"
  description="Korporatly Group is a Digital Transformation Centre & Agency delivering enterprise consulting, technology implementation, and workforce capability development across Malaysia."
>
  <!-- Section 1 — Hero: Korporatly Group Digital Transformation Positioning -->
  <section id="hero" class="relative bg-gradient-to-b from-[#244336] via-[#2D5444] to-[#244336] text-white overflow-hidden py-14 sm:py-20 lg:py-24 border-b border-brand-sage/30">
    <!-- Subtle Background Texture -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FADB50_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-sage/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy: Clean, Direct, and Uncluttered -->
        <div class="lg:col-span-6 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-brand-gold/30 text-brand-gold text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
            <span>Digital Transformation Centre & Agency</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-tight text-white">
            Accelerating Enterprise <span class="text-brand-gold">Digital Transformation</span>
          </h1>

          <p class="text-base sm:text-lg text-gray-200 leading-relaxed max-w-xl">
            Korporatly Group partners with enterprises, government bodies, and institutions across Malaysia to drive modern digital modernization through strategic Consulting, technology Implementation, and specialized workforce Training.
          </p>

          <!-- Two Clear Actions -->
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href="#corporate-enquiry"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-brand-dark bg-brand-gold hover:bg-brand-gold-deep shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
            >
              <span>Consult Our Advisory Team</span>
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="#services"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-white bg-transparent border-2 border-white/70 hover:bg-white/10 hover:border-white transition-all"
            >
              Explore Services & Ventures
            </a>
          </div>
        </div>

        <!-- Hero Visual: Authentic Strategic Advisory Photograph -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 group">
            <img
              src="/assets/photos/live-workshop-facilitator-enhanced.jpg"
              alt="Korporatly Group advisory facilitator conducting an executive capability session"
              class="w-full h-80 sm:h-[420px] lg:h-[460px] object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
              width="1539"
              height="1737"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>

            <div class="absolute bottom-4 left-4 right-4 bg-brand-dark/85 backdrop-blur-md p-4 rounded-xl border border-white/15 text-white flex items-center justify-between gap-4">
              <div class="space-y-0.5">
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-gold block">
                  Strategic Advisory & Implementation
                </span>
                <p class="text-xs text-gray-200 font-medium">
                  Guiding organizations through technology adoption and capability building
                </p>
              </div>
              <span class="shrink-0 px-2.5 py-1 rounded bg-brand-sage text-[10px] font-bold text-white uppercase tracking-wider">
                Korporatly Group
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 — Core Service Pillars: Consulting, Implementation, Training -->
  <section class="py-20 lg:py-24 bg-white" id="services">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Core Service Pillars"
        title="Consulting, Implementation & Training"
        subtitle="A tripartite capability framework designed to bridge executive strategy, technology integration, and human workforce readiness."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {servicePillars.map((pillar) => (
          <div class="bg-brand-light rounded-2xl border border-brand-border hover:border-brand-sage/60 hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden group">
            <!-- Visual Asset: Authentic Photography -->
            <div class="relative h-48 w-full bg-slate-100 overflow-hidden border-b border-brand-border">
              <img
                src={pillar.image}
                alt={pillar.imageAlt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />

              <!-- Badge Overlay -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="bg-brand-dark/90 backdrop-blur-sm text-brand-gold text-xs font-mono font-extrabold px-2.5 py-1 rounded shadow-sm">
                  {pillar.number}
                </span>
                <span class="bg-white/95 backdrop-blur-sm text-brand-dark text-[10px] font-bold px-2 py-1 rounded shadow-sm">
                  {pillar.badge}
                </span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 sm:p-7 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2 text-brand-sage">
                  <pillar.icon class="w-4 h-4 shrink-0" />
                  <span class="text-[11px] font-bold uppercase tracking-wider text-brand-sage">
                    {pillar.subtitle}
                  </span>
                </div>

                <h3 class="text-xl font-extrabold text-brand-dark group-hover:text-brand-sage transition-colors leading-snug mb-3">
                  {pillar.title}
                </h3>

                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-5">
                  {pillar.description}
                </p>

                <!-- Core Capabilities List -->
                <div class="space-y-2 mb-6 pt-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-brand-muted block">Capabilities</span>
                  {pillar.features.map((feature) => (
                    <div class="flex items-center gap-2 text-xs text-brand-dark font-medium">
                      <CheckCircle2 class="w-3.5 h-3.5 text-brand-sage shrink-0" />
                      <span>{feature}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Action Link -->
              <div class="pt-4 border-t border-brand-border/70">
                <a
                  href={pillar.href}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage group-hover:text-brand-sage-dark group-hover:translate-x-0.5 transition-all"
                >
                  <span>{pillar.ctaText}</span>
                  <ArrowRight class="w-3.5 h-3.5 text-brand-sage" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3 — Projects & Innovation Ecosystem Showcase (Cinematic Art-Directed Theme) -->
  <section class="relative py-24 lg:py-32 bg-[#12201a] text-white border-y border-white/10 overflow-hidden" id="ventures">
    <!-- Subtle Ambient Backdrop -->
    <div class="absolute inset-0 pointer-events-none opacity-25">
      <div class="absolute top-0 left-1/4 w-[36rem] h-[36rem] rounded-full bg-teal-500/10 blur-[120px]"></div>
      <div class="absolute bottom-0 right-1/4 w-[36rem] h-[36rem] rounded-full bg-amber-500/10 blur-[120px]"></div>
    </div>

    <div class="container-custom relative z-10">
      <!-- Section Header: Clear, Confident, Editorial Hierarchy -->
      <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">
          Specialized Ventures
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
          Architecting &amp; Operating High-Impact Products
        </h2>
        <p class="text-base sm:text-lg text-slate-300 mt-4 leading-relaxed font-normal">
          Beyond enterprise advisory, Korporatly Group builds and scales specialized digital products across frontline domains, from longevity diagnostics to adaptive learning intelligence.
        </p>
      </div>

      <!-- Flagship Cinematic Showcase (Dual Project Columns) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 mb-16" id="project-showcase-container">
        {ecosystemProjects.map((project) => (
          <article
            class="project-showcase-card group rounded-3xl bg-slate-900/60 border border-white/10 p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:border-white/20 hover:bg-slate-900/80"
            id={`showcase-${project.id}`}
            data-project-id={project.id}
          >
            <div>
              <!-- 1. Project Identity (Editorial Header) -->
              <div class="flex items-start justify-between gap-4 mb-6">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class={`inline-block w-2 h-2 rounded-full ${project.theme.dotColor}`}></span>
                    <span class="text-xs font-semibold tracking-wide uppercase text-slate-400">
                      {project.sector}
                    </span>
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                    {project.name}
                  </h3>
                </div>

                <span class="font-mono text-xs text-slate-400 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg shrink-0 hidden sm:inline-block">
                  {project.url.replace('https://', '')}
                </span>
              </div>

              <!-- 2. Cinematic Video Walkthrough Window -->
              <div class="relative aspect-video w-full rounded-2xl overflow-hidden bg-slate-950 border border-white/10 shadow-2xl mb-6 group/video">
                <video
                  class="project-video-player w-full h-full object-cover object-top"
                  poster={project.previewImage}
                  muted
                  playsinline
                  loop
                  preload="metadata"
                  data-project-video={project.id}
                  aria-label={`${project.name} live product walkthrough recording`}
                >
                  <source src={project.videoWalkthrough} type="video/mp4" />
                  <source src={project.videoWebm} type="video/webm" />
                  Your browser does not support HTML5 video walkthroughs.
                </video>

                <!-- Subtle Video Gradient Scrim -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>

                <!-- Floating Center Play/Pause Control -->
                <button
                  type="button"
                  class="video-play-center-btn absolute inset-0 m-auto w-14 h-14 rounded-full bg-slate-950/80 backdrop-blur-md text-white border border-white/20 flex items-center justify-center shadow-xl transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white/40"
                  aria-label={`Play or pause walkthrough video for ${project.name}`}
                  data-control-target={project.id}
                >
                  <Play class="play-icon w-5 h-5 text-white ml-0.5 fill-white" />
                  <Pause class="pause-icon w-5 h-5 text-white hidden fill-white" />
                </button>

                <!-- Minimal Restrained Player Bottom Bar (Reveals on Hover/Focus) -->
                <div class="video-control-bar absolute bottom-3 inset-x-3 px-3 py-2 rounded-xl bg-slate-950/80 backdrop-blur-md border border-white/10 flex items-center justify-between text-white text-xs opacity-90 transition-opacity duration-200">
                  <div class="flex items-center gap-3">
                    <button
                      type="button"
                      class="video-play-toggle hover:text-white/80 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-white"
                      aria-label="Toggle video playback"
                      data-control-target={project.id}
                    >
                      <Play class="play-icon-sm w-3.5 h-3.5 fill-current" />
                      <Pause class="pause-icon-sm w-3.5 h-3.5 hidden fill-current" />
                    </button>
                    <button
                      type="button"
                      class="video-restart-btn hover:text-white/80 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-white"
                      aria-label="Restart video"
                      data-restart-target={project.id}
                    >
                      <RotateCcw class="w-3.5 h-3.5" />
                    </button>
                    <span class="video-time-display font-mono text-[11px] text-slate-300">00:00</span>
                  </div>

                  <div class="flex items-center gap-3">
                    <span class="text-[10px] font-semibold tracking-wider uppercase text-slate-400 hidden sm:inline-block">Live Product Capture</span>
                    <button
                      type="button"
                      class="video-fullscreen-btn hover:text-white/80 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-white"
                      aria-label="Fullscreen video"
                      data-fullscreen-target={project.id}
                    >
                      <Maximize2 class="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>

              <!-- 3. Concise Editorial Description -->
              <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal mb-8">
                {project.tagline}
              </p>
            </div>

            <!-- 4. Clear Actions: Launch Mini-Browser & Direct Link -->
            <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
              <button
                type="button"
                class="venture-open-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs bg-white/10 hover:bg-white/20 text-white border border-white/15 transition-all shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 cursor-pointer"
                data-open-venture={project.id}
                aria-haspopup="dialog"
                aria-controls="venture-mini-browser-modal"
              >
                <Compass class="w-4 h-4 text-emerald-400" />
                <span>Explore Mini-Browser</span>
