  <!-- Interactive Client-side Script for Carousel & Category Filter -->
  <script is:inline>
    (function() {
      const track = document.getElementById('partner-carousel-track');
      const prevBtn = document.getElementById('partner-carousel-prev');
      const nextBtn = document.getElementById('partner-carousel-next');
      const tabBtns = document.querySelectorAll('.category-tab-btn');
      const cards = document.querySelectorAll('.carousel-card');

      if (!track || !prevBtn || !nextBtn) return;

      // Scroll helpers
      function getScrollDistance() {
        const firstCard = track.querySelector('.carousel-card:not(.hidden)');
        return firstCard ? firstCard.offsetWidth + 24 : 360;
      }

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
      });

      // Keyboard navigation support on track
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          track.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          track.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
        }
      });

      // Category tab filtering
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const category = btn.dataset.category;

          // Update active state
          tabBtns.forEach(b => {
            b.classList.remove('active', 'bg-brand-sage', 'text-white', 'border-brand-sage');
            b.classList.add('bg-brand-light', 'text-brand-dark', 'border-brand-border');
            b.setAttribute('aria-selected', 'false');
          });

          btn.classList.add('active', 'bg-brand-sage', 'text-white', 'border-brand-sage');
          btn.classList.remove('bg-brand-light', 'text-brand-dark', 'border-brand-border');
          btn.setAttribute('aria-selected', 'true');

          // Filter cards
          cards.forEach(card => {
            if (category === 'all' || card.dataset.category === category) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });

          // Reset scroll position to beginning smoothly
          track.scrollTo({ left: 0, behavior: 'smooth' });
        });
      });
    })();
  </script>

