---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CourseCard from '@/components/ui/CourseCard.astro';
import coursesData from '@/data/courses.json';
import { 
  ArrowRight, 
  ShieldCheck, 
  Building2, 
  Award, 
  TrendingUp, 
  CheckCircle2, 
  Target, 
  Sparkles, 
  GraduationCap, 
  Cpu, 
  Globe2, 
  Briefcase, 
  Users2, 
  ExternalLink, 
  Clock, 
  Send,
  AlertCircle
} from 'lucide-astro';

// 4 Main Capability Pillars as documented in Company Profile Page 2-4
const capabilityPillars = [
  {
    number: '01',
    icon: Cpu,
    title: 'Artificial Intelligence Capacity Building',
    subtitle: 'Institutional & Workforce AI Adoption',
    description: 'Institutional AI readiness, leadership advisory, and practical AI adoption for educators, public sector leaders, and corporate workforces.',
    image: '/assets/photos/ai-educator-training.jpeg',
    imageAlt: 'GET Academy educators and institutional leaders in an applied AI training session',
    href: '/corporate-solutions',
    badge: 'Institutional & Workforce AI'
  },
  {
    number: '02',
    icon: ShieldCheck,
    title: 'Global IT Certification',
    subtitle: 'Industry-Aligned Credentials',
    description: 'Industry-aligned IT and cybersecurity training, including CompTIA certification pathways and foundational digital resilience for non-IT personnel.',
    image: '/assets/brand/comptia-cert-strip.png',
    isBrandGraphic: true,
    imageAlt: 'CompTIA authorized international certification pathways',
    href: '/courses',
    badge: 'CompTIA Pathways'
  },
  {
    number: '03',
    icon: Award,
    title: 'Professional Development',
    subtitle: 'Managerial & Operational Excellence',
    description: 'Applied leadership development, customer experience management, design thinking, root-cause problem solving, and cross-functional team performance.',
    image: '/assets/photos/welcome-classroom-session.jpeg',
    imageAlt: 'Interactive classroom workshop session on managerial capabilities',
    href: '/courses?category=workplace-performance',
    badge: 'Leadership & Team Performance'
  },
  {
    number: '04',
    icon: Globe2,
    title: 'Entrepreneurship & Cross-Border Business',
    subtitle: 'Incubation & Market Expansion',
    description: 'Certified digital marketing strategies (CDMS), enterprise incubation, and market expansion pathways connecting local businesses with global ecosystems.',
    image: '/assets/photos/mitra-entrepreneurship-coaching.jpeg',
    imageAlt: 'GET Academy entrepreneurship coaching and business digitalization session',
    href: '/corporate-solutions',
    badge: 'Digital Strategy & Incubation'
  }
];

// Documented Institutional Experience & Engagements from Company Profile Pages 14-24, 26-30
const documentedEngagements = [
  {
    entity: 'Ministry of Higher Education (MOHE)',
    role: 'Public University AI Readiness',
    scope: 'Invited by the Deputy Secretary-General to present strategic AI transformation and adoption pathways to 30+ Chief Digital Officers (CDOs) across Malaysia’s public universities.',
    category: 'Government & Higher Education',
    image: '/assets/photos/staging-university-workshop.jpg',
    imageAlt: 'Executive higher education workshop session conducted for university leadership and digital officers',
    logo: '/assets/partners/Ministry-of-Education.png',
    stat: '30+ CDOs Briefed'
  },
  {
    entity: 'National AI Skilling Ecosystem (AINSI)',
    role: 'Ecosystem-Wide Workforce Impact',
    scope: 'Contributed to national multi-stakeholder initiatives advancing AI literacy and adoption across government agencies, education institutions, and industry, reaching 800,000+ Malaysians nationwide.',
    category: 'National AI Initiative',
    image: '/assets/photos/parliament-ai-skilling.jpeg',
    imageAlt: 'Advancing the national AI skilling agenda at Parliament of Malaysia with government and industry leaders',
    logo: '/assets/partners/Microsoft.png',
    stat: '800,000+ Reached in Ecosystem'
  },
  {
    entity: 'Ministry of Education (MOE)',
    role: 'Organizational & Leadership Transformation',
    scope: 'Awarded project to conduct organizational Gap Analysis, formulate capability roadmaps, and champion executive leadership transformation across educational administrative cohorts.',
    category: 'Federal Ministry',
    image: '/assets/photos/hero-training.jpg',
    imageAlt: 'Leadership transformation workshop session conducted for education administrators',
    logo: '/assets/partners/Ministry-of-Education.png',
    stat: 'Gap Analysis & Transformation'
  },
  {
    entity: 'Malaysia Healthcare Travel Council (MHTC)',
    role: 'Healthcare Sector Digital Strategy',
    scope: 'Conducted targeted training for the MHTC corporate team on navigating healthcare digital marketing, patient journey communication, and international positioning.',
    category: 'Statutory Body',
    image: '/assets/photos/mhtc-healthcare-workshop.jpeg',
    imageAlt: 'GET Academy corporate digital training with the Malaysia Healthcare Travel Council (MHTC) team',
    logo: '/assets/partners/Kuala-Lumpur.png',
    stat: 'Healthcare Sector Capability'
  },
  {
    entity: 'Unit Transformasi Masyarakat India (SEDIC - MITRA)',
    role: 'Socio-Economic Development (B40 / M40)',
    scope: 'Designed and delivered end-to-end entrepreneurship coaching and business digitalization programs empowering 50 small business owners with actionable commercial tools.',
    category: 'Socio-Economic Initiative',
    image: '/assets/photos/mitra-entrepreneurship-coaching.jpeg',
    imageAlt: 'Socio-economic entrepreneurship development coaching session supported by MITRA',
    logo: '/assets/partners/sedic.jpg',
    stat: '50 Business Owners Coached'
  }
];

// Accreditations & Institutional Relationships Classified by Relationship Type (Pages 1, 8, 9, 11, 26, 28)
const relationshipGroups = [
  {
    type: 'Authorised Training Partnership',
    description: 'Certified curriculum and global certification delivery',
    items: [
      { name: 'CompTIA Authorized Partner', logo: '/assets/partners/CompTIA.png', note: 'Endorsed Computing Technology Industry Association Partner' }
    ]
  },
  {
    type: 'Academic & University Partnership',
    description: 'Joint credentialing and strategic education frameworks',
    items: [
      { name: 'SEGi University & Colleges', logo: '/assets/partners/SEGI.png', note: 'Strategic Educational Partner & Franchisee for certified modules' }
    ]
  },
  {
    type: 'Government & Digital Agency Appointments',
    description: 'Official capacity building and digital solution appointments',
    items: [
      { name: 'Malaysia Digital Economy Corporation (MDEC)', logo: '/assets/brand/getacademy-banner.png', note: 'Appointed Digital Training Partner (Digital Up & Let’s Learn Digital)' },
      { name: 'Malaysia Productivity Corporation (MPC)', logo: '/assets/partners/mosti.png', note: 'Appointed Digital Solution Provider & Digitalization Committee Member' }
    ]
  },
  {
    type: 'Statutory Membership & Trade Engagements',
    description: 'Institutional memberships and bilateral trade facilitation',
    items: [
      { name: 'MATRADE Member', logo: '/assets/partners/Kuala-Lumpur.png', note: 'Official member & contributor to international trade sourcing programmes' },
      { name: 'HRD Corp Registered Provider', logo: '/assets/partners/HRDF.png', note: 'Registered training provider (LLP0019343-LGN; certificate renewal verification note applies)' }
    ]
  }
];

// Documented Enterprise & Institutional Client Logos (PDF Page 25, 31)
const clientLogos = [
  { name: 'Ministry of Education', file: 'Ministry-of-Education.png' },
  { name: 'MOSTI', file: 'mosti.png' },
  { name: 'Dewan Bandaraya Kuala Lumpur', file: 'Kuala-Lumpur.png' },
  { name: 'SEGi University', file: 'SEGI.png' },
  { name: 'Kings College', file: 'Kings-College.png' },
  { name: 'Malaysia Airlines', file: 'malaysia-airlines.png' },
  { name: 'Shopee', file: 'shopee.png' },
  { name: 'Lazada', file: 'lazada.png' },
  { name: 'HP', file: 'hp.png' },
  { name: 'IBM', file: 'IBM.png' },
  { name: 'Digi', file: 'digi.png' },
  { name: 'Atos', file: 'ATOS.png' }
];

// Documented Differentiators (PDF Page 6)
const differentiators = [
  {
    title: 'Practitioner-Led Expertise',
    desc: 'Our facilitators possess extensive real-world sector backgrounds, translating theoretical models into actionable workplace tools with deep domain understanding.'
  },
  {
    title: 'Flexible On-Site & Virtual Delivery',
    desc: 'Training sessions conducted on-site at client premises or virtually in high-engagement formats, accommodating organizational shift patterns and timelines.'
  },
  {
    title: 'Practical, Applied Learning',
    desc: 'Hands-on workshop dynamics, live discussions, simulation exercises, and actionable rubrics designed for immediate workplace implementation.'
  },
  {
    title: 'Global Certification Alignment',
    desc: 'Curricula structured in accordance with globally recognized certification frameworks (CompTIA, SEGi) validating specialized workforce competencies.'
  },
  {
    title: 'Measurable Capability & Business Outcomes',
    desc: 'Focusing on verified skill transfer, enhanced operational efficiency, employee satisfaction, and quantifiable capability improvement.'
  }
];

// Curated verified course sample
const featuredCourses = coursesData.slice(0, 6);
---

<BaseLayout 
  title="Global Experiential Training Academy PLT — Human Capital Development Partner"
  description="GET Academy is an established human capital development and skills training partner for enterprises, government agencies, and educational institutions across Malaysia."
>
  <!-- Section 1 — Hero: Who We Are (Visual-First Modern Corporate Design) -->
  <section class="relative bg-gradient-to-b from-[#244336] via-[#2D5444] to-[#244336] text-white overflow-hidden py-14 sm:py-20 lg:py-24 border-b border-brand-sage/30">
    <!-- Subtle Background Texture -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FADB50_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-sage/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy: Clean, Direct, and Uncluttered -->
        <div class="lg:col-span-6 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-brand-gold/30 text-brand-gold text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
            <span>Human Capital Development Partner</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-tight text-white">
            Your Unbeatable <span class="text-brand-gold">Human Capital</span> Development Partner
          </h1>

          <p class="text-base sm:text-lg text-gray-200 leading-relaxed max-w-xl">
            We partner with enterprises, government agencies, and educational institutions across Malaysia to build practical capabilities in artificial intelligence, technology, leadership, and operational excellence.
          </p>

          <!-- Two Clear Actions -->
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href="#corporate-enquiry"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-brand-dark bg-brand-gold hover:bg-brand-gold-deep shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
            >
              <span>Discuss Your Training Needs</span>
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="#what-we-do"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-white bg-transparent border-2 border-white/70 hover:bg-white/10 hover:border-white transition-all"
            >
              Explore Our Capabilities
            </a>
          </div>
        </div>

        <!-- Hero Visual: Prominent Authentic Photograph from Company Profile PDF -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 group">
            <img 
              src="/assets/photos/live-workshop-facilitator.jpeg" 
              alt="GET Academy corporate workshop facilitator conducting an interactive training session" 
              class="w-full h-80 sm:h-[420px] lg:h-[460px] object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>
            
            <div class="absolute bottom-4 left-4 right-4 bg-brand-dark/85 backdrop-blur-md p-4 rounded-xl border border-white/15 text-white flex items-center justify-between gap-4">
              <div class="space-y-0.5">
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-gold block">
                  Interactive Adult Learning
                </span>
                <p class="text-xs text-gray-200 font-medium">
                  Practitioner-led workshop delivery for corporate and institutional cohorts
                </p>
              </div>
              <span class="shrink-0 px-2.5 py-1 rounded bg-brand-sage text-[10px] font-bold text-white uppercase tracking-wider">
                GET Academy
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 — What We Do: 4 Capability Pillars -->
  <section class="py-20 lg:py-24 bg-white" id="what-we-do">
    <div class="container-custom">
      <SectionHeader 
        eyebrow="Core Capabilities"
        title="What We Do"
        subtitle="Specialized human capital and capability development structured across four distinct pillars for organizations seeking measurable operational growth."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {capabilityPillars.map((pillar) => (
          <div class="bg-brand-light rounded-2xl border border-brand-border hover:border-brand-sage/60 hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden group">
            <!-- Visual Asset: Meaningful Photograph or Certified Strip from Company Profile -->
            <div class="relative h-48 w-full bg-slate-100 overflow-hidden border-b border-brand-border">
              {pillar.isBrandGraphic ? (
                <div class="w-full h-full p-4 flex items-center justify-center bg-white group-hover:scale-105 transition-transform duration-500">
                  <img 
                    src={pillar.image} 
                    alt={pillar.imageAlt}
                    class="max-h-24 max-w-full object-contain"
                    loading="lazy"
                  />
                </div>
              ) : (
                <img 
                  src={pillar.image} 
                  alt={pillar.imageAlt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              )}
              
              <!-- Badge Overlay -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="bg-brand-dark/90 backdrop-blur-sm text-brand-gold text-xs font-mono font-extrabold px-2.5 py-1 rounded shadow-sm">
                  {pillar.number}
                </span>
                <span class="bg-white/95 backdrop-blur-sm text-brand-dark text-[10px] font-bold px-2 py-1 rounded shadow-sm">
                  {pillar.badge}
                </span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2 text-brand-sage">
                  <pillar.icon class="w-4 h-4 shrink-0" />
                  <span class="text-[11px] font-bold uppercase tracking-wider text-brand-sage">
                    {pillar.subtitle}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-brand-dark group-hover:text-brand-sage transition-colors leading-snug mb-3">
                  {pillar.title}
                </h3>

                <p class="text-xs text-brand-muted leading-relaxed mb-4">
                  {pillar.description}
                </p>
              </div>

              <!-- Action Link -->
              <div class="pt-4 border-t border-brand-border/70">
                <a
                  href={pillar.href}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage group-hover:text-brand-sage-dark group-hover:translate-x-0.5 transition-all"
                >
                  <span>Explore Track</span>
                  <ArrowRight class="w-3.5 h-3.5 text-brand-sage" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3 — Institutional Experience and Impact -->
  <section class="py-20 bg-brand-light border-y border-brand-border" id="institutional-experience">
    <div class="container-custom">
      <!-- Section Header & Ecosystem Attribution Context -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        <div class="lg:col-span-7 space-y-3">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage">Demonstrated Track Record</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Institutional Experience & Public Sector Impact</h2>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed max-w-2xl">
            GET Academy is entrusted by federal ministries, statutory bodies, and university leadership to design capability roadmaps, executive advisory, and technological skilling.
          </p>
        </div>
        <div class="lg:col-span-5 bg-white p-5 rounded-2xl border border-brand-border shadow-sm flex items-start gap-3.5">
          <div class="w-9 h-9 rounded-xl bg-brand-sage-light text-brand-sage flex items-center justify-center shrink-0 mt-0.5">
            <Globe2 class="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-sage block mb-1">Ecosystem-Wide Reach Context</span>
            <p class="text-xs text-brand-muted leading-relaxed">
              Through national collaborative ecosystems (including Microsoft Malaysia’s AI National Skilling Initiative — AINSI), our leadership contributed to multi-stakeholder programs reaching <strong class="text-brand-dark">800,000+ Malaysians</strong> across ministries, universities, and industry bodies.
            </p>
          </div>
        </div>
      </div>

      <!-- Featured Engagement Showcase (MOHE Briefing) -->
      <div class="mb-8">
        <div class="bg-white rounded-2xl border border-brand-border shadow-sm overflow-hidden hover:border-brand-sage/50 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
            <div class="lg:col-span-5 relative min-h-[260px] lg:min-h-[340px] bg-slate-100 overflow-hidden">
              <img 
                src={documentedEngagements[0].image} 
                alt={documentedEngagements[0].imageAlt} 
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent lg:hidden"></div>
              <span class="absolute bottom-3 left-3 lg:top-4 lg:left-4 lg:bottom-auto px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-brand-gold text-brand-dark shadow-sm">
                Featured Engagement
              </span>
            </div>
            <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span class="px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-brand-sage-light text-brand-sage">
                    Government & Higher Education
                  </span>
                  <span class="px-2.5 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                    30+ CDOs Briefed
                  </span>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-2 leading-snug">
                  Ministry of Higher Education (MOHE)
                </h3>
                <p class="text-sm font-semibold text-brand-sage mb-3">
                  Public University AI Readiness Briefing
                </p>
                <p class="text-sm text-brand-muted leading-relaxed mb-6">
                  Invited by the Deputy Secretary-General to present strategic AI transformation and adoption pathways to 30+ Chief Digital Officers (CDOs) across Malaysia’s public universities.
                </p>
              </div>

              <div class="pt-4 border-t border-brand-border/70 flex flex-wrap items-center justify-between gap-3 text-xs text-brand-muted">
                <div class="flex items-center gap-1.5 font-semibold text-emerald-800">
                  <CheckCircle2 class="w-4 h-4 text-emerald-700" />
                  <span>Documented Executive Advisory</span>
                </div>
                <span class="text-[11px] text-slate-500">Official Company Profile, Page 16</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Supporting Engagements Grid (4 Cards with Genuine Photography) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {documentedEngagements.slice(1).map((eng) => (
          <div class="bg-white rounded-xl border border-brand-border shadow-sm hover:border-brand-sage/60 hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden group">
            <div class="relative h-44 w-full bg-slate-100 overflow-hidden">
              <img 
                src={eng.image} 
                alt={eng.imageAlt} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-white/95 text-brand-dark shadow-sm backdrop-blur-sm">
                {eng.category}
              </span>
              <span class="absolute bottom-2 left-2.5 right-2.5 text-[11px] font-bold text-white drop-shadow truncate">
                {eng.stat}
              </span>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-sm font-bold text-brand-dark mb-1 leading-snug group-hover:text-brand-sage transition-colors">
                  {eng.entity}
                </h3>
                <p class="text-xs font-semibold text-brand-sage mb-2.5">
                  {eng.role}
                </p>
                <p class="text-xs text-brand-muted leading-relaxed line-clamp-3">
                  {eng.scope}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center gap-1.5 text-[11px] font-semibold text-emerald-800">
                <CheckCircle2 class="w-3.5 h-3.5 shrink-0 text-emerald-700" />
                <span class="truncate">Documented Engagement</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4 — Accreditations and Institutional Relationships -->
  <section class="py-20 bg-white" id="accreditations">
    <div class="container-custom">
      <SectionHeader 
        eyebrow="Institutional Relationships"
        title="Accreditations & Organizational Affiliations"
        subtitle="Transparently categorized by formal partnership status, authorized training agreements, and statutory memberships."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto mb-10">
        {relationshipGroups.map((group) => (
          <div class="bg-brand-light p-6 rounded-xl border border-brand-border flex flex-col justify-between">
            <div>
              <span class="text-xs font-extrabold uppercase tracking-wider text-brand-sage block mb-1">
                {group.type}
              </span>
              <p class="text-xs text-brand-muted mb-4">{group.description}</p>
              <div class="space-y-3">
                {group.items.map((item) => (
                  <div class="p-3 bg-white rounded-lg border border-brand-border flex items-center gap-4">
                    <img 
                      src={item.logo} 
                      alt={item.name} 
                      class="max-h-8 max-w-[90px] object-contain shrink-0" 
                      loading="lazy"
                    />
                    <div>
                      <h4 class="text-xs font-bold text-brand-dark">{item.name}</h4>
                      <p class="text-[11px] text-brand-muted">{item.note}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Verification Status Notice regarding HRD Corp Certificate -->
      <div class="max-w-4xl mx-auto bg-amber-50/80 border border-amber-200 rounded-xl p-4 sm:p-5 flex items-start gap-3 text-xs text-amber-900">
        <ShieldCheck class="w-5 h-5 text-amber-800 shrink-0 mt-0.5" />
        <div class="space-y-1">
          <p class="font-bold uppercase tracking-wide">Accreditation Verification Transparency:</p>
          <p class="leading-relaxed">
            The HRD Corp Training Provider Certificate in the profile documents registration validity through 2 September 2025. Current active renewal certificates and individual trainer HRD Corp TTT credentials are confirmed and furnished directly to corporate procurement teams upon formal inquiry.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5 — Why GET Academy: Documented Differentiators -->
  <section class="py-20 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-brand-border relative">
            <img 
              src="/assets/photos/about-team.jpg" 
              alt="GET Academy corporate capability session" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-5 inset-x-5 text-white">
              <span class="text-xs font-bold text-brand-gold uppercase tracking-wider block mb-1">Corporate Delivery Standard</span>
