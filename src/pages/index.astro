// Incubation Pipeline (FinTech Venture)
const incubationProjects = [
  {
    id: 'fintech-venture',
    name: 'Enterprise FinTech Venture',
    sector: 'Financial Technology Infrastructure',
    status: 'In R&D Incubation',
    stage: 'Phase 02 Architecture',
    description: 'An upcoming financial technology initiative architecting institutional digital transaction infrastructure, programmable settlement pipelines, and regulatory-compliant digital asset rails.',
    focusAreas: ['Digital Transaction Infrastructure', 'Programmable Settlement', 'Regulatory Compliance'],
  },
];

// Track-record preview: one featured engagement and six supporting projects
const [featuredProject, ...previewProjects] = projects.filter((p) => p.home);

// International teaser (see /international)
const internationalHighlights = [
  {
    id: 'un-ai-governance',
    region: 'United Nations',
    title: 'Global Dialogue on AI Governance 2026',
    image: '/assets/photos/un-ai-governance-dialogue.jpg',
