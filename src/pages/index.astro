---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CourseCard from '@/components/ui/CourseCard.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import ProjectFeature from '@/components/ui/ProjectFeature.astro';
import TestimonialCard from '@/components/ui/TestimonialCard.astro';
import LogoGrid from '@/components/ui/LogoGrid.astro';
import CompTIAPanel from '@/components/ui/CompTIAPanel.astro';
import AccreditationCarousel from '@/components/ui/AccreditationCarousel.astro';
import coursesData from '@/data/courses.json';
import { projects } from '@/data/track-record';
import { featuredTestimonials } from '@/data/testimonials';
import { differentiators } from '@/data/why-partner';
import { featuredLogos } from '@/data/clients';
import { audiences } from '@/data/programmes';
import { site, mapsUrl } from '@/data/site';
import {
  ArrowRight,
  Building2,
  Briefcase,
  CheckCircle2,
  Cpu,
  Globe2,
  GraduationCap,
  Laptop,
  Mail,
  MapPin,
  Phone,
  Rocket,
  Send,
  ShieldCheck,
  Award,
} from 'lucide-astro';

// 4 capability pillars (company profile, slide 2)
const capabilityPillars = [
  {
    number: '01',
    icon: Cpu,
    title: 'Artificial Intelligence Capacity Building',
    subtitle: 'Institutional & Workforce AI Adoption',
    description: 'Institutional AI readiness, leadership advisory, and practical AI adoption for educators, public sector leaders, and corporate workforces.',
    image: '/assets/photos/ai-educator-training.jpeg',
    imageAlt: 'GET Academy educators and institutional leaders in an applied AI training session',
    href: '/track-record#projects',
    badge: 'Institutional & Workforce AI'
  },
  {
    number: '02',
    icon: Globe2,
    title: 'Entrepreneurship & Cross-Border Business',
    subtitle: 'Incubation & Market Expansion',
    description: 'Certified digital marketing strategies (CDMS), enterprise incubation, and market expansion pathways connecting local businesses with global ecosystems.',
    image: '/assets/photos/cross-border-select-usa.jpeg',
    imageAlt: 'GET Academy international cross-border business and enterprise incubation initiative',
    href: '/international',
    badge: 'Digital Strategy & Incubation'
  },
  {
    number: '03',
    icon: ShieldCheck,
    title: 'Global IT Certification',
    subtitle: 'Industry-Aligned Credentials',
    description: 'Industry-aligned IT and cybersecurity training, including CompTIA certification pathways and foundational digital resilience for non-IT personnel.',
    isBrandGraphic: true,
    imageAlt: 'CompTIA international certification pathways',
    href: '/courses?category=technical-it',
    badge: 'CompTIA Pathways'
  },
  {
    number: '04',
    icon: Award,
    title: 'Professional Development',
    subtitle: 'Managerial & Operational Excellence',
    description: 'Applied leadership development, customer experience management, design thinking, root-cause problem solving, and cross-functional team performance.',
    image: '/assets/photos/welcome-classroom-session.jpeg',
    imageAlt: 'Interactive classroom workshop session on managerial capabilities',
    href: '/courses?category=workplace-performance',
    badge: 'Leadership & Team Performance'
  }
];

// Track-record preview: one featured engagement and six supporting projects
const [featuredProject, ...previewProjects] = projects.filter((p) => p.home);

// International teaser (see /international)
const internationalHighlights = [
  {
    id: 'un-ai-governance',
    region: 'United Nations',
    title: 'Global Dialogue on AI Governance 2026',
    image: '/assets/photos/un-ai-governance-dialogue.jpg',
    position: 'center'
  },
  {
    id: 'unesco-ee-net',
    region: 'UNESCO · Uzbekistan',
    title: 'Entrepreneurship Education Network (EE-Net)',
    image: '/assets/photos/unesco-ee-net-tashkent.jpg',
    position: 'center 30%'
  },
  {
    id: 'new-york',
    region: 'United States',
    title: 'Consulate General of Malaysia & MATRADE, New York',
    image: '/assets/photos/nyc-consulate-general.jpg',
    position: 'center 25%'
  },
  {
    id: 'uk-india',
    region: 'United Kingdom',
    title: 'Birmingham City University tripartite MoU',
    image: '/assets/photos/mbcie-verse.jpg',
    position: 'center'
  }
];

const audienceIcons = {
  organisations: Building2,
  professionals: Briefcase,
  students: GraduationCap,
  'business-owners': Rocket
} as const;

// Hand-picked programmes across the four pathways
const featuredCourses = coursesData.filter((course) => course.featured);
---

<BaseLayout
  title="Global Experiential Training Academy PLT — Human Capital Development Partner"
  description="GET Academy is an established human capital development and skills training partner for enterprises, government agencies, and educational institutions across Malaysia."
>
  <!-- Section 1 — Hero: Who We Are (Visual-First Modern Corporate Design) -->
  <section id="hero" class="relative bg-gradient-to-b from-[#244336] via-[#2D5444] to-[#244336] text-white overflow-hidden py-14 sm:py-20 lg:py-24 border-b border-brand-sage/30">
    <!-- Subtle Background Texture -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FADB50_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-sage/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy: Clean, Direct, and Uncluttered -->
        <div class="lg:col-span-6 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-brand-gold/30 text-brand-gold text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
            <span>Human Capital Development Partner</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-tight text-white">
            Your Unbeatable <span class="text-brand-gold">Human Capital</span> Development Partner
          </h1>

          <p class="text-base sm:text-lg text-gray-200 leading-relaxed max-w-xl">
            We partner with enterprises, government agencies, and educational institutions across Malaysia to build practical capabilities in artificial intelligence, technology, leadership, and operational excellence.
          </p>

          <!-- Two Clear Actions -->
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href="#corporate-enquiry"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-brand-dark bg-brand-gold hover:bg-brand-gold-deep shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
            >
              <span>Discuss Your Training Needs</span>
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="#what-we-do"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold rounded-lg text-white bg-transparent border-2 border-white/70 hover:bg-white/10 hover:border-white transition-all"
            >
              Explore Our Capabilities
            </a>
          </div>
        </div>

        <!-- Hero Visual: Prominent Authentic Photograph from Company Profile PDF -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 group">
            <img
              src="/assets/photos/live-workshop-facilitator-enhanced.jpg"
              alt="GET Academy corporate workshop facilitator conducting an interactive training session"
              class="w-full h-80 sm:h-[420px] lg:h-[460px] object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
              width="1539"
              height="1737"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>

            <div class="absolute bottom-4 left-4 right-4 bg-brand-dark/85 backdrop-blur-md p-4 rounded-xl border border-white/15 text-white flex items-center justify-between gap-4">
              <div class="space-y-0.5">
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-gold block">
                  Interactive Adult Learning
                </span>
                <p class="text-xs text-gray-200 font-medium">
                  Practitioner-led workshop delivery for corporate and institutional cohorts
                </p>
              </div>
              <span class="shrink-0 px-2.5 py-1 rounded bg-brand-sage text-[10px] font-bold text-white uppercase tracking-wider">
                GET Academy
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 — What We Do: 4 Capability Pillars -->
  <section class="py-20 lg:py-24 bg-white" id="what-we-do">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Core Capabilities"
        title="What We Do"
        subtitle="Specialized human capital and capability development structured across four distinct pillars for organizations seeking measurable operational growth."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {capabilityPillars.map((pillar) => (
          <div class="bg-brand-light rounded-2xl border border-brand-border hover:border-brand-sage/60 hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden group">
            <!-- Visual Asset: Meaningful Photograph or Certified Strip from Company Profile -->
            <div class="relative h-48 w-full bg-slate-100 overflow-hidden border-b border-brand-border">
              {pillar.isBrandGraphic ? (
                <CompTIAPanel />
              ) : (
                <img
                  src={pillar.image}
                  alt={pillar.imageAlt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              )}

              <!-- Badge Overlay -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="bg-brand-dark/90 backdrop-blur-sm text-brand-gold text-xs font-mono font-extrabold px-2.5 py-1 rounded shadow-sm">
                  {pillar.number}
                </span>
                <span class="bg-white/95 backdrop-blur-sm text-brand-dark text-[10px] font-bold px-2 py-1 rounded shadow-sm">
                  {pillar.badge}
                </span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2 text-brand-sage">
                  <pillar.icon class="w-4 h-4 shrink-0" />
                  <span class="text-[11px] font-bold uppercase tracking-wider text-brand-sage">
                    {pillar.subtitle}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-brand-dark group-hover:text-brand-sage transition-colors leading-snug mb-3">
                  {pillar.title}
                </h3>

                <p class="text-xs text-brand-muted leading-relaxed mb-4">
                  {pillar.description}
                </p>
              </div>

              <!-- Action Link -->
              <div class="pt-4 border-t border-brand-border/70">
                <a
                  href={pillar.href}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage group-hover:text-brand-sage-dark group-hover:translate-x-0.5 transition-all"
                >
                  <span>Explore Track</span>
                  <ArrowRight class="w-3.5 h-3.5 text-brand-sage" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3 — Institutional Experience and Impact -->
  <section class="py-20 bg-brand-light border-y border-brand-border" id="institutional-experience">
    <div class="container-custom">
      <!-- Section Header & Ecosystem Attribution Context -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        <div class="lg:col-span-7 space-y-3">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage">Demonstrated Track Record</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Institutional Experience & Public Sector Impact</h2>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed max-w-2xl">
            GET Academy is entrusted by federal ministries, statutory bodies, and university leadership to design capability roadmaps, executive advisory, and technological skilling.
          </p>
        </div>
        <div class="lg:col-span-5 bg-white p-5 rounded-2xl border border-brand-border shadow-sm flex items-start gap-3.5">
          <div class="w-9 h-9 rounded-xl bg-brand-sage-light text-brand-sage flex items-center justify-center shrink-0 mt-0.5">
            <Globe2 class="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-sage block mb-1">Ecosystem-Wide Reach Context</span>
            <p class="text-xs text-brand-muted leading-relaxed">
              Through national collaborative ecosystems (including Microsoft Malaysia’s AI National Skilling Initiative — AINSI), our leadership contributed to multi-stakeholder programs reaching <strong class="text-brand-dark">800,000+ Malaysians</strong> across ministries, universities, and industry bodies.
            </p>
          </div>
        </div>
      </div>

      <!-- Featured Engagement Showcase (MOHE Briefing) -->
      <div class="mb-8">
        <ProjectFeature
          title={featuredProject.title}
          organisation={featuredProject.organisation}
          category={featuredProject.category}
          summary={featuredProject.summary}
          image={featuredProject.image!}
          imageAlt={featuredProject.imageAlt!}
          stat={featuredProject.stat}
          note="By invitation of the Deputy Secretary-General, MOHE"
          href="/track-record"
        />
      </div>

      <!-- Supporting Engagements -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {previewProjects.map((project) => (
          <ProjectCard
            title={project.title}
            organisation={project.organisation}
            category={project.category}
            summary={project.summary}
            image={project.image}
            imageAlt={project.imageAlt}
            stat={project.stat}
            clamp={true}
          />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/track-record"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm"
        >
          <span>View the Full Track Record</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Section 4 — International Network teaser -->
  <section class="py-20 bg-brand-dark text-white" id="international">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-gold mb-2.5">International Network</p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight leading-tight">Global projects & partnerships</h2>
          <p class="mt-3.5 text-base text-gray-300 leading-relaxed">
            From AI governance consultations at the United Nations to startup collaboration in Uzbekistan and an academic MoU in the United Kingdom, we connect Malaysian talent and enterprises with international ecosystems.
          </p>
        </div>
        <a
          href="/international"
          class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold rounded-lg text-brand-dark bg-brand-gold hover:bg-brand-gold-deep transition-colors shadow-md"
        >
          <span>Explore the International Network</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {internationalHighlights.map((item) => (
          <a
            href={`/international#${item.id}`}
            class="group relative rounded-2xl overflow-hidden aspect-[4/5] bg-white/5 border border-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold"
          >
            <img
              src={item.image}
              alt=""
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              style={`object-position: ${item.position};`}
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 inset-x-0 p-5">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-gold block mb-1">{item.region}</span>
              <span class="text-base font-bold leading-snug block">{item.title}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5 — Accreditations and Institutional Relationships -->
  <section class="py-20 bg-white" id="accreditations">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Academia | Certification Provider | Government | Industry Experts"
        title="Accreditations & Organizational Affiliations"
        subtitle="Franchise, certification and appointment relationships with academic, government and industry bodies."
        centered={true}
      />

      <AccreditationCarousel />
    </div>
  </section>

  <!-- Section 6 — Why Partner With Us -->
  <section class="py-20 bg-brand-light border-y border-brand-border" id="why-get-academy">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">The Strategic Advantage</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">
          Why Partner With Us?
        </h2>
        <p class="text-sm sm:text-base text-brand-muted mt-3 leading-relaxed">
          Five reasons organisations choose GET Academy to build practical, certified and measurable capability in their teams.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 max-w-6xl mx-auto">
        {differentiators.map((diff, index) => (
          <div class={`bg-white rounded-2xl border border-brand-border shadow-sm hover:border-brand-sage/60 hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col group ${index < 3 ? 'lg:col-span-2' : 'lg:col-span-3'}`}>
            <!-- Visual: photograph or accreditation logos -->
            <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
              {diff.image ? (
                <>
                  <img
                    src={diff.image}
                    alt={diff.imageAlt ?? ''}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                </>
              ) : (
                <div class="w-full h-full bg-white flex items-center justify-center gap-6 px-6">
                  {diff.logos?.map((logo) => (
                    <img src={logo.src} alt={logo.alt} class="max-h-20 max-w-[30%] w-auto object-contain" loading="lazy" />
                  ))}
                </div>
              )}

              <!-- Number & Tagline Badges -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-full text-xs font-extrabold font-mono bg-brand-dark/90 text-brand-gold border border-brand-gold/30 backdrop-blur-sm shadow-xs">
                  {diff.number}
                </span>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/95 text-brand-dark shadow-xs backdrop-blur-sm">
                  {diff.tagline}
                </span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-brand-dark mb-2.5 leading-snug group-hover:text-brand-sage transition-colors">
                  {diff.title}
                </h3>
                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-5">
                  {diff.desc}
                </p>
              </div>

              <div class="pt-4 border-t border-brand-border/60">
                <div class="flex flex-wrap items-center gap-1.5">
                  {diff.keyAspects.map((aspect) => (
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-medium bg-brand-light text-brand-sage border border-brand-border/80">
                      <CheckCircle2 class="w-3 h-3 text-emerald-700 shrink-0" />
                      <span>{aspect}</span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 7 — Testimonials -->
  <section class="py-20 bg-white" id="testimonials">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
        <div class="max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Participant Feedback</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">What Our Trainees Say</h2>
          <p class="text-sm sm:text-base text-brand-muted mt-2">
            Founders and marketers describe learning with Coach GK in their own words.
          </p>
        </div>
        <a
          href="/testimonials"
          class="shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm"
        >
          <span>Read All Testimonials</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {featuredTestimonials.map((t, i) => (
          <TestimonialCard
            name={t.name}
            role={t.role}
            programme={t.programme}
            paragraphs={[t.highlight]}
            accent={i % 2 === 0 ? 'green' : 'gold'}
            href={`/testimonials#${t.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Client Logos Showcase -->
  <section class="py-14 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-xs font-extrabold uppercase tracking-widest text-brand-sage block mb-1">Our Engagements</span>
        <h3 class="text-xl font-extrabold text-brand-dark">Organisations We Have Engaged With</h3>
      </div>
      <LogoGrid logos={featuredLogos} />
      <div class="mt-8 text-center">
        <a href="/track-record#ecosystem" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-sage hover:text-brand-sage-dark">
          <span>See all partners and ecosystem organisations</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Section 8 — Training Programmes (Curated Portfolio) -->
  <section class="py-20 bg-white border-b border-brand-border" id="programmes">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Curriculum Offerings</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Programmes for Every Learner</h2>
          <p class="text-sm sm:text-base text-brand-muted mt-2 max-w-xl">
            Programmes spanning digital marketing (CDMS), business incubation, global IT certification and professional development. All HRDC claimable.
          </p>
        </div>
        <div>
          <a
            href="/courses"
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm"
          >
            <span>Browse Full Catalogue</span>
            <ArrowRight class="w-4 h-4 ml-1.5" />
          </a>
        </div>
      </div>

      <!-- Learner pathways -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-14">
        {audiences.map((audience) => {
          const Icon = audienceIcons[audience.id as keyof typeof audienceIcons] ?? Laptop;
          return (
            <a
              href={audience.href}
              class="group p-6 rounded-2xl bg-brand-light border border-brand-border hover:border-brand-sage/60 hover:shadow-md transition-all flex flex-col"
            >
              <span class="w-11 h-11 rounded-xl bg-white border border-brand-border text-brand-sage flex items-center justify-center mb-4">
                <Icon class="w-5 h-5" aria-hidden="true" />
              </span>
              <h3 class="text-base font-bold text-brand-dark mb-2 leading-snug">{audience.title}</h3>
              <p class="text-xs text-brand-muted leading-relaxed flex-1">{audience.text}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage group-hover:text-brand-sage-dark">
                <span>{audience.cta}</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </span>
            </a>
          );
        })}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {featuredCourses.map((course) => (
          <CourseCard {...course} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 9 — Corporate and Government Enquiries -->
  <section class="py-20 bg-brand-dark text-white" id="corporate-enquiry">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Left: Official Contact Desk -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-extrabold uppercase tracking-widest text-brand-gold block">B2B & Institutional Engagement</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Discuss Your Training Needs</h2>
          <p class="text-gray-200 text-sm leading-relaxed">
            We partner with corporate HR directors, government training coordinators, and higher education leaders to formulate tailored capability frameworks and proposal schedules.
          </p>

          <div class="p-6 bg-white/5 rounded-2xl border border-white/10 space-y-4 text-xs text-gray-300">
            <h4 class="text-brand-gold font-bold uppercase tracking-wider">Official Corporate Desk</h4>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <Building2 class="w-4 h-4 text-brand-gold shrink-0 mt-0.5" />
                <div>
                  <span class="block font-bold text-white uppercase text-[11px]">Corporate Entity</span>
                  <span class="text-gray-200">{site.legalName} ({site.llpNumber})</span>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <MapPin class="w-4 h-4 text-brand-gold shrink-0 mt-0.5" />
                <div>
                  <span class="block font-bold text-white uppercase text-[11px]">Registered Corporate Office</span>
                  <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-gray-200 hover:text-brand-gold transition-colors">{site.address.singleLine}</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Mail class="w-4 h-4 text-brand-gold shrink-0 mt-0.5" />
                <div>
                  <span class="block font-bold text-white uppercase text-[11px]">Enquiry Email</span>
                  <a href={`mailto:${site.email}`} class="text-gray-200 hover:text-brand-gold transition-colors">{site.email}</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Phone class="w-4 h-4 text-brand-gold shrink-0 mt-0.5" />
                <div>
                  <span class="block font-bold text-white uppercase text-[11px]">Coordinator Contact (PIC)</span>
                  <a href={`tel:${site.phone.tel}`} class="text-gray-200 hover:text-brand-gold transition-colors">{site.phone.display}</a>
                  <span class="text-gray-300"> ({site.pic.name}, COO)</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div class="lg:col-span-7 bg-white text-brand-dark p-8 sm:p-10 rounded-2xl border border-brand-border shadow-xl">
          <div class="mb-6">
            <h3 class="text-xl font-extrabold text-brand-dark">Request an Enterprise or Institutional Proposal</h3>
            <p class="text-xs text-brand-muted mt-1">
              Submit your departmental requirements below and our advisory team will respond within {site.responseTime}.
            </p>
          </div>

          <form id="hero-enquiry-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="org-name" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Full Name *</label>
                <input type="text" id="org-name" name="name" required autocomplete="name" placeholder="e.g. Ts. Ahmad Faizal" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
              <div>
                <label for="org-email" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Official Work Email *</label>
                <input type="email" id="org-email" name="email" required autocomplete="email" placeholder="name@agency.gov.my" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="org-entity" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Organization / Entity *</label>
                <input type="text" id="org-entity" name="organisation" required autocomplete="organization" placeholder="Ministry / Corporation Name" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
              <div>
                <label for="org-sector" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Sector Type *</label>
                <select id="org-sector" name="sector" required class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage">
                  <option value="Government Body / Statutory Agency">Government Body / Statutory Agency</option>
                  <option value="Corporate Enterprise / MNC">Corporate Enterprise / MNC</option>
                  <option value="University / Higher Learning Institution">University / Higher Learning Institution</option>
                  <option value="SME / Private Company">SME / Private Company</option>
                </select>
              </div>
            </div>

            <div>
              <label for="org-pillar" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Primary Capability Track *</label>
              <select id="org-pillar" name="track" required class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage">
                <option value="Artificial Intelligence Capacity Building">Artificial Intelligence Capacity Building</option>
                <option value="Entrepreneurship & Cross-Border Business">Entrepreneurship & Cross-Border Business</option>
                <option value="Global IT Certification (CompTIA, Cyber Security)">Global IT Certification (CompTIA, Cyber Security)</option>
                <option value="Professional Development & Leadership Transformation">Professional Development & Leadership Transformation</option>
                <option value="Custom In-House Capability Outline">Custom In-House Capability Outline</option>
              </select>
            </div>

            <div>
              <label for="org-notes" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Brief Objectives or Target Schedule</label>
              <textarea id="org-notes" name="message" rows="3" placeholder="Outline your team upskilling objectives, target month, or specific cohort requirements..." class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage"></textarea>
            </div>

            <!-- Honeypot: hidden from visitors, catches automated submissions -->
            <div class="hidden" aria-hidden="true">
              <label for="org-website">Website</label>
              <input type="text" id="org-website" name="website_url" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 bg-brand-sage text-white font-bold rounded-lg hover:bg-brand-sage-dark transition-all text-xs shadow-sm disabled:opacity-60">
              <Send class="w-3.5 h-3.5" />
              <span>Submit Training Consultation Request</span>
            </button>
          </form>

          <div id="hero-form-status" class="hidden" role="status" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initEnquiryForm } from '@/lib/enquiry-form';
  import { site } from '@/data/site';

  const heroForm = document.getElementById('hero-enquiry-form') as HTMLFormElement | null;
  const heroStatus = document.getElementById('hero-form-status');

  if (heroForm && heroStatus) {
    initEnquiryForm({
      form: heroForm,
      status: heroStatus,
      formSource: 'homepage-hero',
      fallbackEmail: site.email,
      responseTime: site.responseTime,
    });
  }
</script>
