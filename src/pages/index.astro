              </div>
              <div>
                <label for="org-email" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Official Work Email *</label>
                <input type="email" id="org-email" name="email" required autocomplete="email" placeholder="name@agency.gov.my" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="org-entity" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Organization / Entity *</label>
                <input type="text" id="org-entity" name="organisation" required autocomplete="organization" placeholder="Ministry / Corporation Name" class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage" />
              </div>
              <div>
                <label for="org-sector" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Sector Type *</label>
                <select id="org-sector" name="sector" required class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage">
                  <option value="Government Body / Statutory Agency">Government Body / Statutory Agency</option>
                  <option value="Corporate Enterprise / MNC">Corporate Enterprise / MNC</option>
                  <option value="University / Higher Learning Institution">University / Higher Learning Institution</option>
                  <option value="SME / Private Company">SME / Private Company</option>
                </select>
              </div>
            </div>

            <div>
              <label for="org-pillar" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Primary Focus Area *</label>
              <select id="org-pillar" name="track" required class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage">
                <option value="Digital Transformation Consulting & Strategy">Digital Transformation Consulting & Strategy</option>
                <option value="Software & Technology Implementation">Software & Technology Implementation</option>
                <option value="Workforce AI & Technology Training">Workforce AI & Technology Training</option>
                <option value="Global IT Certification (CompTIA, Cyber Security)">Global IT Certification (CompTIA, Cyber Security)</option>
                <option value="Custom Enterprise Capability Framework">Custom Enterprise Capability Framework</option>
              </select>
            </div>

            <div>
              <label for="org-notes" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1.5">Brief Objectives or Target Schedule</label>
              <textarea id="org-notes" name="message" rows="3" placeholder="Outline your transformation objectives, target month, or specific cohort requirements..." class="w-full px-3.5 py-2.5 bg-brand-light border border-brand-border rounded-lg text-xs text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-sage"></textarea>
            </div>

            <!-- Honeypot: hidden from visitors, catches automated submissions -->
            <div class="hidden" aria-hidden="true">
              <label for="org-website">Website</label>
              <input type="text" id="org-website" name="website_url" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 bg-brand-sage text-white font-bold rounded-lg hover:bg-brand-sage-dark transition-all text-xs shadow-sm disabled:opacity-60">
              <Send class="w-3.5 h-3.5" />
              <span>Submit Consultation Request</span>
            </button>
          </form>

          <div id="hero-form-status" class="hidden" role="status" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initEnquiryForm } from '@/lib/enquiry-form';
  import { site } from '@/data/site';

  const heroForm = document.getElementById('hero-enquiry-form') as HTMLFormElement | null;
  const heroStatus = document.getElementById('hero-form-status');

  if (heroForm && heroStatus) {
    initEnquiryForm({
      form: heroForm,
      status: heroStatus,
      formSource: 'homepage-hero',
      fallbackEmail: site.email,
      responseTime: site.responseTime,
    });
  }

  // Pass static venture data to client controller
  const venturesData = JSON.parse(document.getElementById('ventures-data')?.textContent || '[]');

  // Interactive Project Showcase Controller (desktop focus coordination & keyboard support)
  const showcaseContainer = document.getElementById('project-showcase-container');
  const showcaseCards = document.querySelectorAll<HTMLElement>('.project-showcase-card');

  // Desktop hover coordination: subtle elevation of active card, gentle recess for peer
  if (showcaseContainer && window.matchMedia('(min-width: 1024px)').matches) {
    showcaseCards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        showcaseCards.forEach((other) => {
          if (other !== card) {
            other.classList.add('opacity-80');
          }
        });
      });

      card.addEventListener('mouseleave', () => {
        showcaseCards.forEach((c) => {
          c.classList.remove('opacity-80');
        });
      });
    });
  }

  // Cinematic Video Walkthrough Controller for homepage cards
  const projectVideos = document.querySelectorAll<HTMLVideoElement>('.project-video-player');
  const playButtons = document.querySelectorAll<HTMLButtonElement>('.video-play-center-btn, .video-play-toggle');
  const restartButtons = document.querySelectorAll<HTMLButtonElement>('.video-restart-btn');
  const fullscreenButtons = document.querySelectorAll<HTMLButtonElement>('.video-fullscreen-btn');

  function updatePlayIcons(projectId: string, isPlaying: boolean) {
    const card = document.getElementById(`showcase-${projectId}`);
    if (!card) return;

    const playIcons = card.querySelectorAll('.play-icon, .play-icon-sm');
    const pauseIcons = card.querySelectorAll('.pause-icon, .pause-icon-sm');
    const centerBtn = card.querySelector<HTMLButtonElement>('.video-play-center-btn');

    if (isPlaying) {
      playIcons.forEach((el) => el.classList.add('hidden'));
      pauseIcons.forEach((el) => el.classList.remove('hidden'));
      if (centerBtn) {
        centerBtn.classList.add('opacity-0', 'pointer-events-none');
      }
    } else {
      playIcons.forEach((el) => el.classList.remove('hidden'));
      pauseIcons.forEach((el) => el.classList.add('hidden'));
      if (centerBtn) {
        centerBtn.classList.remove('opacity-0', 'pointer-events-none');
      }
    }
  }

  function formatTime(seconds: number): string {
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  }

  projectVideos.forEach((video) => {
    const projectId = video.getAttribute('data-project-video');
    if (!projectId) return;

    video.addEventListener('timeupdate', () => {
      const card = document.getElementById(`showcase-${projectId}`);
      const display = card?.querySelector<HTMLElement>('.video-time-display');
      if (display) {
        const cur = formatTime(video.currentTime);
        const dur = isNaN(video.duration) ? '--:--' : formatTime(video.duration);
        display.textContent = `${cur} / ${dur}`;
      }
    });

    video.addEventListener('play', () => {
      projectVideos.forEach((other) => {
        if (other !== video && !other.paused) {
          other.pause();
        }
      });
      updatePlayIcons(projectId, true);
    });

    video.addEventListener('pause', () => updatePlayIcons(projectId, false));
    video.addEventListener('ended', () => updatePlayIcons(projectId, false));
  });

  playButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-control-target');
      if (!targetId) return;
      const card = document.getElementById(`showcase-${targetId}`);
      const video = card?.querySelector<HTMLVideoElement>('.project-video-player');
      if (!video) return;

      if (video.paused) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    });
  });

  restartButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-restart-target');
      if (!targetId) return;
      const card = document.getElementById(`showcase-${targetId}`);
      const video = card?.querySelector<HTMLVideoElement>('.project-video-player');
      if (!video) return;

      video.currentTime = 0;
      video.play().catch(() => {});
    });
  });

  fullscreenButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-fullscreen-target');
      if (!targetId) return;
      const card = document.getElementById(`showcase-${targetId}`);
      const video = card?.querySelector<HTMLVideoElement>('.project-video-player');
      if (!video) return;

      if (video.requestFullscreen) {
        video.requestFullscreen();
      }
    });
  });

  // Desktop hover-to-play coordination (subtle preview without motion sickness, respects prefers-reduced-motion)
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced && window.matchMedia('(min-width: 1024px)').matches) {
    showcaseCards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        const video = card.querySelector<HTMLVideoElement>('.project-video-player');
        if (video) {
          video.play().catch(() => {});
        }
      });

      card.addEventListener('mouseleave', () => {
        const video = card.querySelector<HTMLVideoElement>('.project-video-player');
        if (video) {
          video.pause();
        }
      });
    });
  }

  // ==========================================
  // SPATIAL MINI-BROWSER CONTROLLER (PHASE 5)
  // ==========================================
  const modal = document.getElementById('venture-mini-browser-modal');
  const windowEl = document.getElementById('mini-browser-window');
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-open-venture]');
  const closeBtn = document.getElementById('mini-browser-close-btn');
  const escBtn = document.getElementById('mini-browser-esc-btn');
  const urlText = document.getElementById('mini-browser-url-text');
  const externalLink = document.getElementById('mini-browser-external-link') as HTMLAnchorElement | null;
  const tabsContainer = document.getElementById('mini-browser-tabs');
  const viewport = document.getElementById('mini-browser-viewport');
  const footerEntity = document.getElementById('mini-browser-footer-entity');
  const footerCta = document.getElementById('mini-browser-footer-cta') as HTMLAnchorElement | null;

  let activeVenture: any = null;
  let activeSectionId = 'overview';
  let lastActiveTrigger: HTMLElement | null = null;
  let scrollPos = 0;
  let isAnimating = false;

  function renderSection(sectionId: string) {
    if (!activeVenture || !viewport || !tabsContainer) return;
    activeSectionId = sectionId;

    // Update Tab Styles
    const tabButtons = tabsContainer.querySelectorAll<HTMLButtonElement>('.mini-tab-btn');
    tabButtons.forEach((btn) => {
      const isCurrent = btn.getAttribute('data-section-id') === sectionId;
      btn.setAttribute('aria-selected', String(isCurrent));
      if (isCurrent) {
        btn.className = `mini-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all border ${activeVenture.theme.badgeBg}`;
      } else {
        btn.className = 'mini-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all border border-transparent text-slate-400 hover:text-white hover:bg-white/5';
      }
    });

    const currentSection = activeVenture.sections.find((s: any) => s.id === sectionId) || activeVenture.sections[0];
    if (!currentSection) return;

    if (currentSection.mediaType === 'video') {
      viewport.innerHTML = `
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-white/10">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Cinematic Walkthrough</span>
              <h3 class="text-xl sm:text-2xl font-extrabold text-white mt-1">${currentSection.title}</h3>
            </div>
            <span class="text-xs font-mono text-slate-400 bg-white/5 px-2.5 py-1 rounded border border-white/10 shrink-0">1280x720 HD Authentic Session</span>
          </div>

          <div class="relative aspect-video w-full rounded-2xl overflow-hidden bg-slate-950 border border-white/15 shadow-2xl">
            <video
              class="w-full h-full object-cover object-top"
              controls
              autoplay
              muted
              playsinline
              preload="auto"
              poster="${activeVenture.previewImage}"
            >
              <source src="${activeVenture.videoWalkthrough}" type="video/mp4" />
              <source src="${activeVenture.videoWebm}" type="video/webm" />
              Your browser does not support HTML5 video walkthroughs.
            </video>
          </div>

          <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-3">
            <p class="text-sm text-slate-300 leading-relaxed font-normal">${currentSection.lead}</p>
            <ul class="space-y-2 pt-2 border-t border-white/10">
              ${currentSection.highlights.map((h: string) => `
                <li class="flex items-start gap-2.5 text-xs text-slate-300">
                  <span class="inline-block w-1.5 h-1.5 rounded-full ${activeVenture.theme.dotColor} mt-1.5 shrink-0"></span>
                  <span class="leading-relaxed">${h}</span>
                </li>
              `).join('')}
            </ul>
          </div>
        </div>
      `;
    } else {
      viewport.innerHTML = `
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-white/10">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Interactive Architecture</span>
              <h3 class="text-xl sm:text-2xl font-extrabold text-white mt-1">${currentSection.title}</h3>
            </div>
            <a
              href="${activeVenture.url}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold ${activeVenture.theme.accentText} hover:underline"
            >
              <span>Explore on ${activeVenture.url.replace('https://', '')}</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
            </a>
          </div>

          <div class="relative aspect-video w-full rounded-2xl overflow-hidden bg-slate-950 border border-white/15 shadow-2xl">
            <img
              src="${currentSection.mediaSrc}"
              alt="${currentSection.mediaAlt || currentSection.title}"
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent pointer-events-none"></div>
          </div>

          <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-3">
            <p class="text-sm text-slate-300 leading-relaxed font-normal">${currentSection.lead}</p>
            <ul class="space-y-2 pt-2 border-t border-white/10">
              ${currentSection.highlights.map((h: string) => `
                <li class="flex items-start gap-2.5 text-xs text-slate-300">
                  <span class="inline-block w-1.5 h-1.5 rounded-full ${activeVenture.theme.dotColor} mt-1.5 shrink-0"></span>
                  <span class="leading-relaxed">${h}</span>
                </li>
              `).join('')}
            </ul>
          </div>
        </div>
      `;
    }
  }

  function openMiniBrowser(ventureId: string, originCard: HTMLElement | null) {
    if (isAnimating || !modal || !windowEl) return;
    const venture = venturesData.find((v: any) => v.id === ventureId);
    if (!venture) return;

    activeVenture = venture;
    isAnimating = true;

    // Pause all background homepage videos
    projectVideos.forEach((v) => v.pause());

    // Update Browser Chrome Details
    if (urlText) urlText.textContent = venture.url;
    if (externalLink) {
      externalLink.href = venture.url;
      externalLink.setAttribute('aria-label', `Open official production website for ${venture.name}`);
    }
    if (footerEntity) footerEntity.textContent = `Operating under ${venture.ventureEntity}`;
    if (footerCta) {
      footerCta.href = venture.url;
      footerCta.querySelector('span')!.textContent = `Visit ${venture.name} Portal`;
    }

    // Populate Dynamic Section Tabs
    if (tabsContainer) {
      tabsContainer.innerHTML = venture.sections.map((s: any, idx: number) => `
        <button
          type="button"
          role="tab"
          class="mini-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all border ${idx === 0 ? venture.theme.badgeBg : 'border-transparent text-slate-400 hover:text-white hover:bg-white/5'}"
          data-section-id="${s.id}"
          aria-selected="${idx === 0 ? 'true' : 'false'}"
        >
          ${s.label}
        </button>
      `).join('');

      tabsContainer.querySelectorAll<HTMLButtonElement>('.mini-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sid = btn.getAttribute('data-section-id');
          if (sid) renderSection(sid);
        });
      });
    }

    // Render initial section
    renderSection(venture.sections[0]?.id || 'overview');

    // Lock background scroll while keeping position
    scrollPos = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollPos}px`;
    document.body.style.width = '100%';
    document.body.style.overflow = 'hidden';

    // Spatial FLIP Transition Calculation
    if (originCard && !prefersReduced) {
      const firstRect = originCard.getBoundingClientRect();
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'false');

      // Final coordinates
      const lastRect = windowEl.getBoundingClientRect();
      const deltaX = (firstRect.left + firstRect.width / 2) - (lastRect.left + lastRect.width / 2);
      const deltaY = (firstRect.top + firstRect.height / 2) - (lastRect.top + lastRect.height / 2);
      const scaleX = Math.max(0.2, firstRect.width / lastRect.width);
      const scaleY = Math.max(0.2, firstRect.height / lastRect.height);

      // Invert: position window at the card's exact dimensions
      windowEl.style.transition = 'none';
      windowEl.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(${scaleX}, ${scaleY})`;
      windowEl.style.opacity = '0.5';

      // Force layout repaint
      windowEl.offsetHeight;

      // Play: smoothly expand outward with refined cubic bezier
      windowEl.style.transition = 'transform 380ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease-out';
      windowEl.style.transform = 'translate(0px, 0px) scale(1, 1)';
      windowEl.style.opacity = '1';

      setTimeout(() => {
        isAnimating = false;
        closeBtn?.focus();
      }, 400);
    } else {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'false');
      windowEl.style.transform = 'none';
      windowEl.style.opacity = '1';
      isAnimating = false;
      closeBtn?.focus();
    }
  }

  function closeMiniBrowser() {
    if (isAnimating || !modal || !windowEl) return;
    isAnimating = true;

    // Pause any active media inside viewport
    const activeVideo = viewport?.querySelector<HTMLVideoElement>('video');
    if (activeVideo) activeVideo.pause();

    const originCard = lastActiveTrigger ? lastActiveTrigger.closest<HTMLElement>('.project-showcase-card') : null;

    if (originCard && !prefersReduced) {
      const firstRect = windowEl.getBoundingClientRect();
      const lastRect = originCard.getBoundingClientRect();
      const deltaX = (lastRect.left + lastRect.width / 2) - (firstRect.left + firstRect.width / 2);
      const deltaY = (lastRect.top + lastRect.height / 2) - (firstRect.top + firstRect.height / 2);
      const scaleX = Math.max(0.2, lastRect.width / firstRect.width);
      const scaleY = Math.max(0.2, lastRect.height / firstRect.height);

      // Animate back into card
      windowEl.style.transition = 'transform 320ms cubic-bezier(0.16, 1, 0.3, 1), opacity 280ms ease-in';
      windowEl.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(${scaleX}, ${scaleY})`;
      windowEl.style.opacity = '0';
      modal.style.transition = 'opacity 300ms ease-in';
      modal.classList.add('opacity-0');

      setTimeout(() => {
        modal.classList.add('pointer-events-none');
        modal.setAttribute('aria-hidden', 'true');
        modal.style.transition = '';
        windowEl.style.transition = '';
        windowEl.style.transform = '';

        // Unlock scroll
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, scrollPos);

        isAnimating = false;
        activeVenture = null;
        if (lastActiveTrigger) {
          lastActiveTrigger.focus();
        }
      }, 330);
    } else {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, scrollPos);
      isAnimating = false;
      activeVenture = null;
      if (lastActiveTrigger) {
        lastActiveTrigger.focus();
      }
    }
  }

  // Open listeners
  openButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const vid = btn.getAttribute('data-open-venture');
      if (vid) {
        lastActiveTrigger = btn;
        openMiniBrowser(vid, btn.closest<HTMLElement>('.project-showcase-card'));
      }
    });
  });

  // Close listeners
  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMiniBrowser();
  });

  escBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMiniBrowser();
  });

  // Click on background backdrop to dismiss
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeMiniBrowser();
    }
  });

  // Keyboard accessibility: Escape to dismiss & focus trap
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
      e.preventDefault();
      closeMiniBrowser();
    }
  });
</script>
