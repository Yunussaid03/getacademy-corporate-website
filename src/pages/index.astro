---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CourseCard from '@/components/ui/CourseCard.astro';
import coursesData from '@/data/courses.json';
import { 
  ArrowRight, 
  ShieldCheck, 
  Building2, 
  Award, 
  TrendingUp, 
  CheckCircle, 
  Target,
  Sparkles,
  Layers,
  GraduationCap,
  CheckCircle2,
  Clock,
  Phone,
  Mail,
  MapPin,
  ExternalLink
} from 'lucide-astro';

// Take first 6 verified courses for featured carousel/grid
const featuredCourses = coursesData.slice(0, 6);

const capabilities = [
  {
    icon: Award,
    title: 'Leadership & Transformation',
    description: 'Strategic leadership development, change management, supervisory excellence, and executive decision-making designed for managers, supervisors, and rising leaders.',
    href: '/courses?category=leadership-management'
  },
  {
    icon: TrendingUp,
    title: 'Workplace Performance & Skills',
    description: 'Essential workplace competencies including problem solving, professional communications, team synergy, and operational performance enhancement.',
    href: '/courses?category=workplace-performance'
  },
  {
    icon: ShieldCheck,
    title: 'Industry Certification Prep',
    description: 'Structured curricula aligned to globally recognized certification frameworks to validate specialized professional and technical competencies.',
    href: '/courses'
  },
  {
    icon: Building2,
    title: 'Customized In-House Modules',
    description: 'Bespoke corporate learning programs co-designed to target organizational skill gaps, compliance mandates, and operational milestones.',
    href: '/corporate-solutions'
  }
];

const pillars = [
  {
    title: 'Decade of Experience (Since 2012)',
    desc: 'Serving Malaysian corporate, governmental, and institutional clients since 2012 with proven capability interventions.'
  },
  {
    title: 'Proven Blended Learning',
    desc: 'Combining interactive physical workshops, digital modules, and milestone-based execution for maximum knowledge retention.'
  },
  {
    title: 'Global Certification Alignment',
    desc: 'Curricula structured in accordance with globally recognized certification benchmarks including CompTIA and international standards.'
  },
  {
    title: 'Measurable Business ROI',
    desc: 'Focusing on immediate on-the-job application, verified skill transfer, and demonstrative business productivity growth.'
  }
];

const clientLogos = [
  { name: 'Ministry of Education', file: 'Ministry-of-Education.png' },
  { name: 'MOSTI', file: 'mosti.png' },
  { name: 'Dewan Bandaraya Kuala Lumpur', file: 'Kuala-Lumpur.png' },
  { name: 'SEGi University', file: 'SEGI.png' },
  { name: 'Kings College', file: 'Kings-College.png' },
  { name: 'Malaysia Airlines', file: 'malaysia-airlines.png' },
  { name: 'Shopee', file: 'shopee.png' },
  { name: 'Lazada', file: 'lazada.png' },
  { name: 'HP', file: 'hp.png' },
  { name: 'IBM', file: 'IBM.png' },
  { name: 'Digi', file: 'digi.png' },
  { name: 'Atos', file: 'ATOS.png' }
];

const certLogos = [
  { name: 'HRD Corp Registered', file: 'HRDF.png' },
  { name: 'CompTIA Authorized', file: 'CompTIA.png' },
  { name: 'Microsoft Partner', file: 'Microsoft.png' },
  { name: 'PMI Global Partner', file: 'PMI.png' },
  { name: 'ASQ', file: 'ASQ.png' },
  { name: 'Axelos', file: 'axelos-vector-logo.png' }
];
---

<BaseLayout 
  title="Your Unbeatable Human Capital Development Partner"
  description="GET Academy delivers cutting-edge blended learning solutions to the industry. Customized, high-impact capability programs for corporations, businesses, and educational institutions."
>
  <!-- Hero Section with Authentic Photographic Atmosphere -->
  <section class="relative bg-brand-dark text-white overflow-hidden py-16 sm:py-24 lg:py-28 border-b border-brand-sage/40">
    <!-- Subtle Background Pattern & Ambient Glow -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FADB50_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-brand-sage/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/10 border border-brand-gold/30 text-brand-gold text-xs font-extrabold tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
            <span>GET ACADEMY | HUMAN CAPITAL DEVELOPMENT</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-tight text-white">
            Your Unbeatable <span class="text-brand-gold underline decoration-brand-sage/60 decoration-4 underline-offset-4">Human Capital</span> Development Partner
          </h1>

          <p class="text-base sm:text-lg text-gray-200 leading-relaxed max-w-2xl">
            Offering cutting-edge blended learning solutions to the industry. We not only cater to working professionals but also deliver customized, high-impact capability programs for corporations, businesses, and educational institutions.
          </p>

          <!-- Action Buttons -->
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href="/courses"
              class="inline-flex items-center justify-center px-6 py-3.5 text-base font-bold rounded-lg text-brand-dark bg-brand-gold hover:bg-brand-gold-deep shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5"
            >
              <span>Explore Programs</span>
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="#corporate-contact"
              class="inline-flex items-center justify-center px-6 py-3.5 text-base font-bold rounded-lg text-white bg-transparent border-2 border-white/80 hover:bg-white/10 hover:border-white transition-all"
            >
              Corporate Enquiry
            </a>
          </div>

          <!-- Quick Trust Badges -->
          <div class="pt-6 border-t border-white/10 grid grid-cols-3 gap-4 text-xs">
            <div>
              <span class="block text-xl font-extrabold text-brand-gold">100%</span>
              <span class="text-gray-300">HRDC SBL-Khas Claimable</span>
            </div>
            <div>
              <span class="block text-xl font-extrabold text-brand-gold">Since 2012</span>
              <span class="text-gray-300">Decade of Track Record</span>
            </div>
            <div>
              <span class="block text-xl font-extrabold text-brand-gold">19+</span>
              <span class="text-gray-300">Verified Approved Courses</span>
            </div>
          </div>
        </div>

        <!-- Hero Card with Original Photography and Testimonial -->
        <div class="lg:col-span-5">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/15 group">
            <img 
              src="/assets/photos/hero-training.jpg" 
              alt="GET Academy corporate training participants" 
              class="w-full h-80 sm:h-96 object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/60 to-transparent"></div>
            
            <div class="absolute bottom-0 inset-x-0 p-6 text-white space-y-3">
              <div class="flex items-center gap-2 text-brand-gold">
                <Sparkles class="w-4 h-4" />
                <span class="text-[11px] font-extrabold uppercase tracking-wider">Client Impact Spotlight</span>
              </div>
              <blockquote class="text-sm sm:text-base font-medium italic text-gray-100 leading-snug">
                &ldquo;GET Academy‘s program was absolutely a great transformation with out of the box strategy and impactful implementation.&rdquo;
              </blockquote>
              <div class="pt-2 border-t border-white/20 flex items-center justify-between text-xs">
                <div>
                  <p class="font-bold text-white">Leadership Transformation Program</p>
                  <p class="text-brand-gold text-[11px]">Participant — Ministry of Education</p>
                </div>
                <span class="bg-brand-sage/80 backdrop-blur-sm text-white px-2 py-0.5 rounded text-[10px] font-bold">
                  SBL-Khas
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Training & Course Offerings (Capabilities) -->
  <section class="py-20 bg-white" id="training-offerings">
    <div class="container-custom">
      <SectionHeader 
        eyebrow="OUR TRAINING CATALOGUE"
        title="Training & Course Offerings"
        subtitle="Flexible, outcome-driven learning pathways designed to build in-demand industry competencies through blended, online, and instructor-led delivery formats."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {capabilities.map((cap) => (
          <div class="bg-brand-light rounded-xl p-6 border border-brand-border hover:border-brand-sage/60 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="w-12 h-12 rounded-lg bg-white border border-brand-border flex items-center justify-center text-brand-sage group-hover:bg-brand-sage group-hover:text-white transition-colors mb-5 shadow-sm">
                <cap.icon class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-brand-dark mb-2.5 group-hover:text-brand-sage transition-colors">
                {cap.title}
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed mb-6">
                {cap.description}
              </p>
            </div>
            <a
              href={cap.href}
              class="inline-flex items-center text-xs font-bold text-brand-sage group-hover:text-brand-sage-dark hover:underline"
            >
              <span>View Courses &rarr;</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Business & Enterprise Capability (Corporate Solutions Feature) -->
  <section class="py-20 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage">BUSINESS & ENTERPRISE CAPABILITY</p>
          <h2 class="text-3xl font-extrabold text-brand-dark tracking-tight">Corporate Training & Business Solutions</h2>
          <p class="text-base text-brand-muted leading-relaxed">
            We partner with corporate HR directors, department heads, and government bodies to transform employee capability, streamline cross-functional collaboration, and optimize training budgets through HRD Corp levy utilization.
          </p>
          
          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-4 p-4 bg-white rounded-xl border border-brand-border shadow-sm">
              <span class="w-8 h-8 rounded-lg bg-brand-light text-brand-sage font-bold font-mono flex items-center justify-center shrink-0 border border-brand-border">1</span>
              <div>
                <h4 class="font-bold text-brand-dark text-sm mb-1">Custom Training Needs Diagnostic</h4>
                <p class="text-xs text-brand-muted">Assessing departmental skill gaps before designing syllabus outlines.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 bg-white rounded-xl border border-brand-border shadow-sm">
              <span class="w-8 h-8 rounded-lg bg-brand-light text-brand-sage font-bold font-mono flex items-center justify-center shrink-0 border border-brand-border">2</span>
              <div>
                <h4 class="font-bold text-brand-dark text-sm mb-1">Flexible Blended Delivery</h4>
                <p class="text-xs text-brand-muted">On-site corporate workshops, blended digital modules, or On-the-Job Training (OJT).</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 bg-white rounded-xl border border-brand-border shadow-sm">
              <span class="w-8 h-8 rounded-lg bg-brand-light text-brand-sage font-bold font-mono flex items-center justify-center shrink-0 border border-brand-border">3</span>
              <div>
                <h4 class="font-bold text-brand-dark text-sm mb-1">Practical Workplace ROI</h4>
                <p class="text-xs text-brand-muted">Post-training review rubrics to measure verifiable skill transfer and productivity gains.</p>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/corporate-solutions"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-sage text-white font-bold hover:bg-brand-sage-dark transition-all text-sm"
            >
              <span>Explore Corporate Solutions</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-brand-border">
            <img 
              src="/assets/photos/corporate-solutions.jpg" 
              alt="Corporate Training & Business Solutions workshop" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5 text-white">
              <span class="inline-block px-3 py-1 rounded bg-brand-gold text-brand-dark text-xs font-extrabold uppercase mb-2">
                100% HRDC Claimable
              </span>
              <p class="text-sm font-semibold text-gray-100">
                Tailored in-house corporate workshops with full SBL-Khas grant documentation support.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted by Leading Organisations (Client Logos Carousel/Grid) -->
  <section class="py-16 bg-white border-b border-brand-border">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">CLIENT REACH</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark">Trusted by Leading Organisations & Enterprises</h2>
        <p class="text-sm text-brand-muted mt-2">
          From federal ministries and statutory bodies to multinational companies across Malaysia since 2012.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 items-center">
        {clientLogos.map((client) => (
          <div class="p-4 bg-brand-light rounded-xl border border-brand-border flex items-center justify-center h-20 hover:border-brand-sage/60 transition-all hover:bg-white hover:shadow-sm">
            <img 
              src={`/assets/partners/${client.file}`} 
              alt={client.name} 
              class="max-h-12 max-w-[120px] object-contain grayscale hover:grayscale-0 transition-all opacity-80 hover:opacity-100"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 19 HRDC Claimable Training Programs (Featured Grid) -->
  <section class="py-20 bg-brand-light border-b border-brand-border">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">HRD CORP CLAIMABLE COURSES</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">19 HRDC Claimable Training Programs</h2>
          <p class="text-sm sm:text-base text-brand-muted mt-2 max-w-xl">
            Our catalog features 19 targeted training programs structured to address organizational capability gaps in leadership, technology, operations, and management.
          </p>
        </div>
        <div>
          <a
            href="/courses"
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm"
          >
            <span>View All 19 Courses</span>
            <ArrowRight class="w-4 h-4 ml-1.5" />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {featuredCourses.map((course) => (
          <CourseCard {...course} />
        ))}
      </div>
    </div>
  </section>

  <!-- The GET Academy Advantage (Why Choose GET Academy) -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-brand-border">
            <img 
              src="/assets/photos/about-team.jpg" 
              alt="GET Academy corporate faculty in session" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <SectionHeader 
            eyebrow="THE GET ACADEMY ADVANTAGE"
            title="Why Choose GET Academy"
            subtitle="Engineered for measurable talent transformation through actionable tools and practitioner-led instruction."
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {pillars.map((pillar, idx) => (
              <div class="p-5 bg-brand-light rounded-xl border border-brand-border hover:border-brand-sage/60 transition-all">
                <span class="text-brand-sage font-extrabold font-mono text-xl block mb-2">0{idx + 1}</span>
                <h4 class="font-bold text-brand-dark text-base mb-1.5">{pillar.title}</h4>
                <p class="text-xs text-brand-muted leading-relaxed">{pillar.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Aligned with International Certification Standards -->
  <section class="py-16 bg-brand-canvas border-y border-brand-border">
    <div class="container-custom text-center">
      <div class="max-w-3xl mx-auto mb-10">
        <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">GLOBAL BENCHMARKS</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark">Aligned with International Certification Standards</h2>
        <p class="text-sm text-brand-muted mt-2">
          Curriculum pathways structured in accordance with globally recognized benchmarks.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {certLogos.map((cert) => (
          <div class="p-4 bg-white rounded-xl border border-brand-border h-20 w-36 sm:w-44 flex items-center justify-center shadow-sm hover:shadow-md transition-shadow">
            <img 
              src={`/assets/partners/${cert.file}`} 
              alt={cert.name} 
              class="max-h-12 max-w-[120px] object-contain"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- CompTIA official strip -->
      <div class="mt-10 max-w-3xl mx-auto p-4 bg-white rounded-xl border border-brand-border shadow-sm flex items-center justify-center">
        <img 
          src="/assets/brand/comptia-cert-strip.png" 
          alt="CompTIA Certification Pathways" 
          class="max-h-12 w-auto object-contain"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Sectors We Serve -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <SectionHeader 
        eyebrow="SECTORS WE SERVE"
        title="Training for Businesses, Organisations & Institutions"
        subtitle="Addressing unique sector mandates through flexible delivery models and verified governance standards."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="p-7 bg-brand-light rounded-xl border border-brand-border flex flex-col justify-between">
          <div>
            <Building2 class="w-8 h-8 text-brand-sage mb-4" />
            <h3 class="text-lg font-bold text-brand-dark mb-2">Corporations & Enterprises</h3>
            <p class="text-sm text-brand-muted leading-relaxed">Cross-functional managerial upskilling, leadership transformation, digital strategy, and team synergy programs.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-brand-border/60 text-xs font-bold text-brand-sage">
            SBL-Khas Claimable &rarr;
          </div>
        </div>

        <div class="p-7 bg-brand-light rounded-xl border border-brand-border flex flex-col justify-between">
          <div>
            <ShieldCheck class="w-8 h-8 text-brand-sage mb-4" />
            <h3 class="text-lg font-bold text-brand-dark mb-2">Government & Statutory Bodies</h3>
            <p class="text-sm text-brand-muted leading-relaxed">Public sector capability building, institutional governance, ethical leadership, and digital literacy interventions.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-brand-border/60 text-xs font-bold text-brand-sage">
            Governance Aligned &rarr;
          </div>
        </div>

        <div class="p-7 bg-brand-light rounded-xl border border-brand-border flex flex-col justify-between">
          <div>
            <GraduationCap class="w-8 h-8 text-brand-sage mb-4" />
            <h3 class="text-lg font-bold text-brand-dark mb-2">Schools, Colleges & Universities</h3>
            <p class="text-sm text-brand-muted leading-relaxed">Faculty development, modern instructional methodologies, student employability bootcamps, and certification alignment.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-brand-border/60 text-xs font-bold text-brand-sage">
            Academic Partnerships &rarr;
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Start Your Training Transformation (Contact Section on Homepage) -->
  <section class="py-20 bg-brand-dark text-white" id="corporate-contact">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-extrabold uppercase tracking-widest text-brand-gold">START YOUR TRAINING TRANSFORMATION</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Get in Touch with Our Training Team</h2>
          <p class="text-gray-200 text-base leading-relaxed">
            Our training consultants are ready to assist you with tailored corporate proposals, schedule availability, and HRDC grant documentation within 1–2 business days.
          </p>

          <div class="p-6 bg-white/5 rounded-xl border border-white/10 space-y-4 text-sm text-gray-300">
            <h4 class="text-brand-gold font-bold uppercase tracking-wider text-xs">Official Contact Channels</h4>
            <div class="flex items-start gap-3">
              <MapPin class="w-4 h-4 text-brand-gold shrink-0 mt-1" />
              <div>
                <span class="block font-bold text-white text-xs uppercase">Registered Office Address</span>
                <span class="text-xs text-amber-300/80 italic">[Official GET Academy Registered Office Address awaiting sign-off]</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <Mail class="w-4 h-4 text-brand-gold shrink-0" />
              <div>
                <span class="block font-bold text-white text-xs uppercase">Enquiry Email</span>
                <span class="text-xs text-amber-300/80 italic">[Official GET Academy Enquiry Email awaiting sign-off]</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <Phone class="w-4 h-4 text-brand-gold shrink-0" />
              <div>
                <span class="block font-bold text-white text-xs uppercase">Office Telephone</span>
                <span class="text-xs text-amber-300/80 italic">[Official GET Academy Contact Telephone awaiting sign-off]</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 bg-brand-sage/40 backdrop-blur-md p-8 rounded-2xl border border-brand-sage/60 space-y-5">
          <h3 class="text-xl font-bold text-brand-gold">Request a Custom Training Proposal</h3>
          <p class="text-sm text-gray-200 leading-relaxed">
            Whether you require an in-house corporate workshop, an institutional capability package, or advice on HRDC claim eligibility, our team delivers custom proposals within 1–2 business days.
          </p>
          <div class="pt-2">
            <a
              href="/contact"
              class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-lg bg-brand-gold text-brand-dark font-bold hover:bg-brand-gold-deep transition-all text-sm shadow-md"
            >
              <span>Submit Formal Corporate Enquiry</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
