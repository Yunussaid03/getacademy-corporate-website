---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import CompTIAPanel from '@/components/ui/CompTIAPanel.astro';
import {
  Award,
  BadgeCheck,
  CheckCircle2,
  Cpu,
  Globe2,
  ShieldCheck,
  ArrowRight,
  Users2,
} from 'lucide-astro';
import { accreditations, verificationNote } from '@/data/accreditations';
import { site } from '@/data/site';

// 4 Core Capability Pillars (company profile, slide 2)
const capabilityPillars = [
  {
    number: '01',
    icon: Cpu,
    title: 'Artificial Intelligence Capacity Building',
    tagline: 'Workforce & Institutional AI Literacy',
    summary: 'Empowering enterprise workforces, educators, and public sector cohorts to understand, adopt, and integrate applied AI tools safely and productively into daily operations.',
    image: '/assets/photos/ai-educator-training.jpeg',
    imageAlt: 'Applied Artificial Intelligence capability building and workforce skilling session',
    keyFocus: [
      'Generative AI for Workplace Productivity',
      'Institutional AI Literacy & Readiness',
      'AI-Powered Education Transformation'
    ]
  },
  {
    number: '02',
    icon: Globe2,
    title: 'Entrepreneurship – Cross Border Business',
    tagline: 'Enterprise Incubation & Market Pathways',
    summary: 'Guiding small business owners, corporate spin-offs, and entrepreneurs with practical digitalization roadmaps, international market exploration, and commercial strategies.',
    image: '/assets/photos/cross-border-select-usa.jpeg',
    imageAlt: 'Entrepreneurship incubation and cross-border commercial strategy session',
    keyFocus: [
      'Certified Digital Marketing Strategies (CDMS)',
      'Business Incubation: Done For You (DFY)',
      'Cross-Border Market Entry & Trade Missions'
    ]
  },
  {
    number: '03',
    icon: ShieldCheck,
    title: 'Global IT Certification',
    tagline: 'Industry-Standard Credentials',
    summary: 'Structured learning pathways aligned with internationally recognized bodies, equipping non-IT and technical personnel with validated cybersecurity and digital skills.',
    isBrandGraphic: true,
    imageAlt: 'CompTIA international IT certification pathways',
    keyFocus: [
      'Seven CompTIA Certification Pathways',
      'IT for Non-IT People & Cybersecurity',
      'International Certification'
    ]
  },
  {
    number: '04',
    icon: Award,
    title: 'Professional Development',
    tagline: 'Managerial & Operational Excellence',
    summary: 'Developing critical workplace competencies across managerial leadership, root-cause problem solving, design thinking, and customer experience management.',
    image: '/assets/photos/welcome-classroom-session.jpeg',
    imageAlt: 'Interactive classroom workshop session on managerial capabilities and team leadership',
    keyFocus: [
      'Customer Experience Management (CEM)',
      'Design Thinking & Problem Solving',
      'Leadership, Sales & Event Management'
    ]
  }
];

// Delivery formats (company profile, slides 5 and 6)
const deliveryFormats = [
  {
    title: 'Hands-On Workshops',
    description: 'On-site intensive sessions held at client premises or dedicated seminar venues, built around practice and live feedback.',
    tag: 'Interactive & Experiential'
  },
  {
    title: 'Online Workshops',
    description: 'Facilitator-led live virtual workshops that accommodate your team’s preferences and schedules, including distributed teams and cross-state cohorts.',
    tag: 'Flexible Virtual Classrooms'
  },
  {
    title: 'Immersion Programmes',
    description: 'Overseas immersion that connects local business cohorts with global trade and tech ecosystems, such as the 2024 US – New York Immersion Programme.',
    tag: 'Global Market Exposure',
    href: '/international#new-york'
  }
];

// Core accreditations shown on this page (full list on the homepage)
const coreAccreditations = accreditations.slice(0, 6);

// Leadership profile: facts from the company profile (slides 13, 22–24, 28, 41–46)
const leadershipFacts = [
  'Co-founder and Chief Operating Officer of GET Academy',
  'Member of the Digitalization Committee of the Malaysia Productivity Corporation (MPC)',
  'Mentor in the business incubation programme organised by the Government of India (AIC RAISE)',
  'Represented Malaysia at the UNESCO Entrepreneurship Education Network (EE-Net) in Uzbekistan',
  'Met the Consul General of Malaysia in New York to open a path for Malaysian entrepreneurs into the US market',
  'Lead facilitator of our Digital Marketing and ITIL Foundation programmes'
];
---

<BaseLayout
  title="About Us — Corporate Profile & Human Capital Development Partner"
  description="Learn about GET Academy (Global Experiential Training Academy PLT), our 4 core capability pillars, leadership, accreditations and corporate mission across Malaysia."
>
  <PageHero
    eyebrow="About GET Academy"
    title="Your Unbeatable Human Capital Development Partner"
    description="Global Experiential Training Academy PLT (GET Academy) is a skills training academy delivering practitioner-led capacity building, global certification pathways, and customized talent development for enterprises, public sector bodies, and educational institutions."
  />

  <!-- Section 1 — Who We Are: Mission & Approach -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Visual Column -->
        <div class="lg:col-span-5 order-2 lg:order-1">
          <div class="rounded-2xl overflow-hidden shadow-lg border border-brand-border bg-slate-100 relative group">
            <img
              src="/assets/photos/about-team.jpg"
              alt="GET Academy corporate capability session and practitioner facilitation"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-[11px] font-bold text-brand-gold uppercase tracking-wider block mb-1">
                Practitioner-Led Instruction
              </span>
              <p class="text-xs text-slate-200 leading-snug">
                Combining interactive workshop dynamics with actionable diagnostic tools for immediate workplace execution.
              </p>
            </div>
          </div>
        </div>

        <!-- Copy Column -->
        <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
          <div class="space-y-3">
            <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage">Corporate Profile & Mission</p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight leading-snug">
              Bridging Strategic Capability Gaps Through Applied Learning
            </h2>
            <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
              In a rapidly evolving economic landscape driven by artificial intelligence, digital disruption, and changing market demands, standard theoretical training rarely produces sustained operational transformation.
            </p>
            <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
              GET Academy works collaboratively with organizations to diagnose competency requirements, formulate tailored training roadmaps, and deliver hands-on, outcome-driven programs that equip workforces to perform with confidence and measurable efficiency.
            </p>
          </div>

          <!-- Quick Fact Pillars -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-brand-light border border-brand-border">
              <span class="text-xs font-bold text-brand-sage uppercase block mb-1">Registered Entity</span>
              <p class="text-xs text-brand-dark font-semibold">GET Academy PLT</p>
              <span class="text-[10px] text-brand-muted block mt-0.5">{site.llpNumber}</span>
            </div>
            <div class="p-4 rounded-xl bg-brand-light border border-brand-border">
              <span class="text-xs font-bold text-brand-sage uppercase block mb-1">HQ Location</span>
              <p class="text-xs text-brand-dark font-semibold">Kuala Lumpur</p>
              <span class="text-[10px] text-brand-muted block mt-0.5">Level 33, Ilham Tower</span>
            </div>
            <div class="p-4 rounded-xl bg-brand-light border border-brand-border">
              <span class="text-xs font-bold text-brand-sage uppercase block mb-1">Focus Sectors</span>
              <p class="text-xs text-brand-dark font-semibold">Enterprise & Public</p>
              <span class="text-[10px] text-brand-muted block mt-0.5">Government & Education</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 — The 4 Core Capability Pillars -->
  <section class="py-20 bg-brand-light border-y border-brand-border" id="pillars">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Core Training Specializations</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">
          Our Four Capability Pillars
        </h2>
        <p class="text-sm sm:text-base text-brand-muted mt-3 leading-relaxed">
          GET Academy’s curriculum and capability advisory are structured across four core pillars, designed to provide comprehensive workforce readiness from foundational skills to executive transformation.
        </p>
      </div>

      <!-- 4 Pillars Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {capabilityPillars.map((pillar) => (
          <div class="bg-white rounded-2xl border border-brand-border shadow-sm hover:border-brand-sage/60 hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col justify-between group">
            <div>
              <!-- Prominent Image Header -->
              <div class="relative h-52 sm:h-56 w-full bg-slate-100 overflow-hidden flex items-center justify-center">
                {pillar.isBrandGraphic ? (
                  <CompTIAPanel />
                ) : (
                  <>
                    <img
                      src={pillar.image}
                      alt={pillar.imageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
                  </>
                )}

                <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-mono font-extrabold bg-brand-dark/90 text-brand-gold border border-brand-gold/30 shadow-xs backdrop-blur-sm">
                  {pillar.number}
                </span>
                <span class="absolute bottom-3 left-3 px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-white/95 text-brand-dark shadow-xs backdrop-blur-sm">
                  {pillar.tagline}
                </span>
              </div>

              <!-- Body Copy -->
              <div class="p-6 sm:p-7 space-y-3">
                <h3 class="text-lg sm:text-xl font-bold text-brand-dark leading-snug group-hover:text-brand-sage transition-colors">
                  {pillar.title}
                </h3>
                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                  {pillar.summary}
                </p>
              </div>
            </div>

            <!-- Bullet Focus Points -->
            <div class="px-6 pb-6 sm:px-7 sm:pb-7 pt-3 border-t border-brand-border/60">
              <span class="text-[11px] font-bold uppercase tracking-wider text-brand-sage block mb-2">Key Competency Areas:</span>
              <ul class="space-y-1.5">
                {pillar.keyFocus.map((focus) => (
                  <li class="flex items-center gap-2 text-xs text-brand-muted">
                    <CheckCircle2 class="w-3.5 h-3.5 text-emerald-700 shrink-0" />
                    <span>{focus}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/courses" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm">
          <span>Explore Programmes by Pathway</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Section 3 — Training Delivery Formats -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Flexible Implementation</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">
          Trainings We Offer
        </h2>
        <p class="text-sm sm:text-base text-brand-muted mt-2 leading-relaxed">
          Three proven delivery formats, conducted on-site or virtually to suit your team’s schedule.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {deliveryFormats.map((fmt) => (
          <div class="bg-brand-light p-6 rounded-2xl border border-brand-border hover:border-brand-sage/60 hover:shadow-sm transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-sage bg-brand-sage-light px-2.5 py-0.5 rounded inline-block mb-3">
                {fmt.tag}
              </span>
              <h3 class="text-base font-bold text-brand-dark mb-2 leading-snug">
                {fmt.title}
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                {fmt.description}
              </p>
            </div>
            {fmt.href && (
              <a href={fmt.href} class="mt-4 pt-3 border-t border-brand-border/60 inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage hover:text-brand-sage-dark">
                <span>See the New York programme</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4 — Leadership -->
  <section class="py-20 bg-brand-light border-y border-brand-border" id="leadership">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-4 flex flex-col items-center text-center">
          <div class="relative">
            <img
              src="/assets/photos/ganesh-kumar-manokara.jpg"
              alt="Ganesh Kumar Manokara, Co-founder and Chief Operating Officer of GET Academy"
              class="w-56 h-56 sm:w-64 sm:h-64 rounded-full object-cover border-4 border-white shadow-xl ring-4 ring-brand-gold/70"
              width="600"
              height="600"
              loading="lazy"
            />
          </div>
          <h3 class="mt-6 text-2xl font-extrabold text-brand-dark">Ganesh Kumar Manokara</h3>
          <p class="text-sm font-semibold text-brand-sage mt-1">Co-founder & Chief Operating Officer</p>
          <p class="text-xs text-brand-muted mt-1">Lead facilitator, “Coach GK”</p>
        </div>

        <div class="lg:col-span-8 space-y-5">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Leadership</p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight leading-snug">
              Led by a practitioner who teaches
            </h2>
          </div>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
            Ganesh is a C-level strategist with decades of professional experience in entrepreneurship, marketing and the e-commerce ecosystem. He serves as a business transformation consultant and leadership coach, and as a startup mentor he shares go-to-market strategies to catalyse business growth.
          </p>
          <p class="text-xs text-brand-muted italic">Profile adapted from his AIC RAISE mentor profile.</p>

          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            {leadershipFacts.map((fact) => (
              <li class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white border border-brand-border text-xs sm:text-sm text-brand-dark leading-snug">
                <BadgeCheck class="w-4 h-4 text-emerald-700 shrink-0 mt-0.5" aria-hidden="true" />
                <span>{fact}</span>
              </li>
            ))}
          </ul>

          <div class="pt-2 flex flex-wrap gap-3">
            <a href="/testimonials" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm">
              <span>Read What Trainees Say</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="/trainers" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold rounded-lg text-brand-dark bg-white border border-brand-border hover:border-brand-sage/60 transition-colors">
              <Users2 class="w-4 h-4 text-brand-sage" />
              <span>Our Trainers</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5 — Core Accreditations -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Academia | Certification Provider | Government | Industry Experts"
        title="Accreditations & Organizational Affiliations"
        subtitle="Franchise, certification and appointment relationships with academic, government and industry bodies."
        centered={true}
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto mb-10">
        {coreAccreditations.map((aff) => (
          <div class="bg-brand-light p-5 rounded-xl border border-brand-border shadow-xs hover:border-brand-sage/60 transition-all flex flex-col">
            <div class="w-full h-24 rounded-lg bg-white border border-slate-100 p-2.5 flex items-center justify-center mb-4">
              <img
                src={aff.logo}
                alt={aff.name}
                class="max-h-16 max-w-[160px] object-contain"
                loading="lazy"
              />
            </div>
            <span class="self-start px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white text-brand-sage border border-brand-border mb-2">
              {aff.badge}
            </span>
            <h4 class="text-sm font-bold text-brand-dark mb-1 leading-snug">
              {aff.name}
            </h4>
            <p class="text-xs text-brand-muted leading-relaxed">
              {aff.scope}
            </p>
          </div>
        ))}
      </div>

      <div class="max-w-4xl mx-auto bg-brand-sage-light/60 border border-brand-border rounded-2xl p-5 sm:p-6 flex items-start gap-4 text-xs text-brand-dark">
        <div class="w-9 h-9 rounded-xl bg-white text-brand-sage flex items-center justify-center shrink-0 mt-0.5 border border-brand-border">
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div class="space-y-1.5">
          <p class="text-xs font-bold uppercase tracking-wider text-brand-sage">Verification on request</p>
          <p class="text-xs text-brand-muted leading-relaxed">{verificationNote}</p>
          <a href="/#accreditations" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage hover:text-brand-sage-dark pt-1">
            <span>See all accreditations and affiliations</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Engage With Our Advisors"
    title="Ready to Discuss Your Organization’s Training Needs?"
    text="Speak with our corporate capability consultants to formulate a tailored training roadmap aligned with your business priorities and technical benchmarks. All programmes are HRDC claimable."
    primary={{ label: 'Discuss Your Training Needs', href: '/contact' }}
    secondary={{ label: 'Explore Course Directory', href: '/courses' }}
  />
</BaseLayout>
