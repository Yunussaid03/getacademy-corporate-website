---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { 
  Users2, 
  Award, 
  CheckCircle2, 
  ArrowRight, 
  ShieldCheck, 
  Briefcase, 
  FileText,
  HelpCircle,
  Clock
} from 'lucide-astro';

const trainerStandards = [
  {
    title: 'Extensive Industry Experience',
    desc: 'Our facilitators possess real-world sector backgrounds spanning corporate leadership, IT engineering, supply chain, and organizational development, translating theoretical models into actionable tools.'
  },
  {
    title: 'Certified Adult Learning Methodologies',
    desc: 'Trained and accredited in high-engagement facilitation techniques, simulation exercises, and interactive adult education frameworks.'
  },
  {
    title: 'Outcome-Driven Performance Coaching',
    desc: 'Focused on measurable post-training progress, behavioral transfer, and measurable productivity improvements in the participant’s actual work environment.'
  }
];

const faculties = [
  {
    title: 'Leadership & Management Faculty',
    icon: Award,
    description: 'Subject matter practitioners specializing in managerial capability, executive transformation, employee relations, supervisory coaching, and ethics & governance.',
    topics: ['Strategic Leadership', 'Supervisory Coaching', 'Performance Management', 'Change Execution']
  },
  {
    title: 'Workplace Performance & Essential Skills',
    icon: Briefcase,
    description: 'Specialists in high-performing team dynamics, root-cause problem solving, critical thinking, customer experience management, and commercial sales optimization.',
    topics: ['Root-Cause Problem Solving', 'Critical Thinking', 'Customer Experience', 'Cross-Functional Synergy']
  },
  {
    title: 'Technical & Digital Transformation Faculty',
    icon: ShieldCheck,
    description: 'Industry-certified engineers and strategists delivering cutting-edge modules across digital marketing strategy (CDMS), IT operations, and technology adoption.',
    topics: ['Digital Marketing Strategist (CDMS)', 'IT Operations & Infrastructure', 'Digital Workplace Tools']
  }
];
---

<BaseLayout
  title="Our Trainers & Expert Faculty"
  description="Learn about GET Academy's practitioner-led faculty selection standards and specialized corporate training domains across Malaysia."
>
  <!-- Header Banner -->
  <section class="bg-brand-dark text-white py-16 lg:py-20 border-b border-brand-sage/40">
    <div class="container-custom max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-brand-gold text-xs font-bold uppercase tracking-wider mb-4">
        <span>Expert Faculty & Facilitators</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6">
        Our Trainers
      </h1>
      <p class="text-lg text-gray-200 leading-relaxed">
        Industry-experienced practitioners dedicated to delivering practical, measurable, and engaging corporate training programs for Malaysian enterprises.
      </p>
    </div>
  </section>

  <!-- Faculty Standards Overview -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mb-12">
        <SectionHeader
          eyebrow="Facilitation Standards"
          title="Practitioner-Led Training for Real Workplace Results"
          subtitle="GET Academy facilitators are selected for their extensive corporate experience, deep domain knowledge, and certified adult learning methodologies. We believe high-impact training requires practitioners who have navigated real workplace challenges and can guide learners with actionable insights."
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {trainerStandards.map((std, idx) => (
          <div class="p-7 rounded-xl bg-brand-light border border-brand-border flex flex-col justify-between">
            <div>
              <span class="text-2xl font-mono font-extrabold text-brand-sage block mb-4">0{idx + 1}</span>
              <h3 class="text-lg font-bold text-brand-dark mb-2.5">{std.title}</h3>
              <p class="text-sm text-brand-muted leading-relaxed">{std.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Faculty Domains -->
  <section class="py-20 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Domain Expertise"
        title="Trainer Faculty by Capability Area"
        subtitle="Our training network comprises certified trainers and subject matter experts across key corporate development domains."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {faculties.map((fac) => (
          <div class="bg-white p-8 rounded-xl border border-brand-border shadow-sm flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-lg bg-brand-light text-brand-sage flex items-center justify-center mb-5 border border-brand-border">
                <fac.icon class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-brand-dark mb-3 leading-snug">{fac.title}</h3>
              <p class="text-sm text-brand-muted leading-relaxed mb-6">{fac.description}</p>
              
              <div class="space-y-2 border-t border-brand-border/60 pt-4">
                <span class="text-xs font-bold text-brand-sage uppercase tracking-wider block">Key Focus Areas:</span>
                <ul class="text-xs text-brand-dark space-y-1.5 font-medium">
                  {fac.topics.map((t) => (
                    <li class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-brand-gold shrink-0"></span>
                      <span>{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-brand-border/60">
              <a
                href="/contact"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage hover:underline"
              >
                <span>Request Detailed Trainer CV</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clear Verification Notice: Individual Trainer Biographies -->
  <section class="py-14 bg-white">
    <div class="container-custom max-w-4xl">
      <div class="bg-amber-50/70 border border-amber-200/80 rounded-xl p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <Clock class="w-6 h-6 text-amber-800 shrink-0 mt-0.5" />
          <div class="space-y-2">
            <h3 class="text-base font-bold text-amber-950 uppercase tracking-wide">
              Individual Trainer Biographies & Credentials
            </h3>
            <p class="text-sm text-amber-900 leading-relaxed">
              In accordance with our strict data protection and corporate verification policy, complete trainer credentials, HRD Corp TTT (Train-the-Trainer) certification numbers, and bespoke facilitation profiles are matched and provided directly to client HR teams upon proposal request.
            </p>
            <p class="text-xs text-amber-800 font-medium pt-1">
              * To review certified trainer CVs for your organization’s scheduled dates, please contact our training advisory desk.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 bg-brand-dark text-white text-center">
    <div class="container-custom max-w-3xl space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Need a Specific Trainer Profile for an Upcoming Intake?</h2>
      <p class="text-gray-200 text-sm max-w-xl mx-auto leading-relaxed">
        Let us match your exact departmental competency requirements with accredited senior facilitators from our nationwide network.
      </p>
      <div class="pt-2">
        <a href="/contact" class="px-6 py-3 rounded-lg font-bold bg-brand-gold text-brand-dark hover:bg-brand-gold-deep transition-all text-sm inline-block">
          Request Faculty Profiles
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
