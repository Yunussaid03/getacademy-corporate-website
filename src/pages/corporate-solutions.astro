---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import {
  Building2,
  CheckCircle2,
  ArrowRight,
  ShieldCheck,
  GraduationCap
} from 'lucide-astro';
import { projects } from '@/data/track-record';

// Company profile slide 6 (“Why Partner With Us?”) and the Ministry of Education gap-analysis project (slides 18, 26)
const enterpriseAdvantages = [
  {
    title: 'Pre-Training Diagnostic',
    desc: 'Assessing departmental skill gaps and specific manager requirements before finalizing syllabus outlines, the same gap-analysis approach we applied for the Ministry of Education.'
  },
  {
    title: 'Flexible Delivery',
    desc: 'Training sessions conducted on-site or virtually, accommodating your team’s preferences and schedules.'
  },
  {
    title: 'HRDC Claimable Programmes',
    desc: 'All GET Academy programmes are HRDC claimable. We prepare the proposal documents eligible employers need for their HRD Corp application.'
  },
  {
    title: 'Tangible, Measurable Results',
    desc: 'Programmes designed to boost productivity, efficiency and employee satisfaction, so the impact shows up in daily operations.'
  }
];

const solutionsBySector = [
  {
    sector: 'Enterprises & Multinational Corporations',
    icon: Building2,
    focus: 'Leadership and team-building programmes, digital marketing strategy (CDMS), customer experience management and professional development, customised to your goals and objectives.'
  },
  {
    sector: 'Government Bodies & Statutory Authorities',
    icon: ShieldCheck,
    focus: 'Organisational and leadership transformation, AI capability building and digital transformation support, as delivered for the Ministry of Education, MOHE, MPC and MDEC.'
  },
  {
    sector: 'Colleges & Higher Learning Institutions',
    icon: GraduationCap,
    focus: 'Educator AI capability building, first-time employment readiness for graduating cohorts, and industry-academia programmes with SEGi, TalentCorp and local universities.'
  }
];

const roadmapSteps = [
  {
    number: 'Phase 1',
    title: 'Consultation & Discovery',
    desc: 'Our enterprise consultants meet with HR leadership to map target competencies against corporate milestones.'
  },
  {
    number: 'Phase 2',
    title: 'Custom Curriculum Formulation',
    desc: 'Bespoke course modules, industry case studies, and practical exercises are prepared alongside the proposal documents for your HRD Corp application.'
  },
  {
    number: 'Phase 3',
    title: 'Deployment & Follow-Through',
    desc: 'Industry-expert facilitators deliver the programme on-site or virtually, followed by post-training feedback and support with your HRD Corp claim.'
  }
];

// Public-sector and institutional proof points
const proofIds = ['mohe-cdo-briefing', 'moe-transformation', 'jpn-ipg-tech-dome'];
const proofProjects = proofIds
  .map((id) => projects.find((project) => project.id === id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
---

<BaseLayout
  title="Corporate Solutions & B2B Capability Interventions"
  description="Customized corporate training interventions and workforce capability diagnostics for enterprises, government agencies and education institutions. All programmes are HRDC claimable."
>
  <PageHero
    eyebrow="Enterprise & B2B Capability"
    title="Corporate Solutions"
    description="Customized corporate training interventions and workforce capability diagnostics engineered for real business impact across Malaysia, delivered on-site or virtually."
  />

  <!-- Problem / Solution Overview -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <SectionHeader
            eyebrow="Tailored B2B Programmes"
            title="Workforce Training Engineered for Real Business Impact"
            subtitle="Modern enterprises face rapid operational shifts, digital disruption, and rising governance standards. Off-the-shelf courses rarely address the specific friction points of individual departments."
          />
          <p class="text-brand-muted leading-relaxed text-base">
            GET Academy tailors programmes to align with your company’s unique goals and objectives. We partner with corporate HR directors, department heads, and government bodies to transform employee capability and streamline cross-functional collaboration, with every programme HRDC claimable.
          </p>
          <div class="pt-2">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-brand-sage text-white font-bold hover:bg-brand-sage-dark transition-all text-sm shadow-sm"
            >
              <span>Schedule an Enterprise Discovery Call</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          {enterpriseAdvantages.map((item) => (
            <div class="p-5 rounded-xl bg-brand-light border border-brand-border flex items-start gap-4 hover:border-brand-sage/60 transition-colors">
              <CheckCircle2 class="w-5 h-5 text-brand-sage shrink-0 mt-0.5" />
              <div>
                <h4 class="font-bold text-brand-dark text-sm mb-1">{item.title}</h4>
                <p class="text-xs text-brand-muted leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions by Sector -->
  <section class="py-20 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Sectors Served"
        title="Tailored Interventions for Diverse Organizational Models"
        subtitle="Addressing unique sector mandates through flexible delivery models and proven project experience."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {solutionsBySector.map((sol) => (
          <div class="bg-white p-8 rounded-xl border border-brand-border shadow-sm flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-lg bg-brand-light text-brand-sage flex items-center justify-center mb-5 border border-brand-border">
                <sol.icon class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-brand-dark mb-3 leading-snug">{sol.sector}</h3>
              <p class="text-sm text-brand-muted leading-relaxed">{sol.focus}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-brand-border/60">
              <span class="text-xs font-bold text-brand-sage">Customizable In-House Format</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof: selected public-sector work -->
  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
        <div class="max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-widest text-brand-sage mb-2">Proven In The Field</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Selected public-sector and education work</h2>
          <p class="text-sm sm:text-base text-brand-muted mt-2">A few of the engagements behind our corporate solutions.</p>
        </div>
        <a href="/track-record" class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark transition-colors shadow-sm">
          <span>View the Full Track Record</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {proofProjects.map((project) => (
          <ProjectCard
            title={project.title}
            organisation={project.organisation}
            category={project.category}
            summary={project.summary}
            image={project.image}
            imageAlt={project.imageAlt}
            stat={project.stat}
            clamp={true}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3-Phase Roadmap -->
  <section class="py-20 bg-brand-light border-y border-brand-border">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Engagement Roadmap"
        title="How We Execute Your Corporate Intervention"
        subtitle="From initial talent diagnostics to post-training follow-through, our team handles the heavy lifting."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {roadmapSteps.map((phase) => (
          <div class="bg-white p-7 rounded-xl border border-brand-border">
            <span class="inline-block px-2.5 py-1 rounded bg-brand-sage/10 text-brand-sage font-mono text-xs font-bold uppercase tracking-wider mb-4">
              {phase.number}
            </span>
            <h3 class="text-lg font-bold text-brand-dark mb-2">{phase.title}</h3>
            <p class="text-sm text-brand-muted leading-relaxed">{phase.desc}</p>
          </div>
        ))}
      </div>

      <p class="mt-10 text-center text-xs text-brand-muted max-w-3xl mx-auto leading-relaxed">
        Detailed module syllabi, trainer availability and pricing are finalised after consultation. HRD Corp approvals are subject to your employer account standing. Terms and conditions apply.
      </p>
    </div>
  </section>

  <CtaBand
    title="Need a Bespoke In-House Capability Outline?"
    text="Our enterprise consultants co-design training frameworks directly tailored to your corporate calendar and strategic objectives."
    primary={{ label: 'Enquire About Corporate Solutions', href: '/contact' }}
    secondary={{ label: 'Browse Programmes', href: '/courses' }}
  />
</BaseLayout>
