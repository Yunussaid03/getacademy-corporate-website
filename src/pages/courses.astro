---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CourseCard from '@/components/ui/CourseCard.astro';
import coursesData from '@/data/courses.json';
import { Search, RotateCcw, CheckCircle2, FileQuestion, ArrowRight } from 'lucide-astro';

// Categories available across the 19 courses
const categories = [
  { id: 'all', label: 'All Courses', count: coursesData.length },
  { id: 'workplace-performance', label: 'Workplace Performance', count: coursesData.filter(c => c.category === 'workplace-performance').length },
  { id: 'leadership-management', label: 'Leadership & Management', count: coursesData.filter(c => c.category === 'leadership-management').length },
  { id: 'digital-strategy', label: 'Digital Strategy', count: coursesData.filter(c => c.category === 'digital-strategy').length },
  { id: 'technical-it', label: 'Technical & IT', count: coursesData.filter(c => c.category === 'technical-it').length },
];

const claimSteps = [
  {
    step: '1',
    title: 'Select & Consult',
    desc: 'Choose from the 19 approved courses or consult our advisors to customize training outlines for your team’s skill priorities.'
  },
  {
    step: '2',
    title: 'Receive Grant Pack',
    desc: 'GET Academy prepares official training proposals, itemized fee schedules, trainer profiles, and course outlines.'
  },
  {
    step: '3',
    title: 'e-TRiS Submission',
    desc: 'Submit the grant application via the HRD Corp e-TRiS online portal prior to training commencement with our step-by-step guidance.'
  },
  {
    step: '4',
    title: 'Deliver & Settle',
    desc: 'Training is conducted on-site or in blended formats. Course fees are claimed directly from your levy account under SBL-Khas.'
  }
];
---

<BaseLayout
  title="HRD Corp Claimable Courses Catalogue"
  description="Explore GET Academy's 19 approved HRD Corp claimable courses with interactive search, category filters, and grant claiming guide."
>
  <!-- Header Banner -->
  <section class="bg-brand-dark text-white py-16 border-b border-brand-sage/40">
    <div class="container-custom max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-brand-gold text-xs font-bold uppercase tracking-wider mb-4">
        <span>Verified Curriculum</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-4">
        HRD Corp Claimable Courses
      </h1>
      <p class="text-base sm:text-lg text-gray-200 leading-relaxed">
        Explore 19 verified training programs designed to address organizational capability gaps in leadership, technology, operations, and management. Fully claimable by eligible Malaysian employers under HRD Corp SBL-Khas.
      </p>
    </div>
  </section>

  <!-- Interactive Catalogue Section -->
  <section class="py-16 bg-brand-light min-h-[600px]">
    <div class="container-custom">
      <!-- Search Bar & Controls -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-brand-border shadow-sm mb-10 space-y-6">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
          <div class="relative w-full md:max-w-md">
            <Search class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" />
            <input
              type="text"
              id="course-search-input"
              placeholder="Search by course title or keyword..."
              class="w-full pl-11 pr-10 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
            />
            <button
              id="course-search-clear"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1"
              aria-label="Clear search"
            >
              &times;
            </button>
          </div>

          <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end text-xs text-brand-muted font-medium">
            <span id="results-count" aria-live="polite">
              Showing <strong class="text-brand-dark" id="count-number">{coursesData.length}</strong> of {coursesData.length} programmes
            </span>
            <button
              id="reset-filters-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-brand-border hover:bg-gray-50 text-brand-dark transition-colors"
            >
              <RotateCcw class="w-3.5 h-3.5" />
              <span>Reset</span>
            </button>
          </div>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2 pt-2 border-t border-brand-border/60">
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat.id}
              class={`filter-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all ${
                cat.id === 'all'
                  ? 'bg-brand-dark text-white shadow-sm ring-2 ring-brand-dark/20 active-pill'
                  : 'bg-white text-brand-text border border-brand-border hover:border-brand-sage hover:text-brand-sage'
              }`}
            >
              <span>{cat.label}</span>
              <span class={`pill-count text-[11px] px-1.5 py-0.2 rounded-full ${
                cat.id === 'all' ? 'bg-white/20 text-white' : 'bg-gray-100 text-brand-muted'
              }`}>
                {cat.count}
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Course Card Grid -->
      <div 
        id="courses-grid" 
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        {coursesData.map((course) => (
          <div 
            class="course-card-wrapper"
            data-category={course.category}
            data-title={course.title.toLowerCase()}
          >
            <CourseCard {...course} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results-state" class="hidden text-center py-16 bg-white rounded-2xl border border-brand-border p-8 max-w-lg mx-auto my-12">
        <div class="w-14 h-14 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-4">
          <FileQuestion class="w-7 h-7" />
        </div>
        <h3 class="text-lg font-bold text-brand-dark mb-2">No Matching Courses Found</h3>
        <p class="text-sm text-brand-muted leading-relaxed mb-6">
          We could not find any HRD Corp claimable courses matching your keywords or filter. Please try a different query or reset your selection.
        </p>
        <button
          id="empty-reset-btn"
          type="button"
          class="px-5 py-2.5 bg-brand-sage text-white text-xs font-bold rounded-lg hover:bg-brand-sage-dark transition-all"
        >
          Reset All Filters
        </button>
      </div>
    </div>
  </section>

  <!-- Levy Utilization Guide (4 Steps) -->
  <section class="py-20 bg-white border-t border-brand-border">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Levy Utilization Guide"
        title="How Malaysian Employers Claim via SBL-Khas"
        subtitle="A transparent 4-step workflow for HR and training managers to utilize HRD Corp levy funds with zero out-of-pocket cash requirements."
        centered={true}
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {claimSteps.map((step) => (
          <div class="bg-brand-light p-6 rounded-xl border border-brand-border flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-800 font-extrabold text-base flex items-center justify-center mb-4 border border-emerald-200">
                {step.step}
              </div>
              <h3 class="text-base font-bold text-brand-dark mb-2">{step.title}</h3>
              <p class="text-xs text-brand-muted leading-relaxed">{step.desc}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center gap-1.5 text-[11px] font-semibold text-emerald-800">
              <CheckCircle2 class="w-3.5 h-3.5" />
              <span>Full Guidance Included</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clear Verification Status Notice -->
  <section class="py-12 bg-amber-50/60 border-t border-amber-200">
    <div class="container-custom max-w-4xl">
      <div class="flex items-start gap-4">
        <div class="p-2 bg-amber-100 rounded-lg text-amber-900 shrink-0">
          <CheckCircle2 class="w-5 h-5" />
        </div>
        <div class="space-y-1.5">
          <h4 class="text-sm font-bold text-amber-950 uppercase tracking-wide">
            Detailed Course Syllabus & Reference Numbers
          </h4>
          <p class="text-xs text-amber-900 leading-relaxed">
            Detailed interactive course syllabus downloads, official HRD Corp Scheme reference numbers, and custom in-house timetable outlines are furnished directly upon formal inquiry by our training coordinators.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 bg-brand-dark text-white text-center">
    <div class="container-custom max-w-3xl space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Need Assistance with an HRD Corp Grant Application?</h2>
      <p class="text-gray-200 text-sm leading-relaxed max-w-xl mx-auto">
        Our training advisory team assists with e-TRiS grant submission documentation, trainer profile CVs, and official fee quotations.
      </p>
      <div class="pt-2">
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-bold bg-brand-gold text-brand-dark hover:bg-brand-gold-deep transition-all text-sm">
          <span>Enquire on HRDC Courses</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Client-side filtering logic
  const searchInput = document.getElementById('course-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('course-search-clear');
  const countNumber = document.getElementById('count-number');
  const emptyState = document.getElementById('no-results-state');
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const resetFiltersBtn = document.getElementById('reset-filters-btn');
  const pills = document.querySelectorAll('.filter-pill');
  const cardWrappers = document.querySelectorAll('.course-card-wrapper');

  let activeCategory = 'all';
  let searchQuery = '';

  // Check URL query parameters for initial filter (e.g. ?category=leadership-management)
  const urlParams = new URLSearchParams(window.location.search);
  const initialCategory = urlParams.get('category');
  if (initialCategory) {
    activeCategory = initialCategory;
    updatePillStyles();
  }

  function updatePillStyles() {
    pills.forEach((pill) => {
      const filter = pill.getAttribute('data-filter');
      const countSpan = pill.querySelector('.pill-count');
      if (filter === activeCategory) {
        pill.className = 'filter-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all bg-brand-dark text-white shadow-sm ring-2 ring-brand-dark/20 active-pill';
        if (countSpan) countSpan.className = 'pill-count text-[11px] px-1.5 py-0.2 rounded-full bg-white/20 text-white';
      } else {
        pill.className = 'filter-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-brand-text border border-brand-border hover:border-brand-sage hover:text-brand-sage';
        if (countSpan) countSpan.className = 'pill-count text-[11px] px-1.5 py-0.2 rounded-full bg-gray-100 text-brand-muted';
      }
    });
  }

  function filterCards() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    cardWrappers.forEach((card) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardTitle = card.getAttribute('data-title') || '';

      const matchesCat = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesSearch = !query || cardTitle.includes(query);

      if (matchesCat && matchesSearch) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countNumber) {
      countNumber.textContent = String(visibleCount);
    }

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    if (clearBtn && searchInput) {
      if (searchInput.value.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }
  }

  // Event Listeners
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const selected = pill.getAttribute('data-filter');
      if (selected) {
        activeCategory = selected;
        updatePillStyles();
        filterCards();
      }
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    filterCards();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchQuery = '';
      filterCards();
    }
  });

  function resetAll() {
    activeCategory = 'all';
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    updatePillStyles();
    filterCards();
  }

  resetFiltersBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);

  // Initial pass
  filterCards();
</script>
