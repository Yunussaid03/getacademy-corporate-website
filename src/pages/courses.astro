---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import CourseCard from '@/components/ui/CourseCard.astro';
import coursesData from '@/data/courses.json';
import { pathways, audiences } from '@/data/programmes';
import {
  ArrowRight,
  Briefcase,
  Building2,
  CheckCircle2,
  FileQuestion,
  GraduationCap,
  Megaphone,
  RotateCcw,
  Rocket,
  Search,
  ShieldCheck,
  Users2,
} from 'lucide-astro';

const total = coursesData.length;

const categoryLabels: Record<string, string> = {
  'digital-strategy': 'Digital Strategy',
  'business-incubation': 'Business Incubation',
  'technical-it': 'Technical & IT',
  'workplace-performance': 'Workplace Performance',
  'leadership-management': 'Leadership & Management',
};

const categories = [
  { id: 'all', label: 'All Programmes', count: total },
  ...Object.entries(categoryLabels).map(([id, label]) => ({
    id,
    label,
    count: coursesData.filter((c) => c.category === id).length,
  })),
];

const pathwayIcons = {
  'digital-marketing': Megaphone,
  'business-incubation': Rocket,
  'it-certification': ShieldCheck,
  'professional-development': Briefcase,
} as const;

const audienceIcons = {
  organisations: Building2,
  professionals: Briefcase,
  students: GraduationCap,
  'business-owners': Rocket,
} as const;

const claimSteps = [
  {
    step: '1',
    title: 'Select & Consult',
    desc: `Choose from our ${total} programmes or consult our advisors to customise a programme around your team’s skill priorities.`
  },
  {
    step: '2',
    title: 'Receive Your Proposal',
    desc: 'Our capability advisory team prepares the training proposal, fee quotation, trainer profiles and course outline you need for your application.'
  },
  {
    step: '3',
    title: 'Apply via HRD Corp',
    desc: 'Submit your grant application through the HRD Corp portal before training begins. Our team guides you on the documents required.'
  },
  {
    step: '4',
    title: 'Deliver & Claim',
    desc: 'Training is delivered on-site or virtually, after which you complete your claim with HRD Corp.'
  }
];
---

<BaseLayout
  title="Programmes & Training Catalogue — Korporatly Group | HRD Corp Claimable"
  description={`Explore Korporatly Group's ${total} HRDC claimable training programmes in digital strategy, AI enablement, IT certification and workplace performance, with search and category filters.`}
>
  <PageHero
    eyebrow="Programme Catalogue"
    title="HRD Corp Claimable Programmes"
    description={`Explore ${total} corporate training programmes across digital strategy, business incubation, global IT certification and professional development. All programmes are HRDC claimable (terms and conditions apply).`}
  >
    <div class="mt-8 flex items-center gap-4">
      <img src="/assets/partners/hrdc-claimable-seal.png" alt="HRD Corp claimable" class="w-16 h-16 shrink-0" width="64" height="64" />
      <p class="text-sm text-gray-200 leading-snug max-w-sm">All programmes are claimable under HRD Corp, subject to your employer account and approval.</p>
    </div>
  </PageHero>

  <!-- Programme pathways -->
  <section class="py-20 bg-white border-b border-brand-border" id="pathways">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Programme Pathways"
        title="Four pathways, built for different learners"
        subtitle="Whether you are developing a team, upskilling as a professional, starting your career or growing a business, there is a route for you."
        centered={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto">
        {pathways.map((pathway) => {
          const Icon = pathwayIcons[pathway.id as keyof typeof pathwayIcons] ?? Briefcase;
          return (
            <div class="bg-brand-light rounded-2xl border border-brand-border p-7 flex flex-col hover:border-brand-sage/60 hover:shadow-md transition-all">
              <div class="flex items-start gap-4 mb-4">
                <span class="w-12 h-12 rounded-xl bg-white border border-brand-border text-brand-sage flex items-center justify-center shrink-0">
                  <Icon class="w-6 h-6" aria-hidden="true" />
                </span>
                <h3 class="text-lg font-bold text-brand-dark leading-snug pt-1">{pathway.title}</h3>
              </div>
              <p class="text-sm text-brand-muted leading-relaxed mb-5">{pathway.summary}</p>
              <ul class="flex flex-wrap gap-2 mb-6" role="list">
                {pathway.facts.map((fact) => (
                  <li class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white border border-brand-border text-[11px] font-semibold text-brand-dark">
                    <CheckCircle2 class="w-3 h-3 text-emerald-700 shrink-0" aria-hidden="true" />
                    {fact}
                  </li>
                ))}
              </ul>
              <a
                href={`/courses?category=${pathway.category}#catalogue`}
                class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-brand-sage hover:text-brand-sage-dark"
              >
                <span>Browse these programmes</span>
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          );
        })}
      </div>

      <!-- Who each pathway is for -->
      <div class="mt-14 max-w-6xl mx-auto">
        <h3 class="text-sm font-extrabold uppercase tracking-widest text-brand-sage mb-5 text-center">Who our programmes are for</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {audiences.map((audience) => {
            const Icon = audienceIcons[audience.id as keyof typeof audienceIcons] ?? Users2;
            return (
              <a href={audience.href} class="group p-5 rounded-xl bg-white border border-brand-border hover:border-brand-sage/60 hover:shadow-sm transition-all">
                <span class="w-10 h-10 rounded-lg bg-brand-sage-light text-brand-sage flex items-center justify-center mb-3">
                  <Icon class="w-5 h-5" aria-hidden="true" />
                </span>
                <h4 class="text-sm font-bold text-brand-dark mb-1.5">{audience.title}</h4>
                <p class="text-xs text-brand-muted leading-relaxed">{audience.text}</p>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Catalogue Section -->
  <section class="py-16 bg-brand-light min-h-[600px]" id="catalogue">
    <div class="container-custom">
      <!-- Search Bar & Controls -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-brand-border shadow-sm mb-10 space-y-6">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
          <div class="relative w-full md:max-w-md">
            <Search class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" />
            <input
              type="text"
              id="course-search-input"
              placeholder="Search by course title or keyword..."
              aria-label="Search programmes"
              class="w-full pl-11 pr-10 py-3 bg-brand-light border border-brand-border rounded-xl text-sm text-brand-text placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-sage focus:border-transparent transition-all"
            />
            <button
              id="course-search-clear"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1"
              aria-label="Clear search"
            >
              &times;
            </button>
          </div>

          <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end text-xs text-brand-muted font-medium">
            <span id="results-count" aria-live="polite">
              Showing <strong class="text-brand-dark" id="count-number">{total}</strong> of {total} programmes
            </span>
            <button
              id="reset-filters-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-brand-border hover:bg-gray-50 text-brand-dark transition-colors"
            >
              <RotateCcw class="w-3.5 h-3.5" />
              <span>Reset</span>
            </button>
          </div>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2 pt-2 border-t border-brand-border/60">
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat.id}
              class={`filter-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all ${
                cat.id === 'all'
                  ? 'bg-brand-dark text-white shadow-sm ring-2 ring-brand-dark/20 active-pill'
                  : 'bg-white text-brand-text border border-brand-border hover:border-brand-sage hover:text-brand-sage'
              }`}
            >
              <span>{cat.label}</span>
              <span class={`pill-count text-[11px] px-1.5 py-0.2 rounded-full ${
                cat.id === 'all' ? 'bg-white/20 text-white' : 'bg-gray-100 text-brand-muted'
              }`}>
                {cat.count}
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Course Card Grid -->
      <div
        id="courses-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        {coursesData.map((course) => (
          <div
            class="course-card-wrapper"
            data-category={course.category}
            data-title={[course.title, categoryLabels[course.category] ?? '', course.certificate ?? '', (course.audience ?? []).join(' ')].join(' ').toLowerCase()}
          >
            <CourseCard {...course} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results-state" class="hidden text-center py-16 bg-white rounded-2xl border border-brand-border p-8 max-w-lg mx-auto my-12">
        <div class="w-14 h-14 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-4">
          <FileQuestion class="w-7 h-7" />
        </div>
        <h3 class="text-lg font-bold text-brand-dark mb-2">No Matching Programmes Found</h3>
        <p class="text-sm text-brand-muted leading-relaxed mb-6">
          We could not find any programmes matching your keywords or filter. Please try a different query or reset your selection.
        </p>
        <button
          id="empty-reset-btn"
          type="button"
          class="px-5 py-2.5 bg-brand-sage text-white text-xs font-bold rounded-lg hover:bg-brand-sage-dark transition-all"
        >
          Reset All Filters
        </button>
      </div>

      <p class="mt-10 text-center text-xs text-brand-muted">Terms and conditions apply. Detailed syllabus outlines, fee quotations and in-house timetable options are provided on enquiry.</p>
    </div>
  </section>

  <!-- Funding Guide (4 Steps) -->
  <section class="py-20 bg-white border-t border-brand-border">
    <div class="container-custom">
      <SectionHeader
        eyebrow="Funding Guide"
        title="Claiming HRD Corp Funding for Your Team"
        subtitle="All training programmes are HRDC claimable. Here is how our team supports your employer application, subject to account standing and HRD Corp approval."
        centered={true}
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {claimSteps.map((step) => (
          <div class="bg-brand-light p-6 rounded-xl border border-brand-border flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-800 font-extrabold text-base flex items-center justify-center mb-4 border border-emerald-200">
                {step.step}
              </div>
              <h3 class="text-base font-bold text-brand-dark mb-2">{step.title}</h3>
              <p class="text-xs text-brand-muted leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Need Assistance with an HRD Corp Application?"
    text="Our training advisory team assists with proposal documents, trainer profiles and fee quotations for your HRD Corp grant application."
    primary={{ label: 'Enquire on Programmes', href: '/contact' }}
    secondary={{ label: 'Corporate Solutions', href: '/corporate-solutions' }}
  />
</BaseLayout>

<script>
  // Client-side filtering logic
  const searchInput = document.getElementById('course-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('course-search-clear');
  const countNumber = document.getElementById('count-number');
  const emptyState = document.getElementById('no-results-state');
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const resetFiltersBtn = document.getElementById('reset-filters-btn');
  const pills = document.querySelectorAll('.filter-pill');
  const cardWrappers = document.querySelectorAll('.course-card-wrapper');

  let activeCategory = 'all';
  let searchQuery = '';

  // Check URL query parameters for initial filter (e.g. ?category=technical-it)
  const urlParams = new URLSearchParams(window.location.search);
  const initialCategory = urlParams.get('category');
  const validCategories = Array.from(pills).map((pill) => pill.getAttribute('data-filter'));
  if (initialCategory && validCategories.includes(initialCategory)) {
    activeCategory = initialCategory;
    updatePillStyles();
    // Arrive at the filtered list rather than at the pathways above it
    window.requestAnimationFrame(() => {
      document.getElementById('catalogue')?.scrollIntoView({ block: 'start' });
    });
  }

  function updatePillStyles() {
    pills.forEach((pill) => {
      const filter = pill.getAttribute('data-filter');
      const countSpan = pill.querySelector('.pill-count');
      if (filter === activeCategory) {
        pill.className = 'filter-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all bg-brand-dark text-white shadow-sm ring-2 ring-brand-dark/20 active-pill';
        if (countSpan) countSpan.className = 'pill-count text-[11px] px-1.5 py-0.2 rounded-full bg-white/20 text-white';
      } else {
        pill.className = 'filter-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-brand-text border border-brand-border hover:border-brand-sage hover:text-brand-sage';
        if (countSpan) countSpan.className = 'pill-count text-[11px] px-1.5 py-0.2 rounded-full bg-gray-100 text-brand-muted';
      }
    });
  }

  function filterCards() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    cardWrappers.forEach((card) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardText = card.getAttribute('data-title') || '';

      const matchesCat = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesSearch = !query || cardText.includes(query);

      if (matchesCat && matchesSearch) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countNumber) {
      countNumber.textContent = String(visibleCount);
    }

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    if (clearBtn && searchInput) {
      if (searchInput.value.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }
  }

  // Event Listeners
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const selected = pill.getAttribute('data-filter');
      if (selected) {
        activeCategory = selected;
        updatePillStyles();
        filterCards();
      }
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    filterCards();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchQuery = '';
      filterCards();
    }
  });

  function resetAll() {
    activeCategory = 'all';
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    updatePillStyles();
    filterCards();
  }

  resetFiltersBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);

  // Initial pass
  filterCards();
</script>
