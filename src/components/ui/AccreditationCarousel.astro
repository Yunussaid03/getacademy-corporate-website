---
import { Award, BadgeCheck, ChevronLeft, ChevronRight, ShieldCheck, Users2 } from 'lucide-astro';
import { accreditations, accreditationGroups, verificationNote } from '@/data/accreditations';

const icons = { mentor: Award, workshop: Users2, membership: BadgeCheck };

const groups = accreditationGroups
  .map((group) => ({ ...group, count: accreditations.filter((item) => item.group === group.id).length }))
  .filter((group) => group.count > 0);

const groupLabel = Object.fromEntries(accreditationGroups.map((g) => [g.id, g.label]));
---

<div>
  <!-- Category filter tabs -->
  <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10" role="tablist" aria-label="Accreditation categories">
    <button
      type="button"
      class="category-tab-btn active px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-xs font-bold transition-all duration-200 border border-brand-sage bg-brand-sage text-white shadow-xs"
      data-category="all"
      role="tab"
      aria-selected="true"
    >
      All ({accreditations.length})
    </button>
    {groups.map((group) => (
      <button
        type="button"
        class="category-tab-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-xs font-bold transition-all duration-200 border border-brand-border bg-brand-light text-brand-dark hover:border-brand-sage/60 hover:text-brand-sage"
        data-category={group.id}
        role="tab"
        aria-selected="false"
      >
        {group.label} ({group.count})
      </button>
    ))}
  </div>

  <!-- Carousel -->
  <div class="relative max-w-6xl mx-auto mb-12">
    <button
      type="button"
      id="partner-carousel-prev"
      class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white border border-brand-border shadow-md text-brand-dark hover:bg-brand-light hover:text-brand-sage hover:border-brand-sage/60 transition-all flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-brand-sage/50"
      aria-label="Previous accreditations"
    >
      <ChevronLeft class="w-5 h-5 sm:w-6 sm:h-6" />
    </button>

    <div
      id="partner-carousel-track"
      class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 pt-1 px-2 no-scrollbar focus:outline-none focus:ring-2 focus:ring-brand-sage/30 rounded-2xl"
      tabindex="0"
      aria-label="Accreditations and affiliations"
    >
      {accreditations.map((item) => {
        const Icon = item.icon ? icons[item.icon] : null;
        return (
          <div
            class="carousel-card snap-start shrink-0 w-[290px] sm:w-[340px] md:w-[350px] bg-white rounded-2xl border border-brand-border p-6 shadow-sm hover:shadow-md hover:border-brand-sage/60 transition-all duration-300 flex flex-col group"
            data-category={item.group}
          >
            <div class="w-full h-32 sm:h-36 rounded-xl bg-slate-50/80 border border-slate-100 p-4 sm:p-5 flex items-center justify-center mb-5 group-hover:bg-white transition-colors">
              {item.logo ? (
                <img
                  src={item.logo}
                  alt={item.name}
                  class="max-h-20 sm:max-h-24 max-w-[200px] w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                Icon && <Icon class="w-14 h-14 text-brand-sage" aria-hidden="true" />
              )}
            </div>

            <div class="flex flex-wrap items-center gap-1.5 mb-2.5">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-brand-sage-light text-brand-sage">
                {item.badge}
              </span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold text-slate-500 bg-slate-100">
                {groupLabel[item.group]}
              </span>
            </div>

            <h4 class="text-sm sm:text-base font-bold text-brand-dark mb-2 leading-snug group-hover:text-brand-sage transition-colors">
              {item.name}
            </h4>
            <p class="text-xs text-brand-muted leading-relaxed">{item.scope}</p>
          </div>
        );
      })}
    </div>

    <button
      type="button"
      id="partner-carousel-next"
      class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white border border-brand-border shadow-md text-brand-dark hover:bg-brand-light hover:text-brand-sage hover:border-brand-sage/60 transition-all flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-brand-sage/50"
      aria-label="Next accreditations"
    >
      <ChevronRight class="w-5 h-5 sm:w-6 sm:h-6" />
    </button>

    <div class="flex items-center justify-center gap-2 mt-4 text-xs text-brand-muted">
      <span class="inline-block w-2 h-2 rounded-full bg-brand-sage"></span>
      <span class="text-[11px] font-medium">Use the arrow buttons or swipe to explore all {accreditations.length} affiliations</span>
    </div>
  </div>

  <!-- Verification note -->
  <div class="max-w-4xl mx-auto bg-brand-sage-light/60 border border-brand-border rounded-2xl p-5 sm:p-6 flex items-start gap-4 text-xs text-brand-dark">
    <div class="w-9 h-9 rounded-xl bg-white text-brand-sage flex items-center justify-center shrink-0 mt-0.5 border border-brand-border">
      <ShieldCheck class="w-5 h-5" />
    </div>
    <div class="space-y-1.5">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-sage">Verification on request</p>
      <p class="text-xs text-brand-muted leading-relaxed">{verificationNote}</p>
    </div>
  </div>
</div>

<script>
  const track = document.getElementById('partner-carousel-track');
  const prevBtn = document.getElementById('partner-carousel-prev');
  const nextBtn = document.getElementById('partner-carousel-next');
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.category-tab-btn');
  const cards = document.querySelectorAll<HTMLElement>('.carousel-card');

  if (track && prevBtn && nextBtn) {
    const scrollDistance = () => {
      const firstCard = track.querySelector<HTMLElement>('.carousel-card:not(.hidden)');
      return firstCard ? firstCard.offsetWidth + 24 : 360;
    };

    prevBtn.addEventListener('click', () => track.scrollBy({ left: -scrollDistance(), behavior: 'smooth' }));
    nextBtn.addEventListener('click', () => track.scrollBy({ left: scrollDistance(), behavior: 'smooth' }));

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        track.scrollBy({ left: -scrollDistance(), behavior: 'smooth' });
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        track.scrollBy({ left: scrollDistance(), behavior: 'smooth' });
      }
    });

    const activeClasses = ['active', 'bg-brand-sage', 'text-white', 'border-brand-sage'];
    const idleClasses = ['bg-brand-light', 'text-brand-dark', 'border-brand-border'];

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;

        tabBtns.forEach((b) => {
          b.classList.remove(...activeClasses);
          b.classList.add(...idleClasses);
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add(...activeClasses);
        btn.classList.remove(...idleClasses);
        btn.setAttribute('aria-selected', 'true');

        cards.forEach((card) => {
          card.classList.toggle('hidden', !(category === 'all' || card.dataset.category === category));
        });

        track.scrollTo({ left: 0, behavior: 'smooth' });
      });
    });
  }
</script>
