---
import { ArrowRight, FileText, CheckCircle2 } from 'lucide-astro';

interface Props {
  number: string;
  category: string;
  faculty: string;
  title: string;
  description: string;
  image: string;
}

const { number, category, faculty, title, description, image } = Astro.props;

const categoryLabels: Record<string, string> = {
  'digital-strategy': 'Digital Strategy',
  'workplace-performance': 'Workplace Performance',
  'leadership-management': 'Leadership & Management',
  'technical-it': 'Technical & IT Skills',
  'general': 'Professional Skills',
};

const displayCategory = categoryLabels[category] || category;
---

<div class="group bg-white rounded-xl border border-brand-border hover:border-brand-sage/60 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden">
  <!-- Card Header Media -->
  <div class="relative aspect-[16/9] bg-brand-dark/5 overflow-hidden border-b border-brand-border">
    {image ? (
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-brand-dark to-brand-sage text-white/40">
        <FileText class="w-12 h-12" />
      </div>
    )}
    <!-- Overlay Badges -->
    <div class="absolute top-3 left-3 flex items-center gap-2">
      <span class="bg-brand-dark/90 backdrop-blur-sm text-brand-gold text-xs font-extrabold px-2.5 py-1 rounded shadow-sm">
        {number}
      </span>
      <span class="bg-white/95 backdrop-blur-sm text-brand-dark text-[11px] font-bold px-2 py-0.5 rounded shadow-sm">
        {faculty}
      </span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-grow flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-brand-sage uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-brand-sage"></span>
        <span>{displayCategory}</span>
      </div>
      <h3 class="text-lg font-bold text-brand-dark group-hover:text-brand-sage transition-colors leading-snug line-clamp-2 mb-2.5">
        {title}
      </h3>
      <p class="text-sm text-brand-muted line-clamp-2 leading-relaxed mb-4">
        {description}
      </p>
    </div>

    <!-- Card Action Links -->
    <div class="pt-4 border-t border-brand-border/60 flex items-center justify-between gap-3 text-xs">
      <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
        <CheckCircle2 class="w-3.5 h-3.5" />
        <span>HRDC SBL-Khas</span>
      </span>
      <a
        href={`/contact?course=${encodeURIComponent(title)}`}
        class="inline-flex items-center gap-1 font-bold text-brand-dark hover:text-brand-sage group/btn"
      >
        <span>Enquire Now</span>
        <ArrowRight class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform text-brand-sage" />
      </a>
    </div>
  </div>
</div>
