---
import { ArrowRight, Award, CheckCircle2, Clock, FileText } from 'lucide-astro';

interface Props {
  number: string;
  category: string;
  faculty: string;
  title: string;
  description: string;
  image: string;
  duration?: string;
  audience?: string[];
  certificate?: string;
  highlights?: string[];
}

const {
  number,
  category,
  faculty,
  title,
  description,
  image,
  duration,
  audience = [],
  certificate,
  highlights = [],
} = Astro.props;

const categoryLabels: Record<string, string> = {
  'digital-strategy': 'Digital Strategy',
  'business-incubation': 'Business Incubation',
  'workplace-performance': 'Workplace Performance',
  'leadership-management': 'Leadership & Management',
  'technical-it': 'Technical & IT Skills',
  'general': 'Professional Skills',
};

const displayCategory = categoryLabels[category] || category;
const hasFacts = Boolean(duration || certificate);
---

<div class="group h-full bg-white rounded-xl border border-brand-border hover:border-brand-sage/60 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden">
  <!-- Card Header Media -->
  <div class="relative aspect-[16/9] bg-brand-dark/5 overflow-hidden border-b border-brand-border">
    {image ? (
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-brand-dark to-brand-sage text-white/40">
        <FileText class="w-12 h-12" />
      </div>
    )}
    <!-- Overlay Badges -->
    <div class="absolute top-3 left-3 flex items-center gap-2">
      <span class="bg-brand-dark/90 backdrop-blur-sm text-brand-gold text-xs font-extrabold px-2.5 py-1 rounded shadow-sm">
        {number}
      </span>
      <span class="bg-white/95 backdrop-blur-sm text-brand-dark text-[11px] font-bold px-2 py-0.5 rounded shadow-sm">
        {faculty}
      </span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-grow flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-brand-sage uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-brand-sage"></span>
        <span>{displayCategory}</span>
      </div>
      <h3 class="text-lg font-bold text-brand-dark group-hover:text-brand-sage transition-colors leading-snug line-clamp-2 mb-2.5">
        {title}
      </h3>
      <p class="text-sm text-brand-muted leading-relaxed mb-4">
        {description}
      </p>

      {hasFacts && (
        <div class="flex flex-wrap gap-2 mb-4">
          {duration && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-brand-light border border-brand-border text-[11px] font-semibold text-brand-dark">
              <Clock class="w-3.5 h-3.5 text-brand-sage" aria-hidden="true" />
              {duration}
            </span>
          )}
          {certificate && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-brand-light border border-brand-border text-[11px] font-semibold text-brand-dark">
              <Award class="w-3.5 h-3.5 text-brand-sage" aria-hidden="true" />
              {certificate}
            </span>
          )}
        </div>
      )}

      {highlights.length > 0 && (
        <ul class="space-y-1.5 mb-4">
          {highlights.map((item) => (
            <li class="flex items-start gap-2 text-xs text-brand-muted leading-snug">
              <CheckCircle2 class="w-3.5 h-3.5 text-emerald-700 shrink-0 mt-0.5" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}

      {audience.length > 0 && (
        <p class="text-[11px] text-brand-muted mb-4 leading-snug">
          <span class="font-bold text-brand-dark">Suitable for:</span> {audience.join(' · ')}
        </p>
      )}
    </div>

    <!-- Card Action Links -->
    <div class="pt-4 border-t border-brand-border/60 flex items-center justify-between gap-3 text-xs">
      <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
        <CheckCircle2 class="w-3.5 h-3.5" />
        <span>HRDC Claimable</span>
      </span>
      <a
        href={`/contact?course=${encodeURIComponent(title)}`}
        class="inline-flex items-center gap-1 font-bold text-brand-dark hover:text-brand-sage group/btn"
      >
        <span>Enquire Now</span>
        <ArrowRight class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform text-brand-sage" />
      </a>
    </div>
  </div>
</div>
