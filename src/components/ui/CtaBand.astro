---
import { ArrowRight } from 'lucide-astro';

interface Action {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  primary: Action;
  secondary?: Action;
}

const { eyebrow, title, text, primary, secondary } = Astro.props;
---

<section class="py-16 sm:py-20 bg-brand-dark text-white text-center relative overflow-hidden">
  <div class="container-custom max-w-3xl space-y-5 relative z-10">
    {eyebrow && (
      <span class="text-xs font-bold uppercase tracking-widest text-brand-gold block">{eyebrow}</span>
    )}
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">{title}</h2>
    <p class="text-gray-200 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">{text}</p>
    <div class="pt-2 flex flex-wrap justify-center gap-4">
      <a
        href={primary.href}
        class="px-6 py-3.5 rounded-xl font-bold bg-brand-gold text-brand-dark hover:bg-brand-gold-deep transition-all duration-200 text-sm shadow-md inline-flex items-center gap-2"
      >
        <span>{primary.label}</span>
        <ArrowRight class="w-4 h-4" />
      </a>
      {secondary && (
        <a
          href={secondary.href}
          class="px-6 py-3.5 rounded-xl font-bold bg-white/10 hover:bg-white/20 border border-white/20 text-white transition-all duration-200 text-sm backdrop-blur-sm"
        >
          <span>{secondary.label}</span>
        </a>
      )}
    </div>
  </div>
</section>
