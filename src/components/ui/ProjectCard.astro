---
interface Props {
  title: string;
  organisation: string;
  category: string;
  summary: string;
  image?: string;
  imageAlt?: string;
  stat?: string;
  /** CSS object-position for the photo, e.g. "top" or "center 30%". */
  imagePosition?: string;
  /** Limit the summary to four lines (homepage grid). */
  clamp?: boolean;
}

const {
  title,
  organisation,
  category,
  summary,
  image,
  imageAlt = '',
  stat,
  imagePosition = 'center',
  clamp = false,
} = Astro.props;
---

<article class="bg-white rounded-xl border border-brand-border shadow-sm hover:border-brand-sage/60 hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden group h-full">
  {image && (
    <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
      <img
        src={image}
        alt={imageAlt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        style={`object-position: ${imagePosition};`}
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
      <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-white/95 text-brand-dark shadow-sm backdrop-blur-sm">
        {category}
      </span>
      {stat && (
        <span class="absolute bottom-2 left-2.5 right-2.5 text-[11px] font-bold text-white drop-shadow truncate">
          {stat}
        </span>
      )}
    </div>
  )}
  <div class="p-5 flex-1 flex flex-col">
    {!image && (
      <span class="self-start mb-3 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-brand-sage-light text-brand-sage">
        {category}
      </span>
    )}
    <p class="text-xs font-semibold text-brand-sage mb-1.5">{organisation}</p>
    <h3 class="text-base font-bold text-brand-dark mb-2.5 leading-snug group-hover:text-brand-sage transition-colors">
      {title}
    </h3>
    <p class={`text-sm text-brand-muted leading-relaxed ${clamp ? 'line-clamp-4' : ''}`}>
      {summary}
    </p>
  </div>
</article>
