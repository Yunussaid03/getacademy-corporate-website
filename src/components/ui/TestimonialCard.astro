---
import { Quote, ArrowRight } from 'lucide-astro';

interface Props {
  id?: string;
  name: string;
  role?: string;
  programme: string;
  /** Paragraphs of the testimonial exactly as written by the participant. */
  paragraphs: string[];
  accent?: 'green' | 'gold';
  /** Optional link to the full testimonial. */
  href?: string;
}

const { id, name, role, programme, paragraphs, accent = 'green', href } = Astro.props;

const initials = name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
---

<figure id={id} class="relative bg-white rounded-2xl border border-brand-border shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col h-full scroll-mt-32">
  <div class={`h-1.5 w-full ${accent === 'gold' ? 'bg-brand-gold' : 'bg-brand-sage'}`}></div>
  <div class="p-6 sm:p-7 flex-1 flex flex-col">
    <Quote class="w-8 h-8 text-brand-gold mb-3 shrink-0" aria-hidden="true" />
    <blockquote class="space-y-3 text-sm leading-relaxed text-brand-text flex-1">
      {paragraphs.map((text) => <p>{text}</p>)}
    </blockquote>
    {href && (
      <a href={href} class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-brand-sage hover:text-brand-sage-dark">
        <span>Read the full testimonial</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    )}
    <figcaption class="mt-5 pt-4 border-t border-brand-border/70 flex items-center gap-3">
      <span class="w-10 h-10 rounded-full bg-brand-sage text-white text-xs font-extrabold flex items-center justify-center shrink-0" aria-hidden="true">
        {initials}
      </span>
      <span class="min-w-0">
        <span class="block text-sm font-bold text-brand-dark">{name}</span>
        {role && <span class="block text-xs text-brand-muted leading-snug">{role}</span>}
        <span class="mt-1.5 inline-block text-[10px] font-bold uppercase tracking-wider text-brand-sage bg-brand-sage-light px-2 py-0.5 rounded">
          {programme}
        </span>
      </span>
    </figcaption>
  </div>
</figure>
