---
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'GET Academy — Your Unbeatable Human Capital Development Partner. Practical corporate training in AI, global IT certification, entrepreneurship and professional development across Malaysia. All programmes HRDC claimable.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/brand/GETA-Logo-100x100.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload local variable font for optimal Core Web Vitals (sub-second LCP) -->
    <link
      rel="preload"
      href="/fonts/Manrope-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO Meta Tags -->
    <title>{title} | GET Academy</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | GET Academy`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/brand/GETA-Logo.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1A2E26" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-brand-text antialiased selection:bg-brand-gold selection:text-brand-dark">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
