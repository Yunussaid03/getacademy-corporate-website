---
import { Menu, X, ExternalLink, PhoneCall } from 'lucide-astro';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Courses', href: '/courses' },
  { label: 'Corporate Solutions', href: '/corporate-solutions' },
  { label: 'Our Trainers', href: '/trainers' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-border/80 transition-all">
  <!-- Top Corporate Announcement Bar -->
  <div class="bg-brand-dark text-white text-xs py-2 px-4 border-b border-brand-sage/40">
    <div class="container-custom flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-brand-gold text-brand-dark tracking-wide uppercase">HRD Corp Registered</span>
        <span class="text-gray-300 hidden sm:inline">100% Claimable Corporate Training for Malaysian Employers (SBL-Khas)</span>
      </div>
      <div class="flex items-center gap-4 text-gray-300">
        <!-- Configurable Student Portal Link awaiting confirmation -->
        <a 
          href="#portal-modal" 
          id="student-portal-link"
          class="flex items-center gap-1 hover:text-brand-gold transition-colors font-medium text-[11px]"
          title="Student Portal destination awaiting confirmed domain configuration"
        >
          <span>Learner Portal Login</span>
          <ExternalLink class="w-3 h-3 text-brand-gold" />
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="container-custom py-3.5 flex items-center justify-between">
    <!-- Logo and Identity -->
    <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-brand-sage rounded-lg p-1">
      <img 
        src="/assets/brand/GETA-Logo.png" 
        alt="GET Academy Logo" 
        class="h-11 w-auto object-contain transform transition group-hover:scale-105"
        width="115"
        height="112"
      />
      <div class="flex flex-col">
        <span class="font-extrabold text-xl sm:text-2xl tracking-tight text-brand-dark leading-none">
          GET <span class="text-brand-sage">ACADEMY</span>
        </span>
        <span class="text-[10px] sm:text-[11px] font-semibold text-brand-muted tracking-wider uppercase mt-1">
          Human Capital Development
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-2 rounded-md text-sm font-semibold transition-all ${
            isActive(item.href)
              ? 'text-brand-sage bg-brand-light font-bold border-b-2 border-brand-sage'
              : 'text-brand-text hover:text-brand-sage hover:bg-gray-50'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Action Buttons -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-sage"
      >
        Corporate Enquiry
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="lg:hidden p-2 rounded-lg text-brand-text hover:text-brand-sage hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-sage"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <Menu id="menu-icon-open" class="w-6 h-6 block" />
      <X id="menu-icon-close" class="w-6 h-6 hidden" />
    </button>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-3 py-2.5 rounded-md text-base font-medium ${
          isActive(item.href)
            ? 'text-brand-sage bg-brand-light font-bold'
            : 'text-brand-text hover:text-brand-sage hover:bg-gray-50'
        }`}
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 border-t border-brand-border mt-3 space-y-3">
      <a
        href="/contact"
        class="block w-full text-center px-4 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark"
      >
        Corporate Enquiry
      </a>
      <a
        href="#portal-modal"
        class="flex items-center justify-center gap-1.5 w-full text-center px-4 py-2 text-xs font-semibold rounded-lg text-brand-dark bg-brand-canvas border border-brand-border"
      >
        <span>Learner Portal Login</span>
        <ExternalLink class="w-3.5 h-3.5 text-brand-sage" />
      </a>
    </div>
  </div>
</header>

<!-- Learner Portal Modal (Awaiting confirmed URL) -->
<div id="portal-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-2xl border border-brand-border relative">
    <button id="close-portal-modal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 p-1">
      <X class="w-5 h-5" />
    </button>
    <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-700 flex items-center justify-center mb-4">
      <ExternalLink class="w-6 h-6" />
    </div>
    <h3 class="text-lg font-bold text-brand-dark mb-2">Learner Portal Destination</h3>
    <p class="text-sm text-brand-muted mb-4 leading-relaxed">
      The dedicated LMS Learner Portal is kept strictly decoupled from this corporate website. The production domain (<code class="bg-gray-100 px-1 py-0.5 rounded text-xs">learn.getacademy.com.my</code>) is currently awaiting management confirmation.
    </p>
    <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-800 mb-5">
      <strong>Status:</strong> Staging / Production LMS endpoint awaiting client sign-off.
    </div>
    <div class="flex justify-end gap-3">
      <button id="dismiss-portal-modal" class="px-4 py-2 text-sm font-semibold rounded-lg border border-brand-border text-brand-text hover:bg-gray-50">
        Close
      </button>
      <a href="/contact" class="px-4 py-2 text-sm font-bold rounded-lg bg-brand-sage text-white hover:bg-brand-sage-dark">
        Contact Training Support
      </a>
    </div>
  </div>
</div>

<script>
  // Mobile navigation toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  // Portal Modal handler
  const portalLinks = document.querySelectorAll('a[href="#portal-modal"]');
  const portalModal = document.getElementById('portal-modal');
  const closeBtn = document.getElementById('close-portal-modal');
  const dismissBtn = document.getElementById('dismiss-portal-modal');

  function openModal(e: Event) {
    e.preventDefault();
    portalModal?.classList.remove('hidden');
    portalModal?.classList.add('flex');
  }

  function closeModal() {
    portalModal?.classList.add('hidden');
    portalModal?.classList.remove('flex');
  }

  portalLinks.forEach(link => link.addEventListener('click', openModal));
  closeBtn?.addEventListener('click', closeModal);
  dismissBtn?.addEventListener('click', closeModal);
  portalModal?.addEventListener('click', (e) => {
    if (e.target === portalModal) closeModal();
  });
</script>
