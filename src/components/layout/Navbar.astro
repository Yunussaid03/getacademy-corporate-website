---
import { Menu, X, ChevronDown } from 'lucide-astro';

interface SubNavItem {
  label: string;
  href: string;
  targetId: string;
}

interface NavItem {
  id: string;
  label: string;
  href: string;
  subItems?: SubNavItem[];
}

const aboutSections: SubNavItem[] = [
  { label: 'What We Do', href: '/#what-we-do', targetId: 'what-we-do' },
  { label: 'Accreditations & Institutional Relationships', href: '/#accreditations', targetId: 'accreditations' },
  { label: 'Why GET Academy', href: '/#why-get-academy', targetId: 'why-get-academy' },
];

const courseCategories: SubNavItem[] = [
  { label: 'All Programmes', href: '/#programmes', targetId: 'programmes' },
  { label: 'Digital Strategy', href: '/#digital-strategy', targetId: 'digital-strategy' },
  { label: 'Workplace Performance', href: '/#workplace-performance', targetId: 'workplace-performance' },
  { label: 'Leadership & Management', href: '/#leadership-management', targetId: 'leadership-management' },
];

const navItems: NavItem[] = [
  { id: 'home', label: 'Home', href: '/' },
  { 
    id: 'about',
    label: 'About Us', 
    href: '/#what-we-do',
    subItems: aboutSections
  },
  { 
    id: 'courses',
    label: 'Courses', 
    href: '/#programmes',
    subItems: courseCategories
  },
  { id: 'corporate-solutions', label: 'Corporate Solutions', href: '/#institutional-experience' },
  { id: 'contact', label: 'Contact', href: '/#corporate-enquiry' },
];

const currentPath = Astro.url.pathname;
const isInitialActive = (id: string) => {
  if (currentPath === '/' && id === 'home') return true;
  if (currentPath.startsWith('/about') && id === 'about') return true;
  if (currentPath.startsWith('/courses') && id === 'courses') return true;
  if (currentPath.startsWith('/corporate-solutions') && id === 'corporate-solutions') return true;
  if (currentPath.startsWith('/contact') && id === 'contact') return true;
  return false;
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-border/80 transition-all shadow-sm">
  <!-- Main Navigation -->
  <div class="container-custom py-3.5 flex items-center justify-between">
    <!-- Logo and Identity -->
    <a href="/" class="flex items-center gap-4 sm:gap-5 group focus:outline-none focus:ring-2 focus:ring-brand-sage rounded-lg py-1">
      <img 
        src="/assets/brand/GETA-Logo-HQ.png" 
        alt="GET Academy Logo" 
        class="h-20 sm:h-24 w-auto object-contain rounded-sm shadow-[0_4px_10px_rgba(0,0,0,0.22)] transform transition duration-200 group-hover:scale-105"
        width="150"
        height="150"
      />
      <div class="flex flex-col justify-center leading-[1.15]">
        <span class="font-bold text-xl sm:text-2xl text-neutral-900 tracking-tight">
          GET
        </span>
        <span class="font-bold text-xl sm:text-2xl text-neutral-900 tracking-tight">
          Academy
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2" aria-label="Main Navigation">
      {navItems.map((item, idx) => (
        item.subItems ? (
          <div class="relative nav-dropdown" data-dropdown-index={idx}>
            <button
              type="button"
              id={`nav-dropdown-btn-${idx}`}
              data-nav-id={item.id}
              class={`dropdown-toggle inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md text-sm font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-brand-sage ${
                isInitialActive(item.id)
                  ? 'text-brand-sage bg-brand-sage-light font-bold border-b-2 border-brand-sage'
                  : 'text-brand-text hover:text-brand-sage hover:bg-brand-light'
              }`}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls={`nav-dropdown-menu-${idx}`}
            >
              <span>{item.label}</span>
              <ChevronDown class={`dropdown-chevron w-3.5 h-3.5 transition-transform duration-200 ${
                isInitialActive(item.id) ? 'text-brand-sage' : 'text-brand-muted'
              }`} />
            </button>

            <!-- Dropdown Menu -->
            <div 
              id={`nav-dropdown-menu-${idx}`}
              class="dropdown-menu absolute left-0 top-full pt-1.5 hidden z-50 min-w-[300px]"
              role="menu"
              aria-labelledby={`nav-dropdown-btn-${idx}`}
            >
              <div class="bg-white rounded-xl shadow-xl border border-brand-border p-1.5 text-sm">
                {item.subItems.map((sub) => (
                  <a
                    href={sub.href}
                    data-parent-id={item.id}
                    data-sub-target={sub.targetId}
                    class="dropdown-link block px-3.5 py-2.5 text-xs sm:text-sm text-brand-dark hover:text-brand-sage hover:bg-brand-light font-semibold rounded-lg transition-colors leading-snug focus:outline-none focus:bg-brand-light focus:text-brand-sage"
                    role="menuitem"
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            data-nav-id={item.id}
            class={`px-3.5 py-2 rounded-md text-sm font-semibold transition-all ${
              isInitialActive(item.id)
                ? 'text-brand-sage bg-brand-sage-light font-bold border-b-2 border-brand-sage'
                : 'text-brand-text hover:text-brand-sage hover:bg-brand-light'
            }`}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Header Action Buttons -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/#corporate-enquiry"
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-sage"
      >
        Corporate Enquiry
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="lg:hidden p-2 rounded-lg text-brand-text hover:text-brand-sage hover:bg-brand-light focus:outline-none focus:ring-2 focus:ring-brand-sage"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <Menu id="menu-icon-open" class="w-6 h-6 block" />
      <X id="menu-icon-close" class="w-6 h-6 hidden" />
    </button>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6 space-y-1 shadow-lg max-h-[calc(100vh-5rem)] overflow-y-auto"
  >
    {navItems.map((item) => (
      item.subItems ? (
        <div class="py-1">
          <div 
            class="flex items-center justify-between px-3 py-2 rounded-md bg-brand-light/70 mobile-group-header transition-colors"
            data-mobile-group={item.id}
          >
            <span class="mobile-group-title text-base font-bold text-brand-dark transition-colors">
              {item.label}
            </span>
            <span class="mobile-group-badge text-[10px] font-bold text-brand-sage uppercase tracking-wider bg-white px-2 py-0.5 rounded border border-brand-border transition-colors">
              {item.label === 'Courses' ? 'Categories' : 'Sections'}
            </span>
          </div>
          <div class="pl-3 mt-1.5 space-y-1 border-l-2 border-brand-sage/40 ml-3">
            {item.subItems.map((sub) => (
              <a
                href={sub.href}
                data-mobile-parent={item.id}
                data-mobile-sub-target={sub.targetId}
                class="block px-3 py-2 text-sm text-brand-muted hover:text-brand-sage hover:bg-brand-light font-medium rounded-md transition-colors"
              >
                {sub.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          data-mobile-nav-id={item.id}
          class={`block px-3 py-2.5 rounded-md text-base font-medium transition-colors ${
            isInitialActive(item.id)
              ? 'text-brand-sage bg-brand-sage-light font-bold'
              : 'text-brand-text hover:text-brand-sage hover:bg-brand-light'
          }`}
        >
          {item.label}
        </a>
      )
    ))}
    <div class="pt-4 border-t border-brand-border mt-3">
      <a
        href="/#corporate-enquiry"
        data-mobile-nav-id="contact-cta"
        class="block w-full text-center px-4 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark shadow-xs"
      >
        Corporate Enquiry
      </a>
    </div>
  </div>
</header>

<script>
  // Unified styling classes matching the Home link standard
  const desktopActiveClasses = ['text-brand-sage', 'bg-brand-sage-light', 'font-bold', 'border-b-2', 'border-brand-sage'];
  const desktopInactiveClasses = ['text-brand-text', 'hover:text-brand-sage', 'hover:bg-brand-light'];

  const subActiveClasses = ['text-brand-sage', 'bg-brand-sage-light', 'font-bold'];
  const subInactiveClasses = ['text-brand-dark', 'hover:text-brand-sage', 'hover:bg-brand-light', 'font-semibold'];

  const mobileActiveClasses = ['text-brand-sage', 'bg-brand-sage-light', 'font-bold'];
  const mobileInactiveClasses = ['text-brand-text', 'hover:text-brand-sage', 'hover:bg-brand-light'];

  const mobileSubActiveClasses = ['text-brand-sage', 'bg-brand-sage-light', 'font-bold'];
  const mobileSubInactiveClasses = ['text-brand-muted', 'hover:text-brand-sage', 'hover:bg-brand-light', 'font-medium'];

  // Section configuration mapping homepage IDs to navbar items
  const sectionsConfig = [
    { id: 'hero', parentId: 'home', subTarget: null },
    { id: 'what-we-do', parentId: 'about', subTarget: 'what-we-do' },
    { id: 'institutional-experience', parentId: 'corporate-solutions', subTarget: null },
    { id: 'accreditations', parentId: 'about', subTarget: 'accreditations' },
    { id: 'why-get-academy', parentId: 'about', subTarget: 'why-get-academy' },
    { id: 'programmes', parentId: 'courses', subTarget: 'programmes' },
    { id: 'digital-strategy', parentId: 'courses', subTarget: 'digital-strategy' },
    { id: 'workplace-performance', parentId: 'courses', subTarget: 'workplace-performance' },
    { id: 'leadership-management', parentId: 'courses', subTarget: 'leadership-management' },
    { id: 'corporate-enquiry', parentId: 'contact', subTarget: null },
  ];

  let currentActiveParent = 'home';
  let currentActiveSub = null;
  let isClickScrolling = false;
  let clickScrollTimer = null;

  function setActiveNav(parentId, subTarget = null) {
    currentActiveParent = parentId;
    currentActiveSub = subTarget;

    // 1. Update Desktop Top-Level Items
    document.querySelectorAll('[data-nav-id]').forEach((el) => {
      const id = el.getAttribute('data-nav-id');
      const chevron = el.querySelector('.dropdown-chevron');

      if (id === parentId) {
        desktopInactiveClasses.forEach(c => el.classList.remove(c));
        desktopActiveClasses.forEach(c => el.classList.add(c));
        if (chevron) {
          chevron.classList.remove('text-brand-muted');
          chevron.classList.add('text-brand-sage');
        }
      } else {
        desktopActiveClasses.forEach(c => el.classList.remove(c));
        desktopInactiveClasses.forEach(c => el.classList.add(c));
        if (chevron) {
          chevron.classList.remove('text-brand-sage');
          chevron.classList.add('text-brand-muted');
        }
      }
    });

    // 2. Update Desktop Dropdown Sub-Items
    document.querySelectorAll('.dropdown-link').forEach((el) => {
      const target = el.getAttribute('data-sub-target');
      if (target && target === subTarget) {
        subInactiveClasses.forEach(c => el.classList.remove(c));
        subActiveClasses.forEach(c => el.classList.add(c));
      } else {
        subActiveClasses.forEach(c => el.classList.remove(c));
        subInactiveClasses.forEach(c => el.classList.add(c));
      }
    });

    // 3. Update Mobile Top-Level Items
    document.querySelectorAll('[data-mobile-nav-id]').forEach((el) => {
      const id = el.getAttribute('data-mobile-nav-id');
      if (id === parentId) {
        mobileInactiveClasses.forEach(c => el.classList.remove(c));
        mobileActiveClasses.forEach(c => el.classList.add(c));
      } else {
        mobileActiveClasses.forEach(c => el.classList.remove(c));
        mobileInactiveClasses.forEach(c => el.classList.add(c));
      }
    });

    // 4. Update Mobile Dropdown Sub-Items
    document.querySelectorAll('[data-mobile-sub-target]').forEach((el) => {
      const target = el.getAttribute('data-mobile-sub-target');
      if (target && target === subTarget) {
        mobileSubInactiveClasses.forEach(c => el.classList.remove(c));
        mobileSubActiveClasses.forEach(c => el.classList.add(c));
      } else {
        mobileSubActiveClasses.forEach(c => el.classList.remove(c));
        mobileSubInactiveClasses.forEach(c => el.classList.add(c));
      }
    });

    // 5. Update Mobile Group Headers
    document.querySelectorAll('[data-mobile-group]').forEach((el) => {
      const groupId = el.getAttribute('data-mobile-group');
      const title = el.querySelector('.mobile-group-title');
      const badge = el.querySelector('.mobile-group-badge');
      if (groupId === parentId) {
        if (title) {
          title.classList.remove('text-brand-dark');
          title.classList.add('text-brand-sage');
        }
        if (badge) {
          badge.classList.remove('bg-white', 'text-brand-sage', 'border-brand-border');
          badge.classList.add('bg-brand-sage', 'text-white', 'border-brand-sage');
        }
      } else {
        if (title) {
          title.classList.remove('text-brand-sage');
          title.classList.add('text-brand-dark');
        }
        if (badge) {
          badge.classList.remove('bg-brand-sage', 'text-white', 'border-brand-sage');
          badge.classList.add('bg-white', 'text-brand-sage', 'border-brand-border');
        }
      }
    });
  }

  function handleNavClick(parentId, subTarget = null, hash = null) {
    isClickScrolling = true;
    if (clickScrollTimer) clearTimeout(clickScrollTimer);
    clickScrollTimer = setTimeout(() => {
      isClickScrolling = false;
      updateActiveOnScroll();
    }, 900);

    setActiveNav(parentId, subTarget);

    if (hash && (window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '')) {
      if (history.pushState) {
        history.pushState(null, '', hash);
      }
    }
  }

  function updateActiveOnScroll() {
    if (isClickScrolling) return;
    if (window.location.pathname !== '/' && window.location.pathname !== '/index.html' && window.location.pathname !== '') {
      return;
    }

    // Top of page
    if (window.scrollY < 120) {
      setActiveNav('home', null);
      return;
    }

    // Near bottom of page
    const isAtBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 60;
    if (isAtBottom) {
      setActiveNav('contact', null);
      return;
    }

    // Offset for sticky navbar
    const offset = 170;
    let currentActive = null;

    for (const sec of sectionsConfig) {
      const el = document.getElementById(sec.id);
      if (el) {
        const rect = el.getBoundingClientRect();
        if (rect.top <= offset) {
          currentActive = sec;
        }
      }
    }

    if (currentActive) {
      setActiveNav(currentActive.parentId, currentActive.subTarget);
    } else {
      setActiveNav('home', null);
    }
  }

  window.addEventListener('scroll', updateActiveOnScroll, { passive: true });

  // Initialize active navigation state based on URL or scroll position
  function initActiveNav() {
    if (window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '') {
      if (window.location.hash) {
        const hashId = window.location.hash.substring(1);
        const match = sectionsConfig.find(s => s.id === hashId);
        if (match) {
          setActiveNav(match.parentId, match.subTarget);
          return;
        }
      }
      updateActiveOnScroll();
    } else {
      const path = window.location.pathname;
      if (path.startsWith('/about')) {
        setActiveNav('about', null);
      } else if (path.startsWith('/courses')) {
        setActiveNav('courses', null);
      } else if (path.startsWith('/corporate-solutions')) {
        setActiveNav('corporate-solutions', null);
      } else if (path.startsWith('/contact')) {
        setActiveNav('contact', null);
      }
    }
  }

  initActiveNav();
  window.addEventListener('hashchange', initActiveNav);

  // Desktop dropdown controller
  const navDropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');

  function closeAllDesktopDropdowns() {
    navDropdowns.forEach((dd) => {
      const toggle = dd.querySelector<HTMLButtonElement>('.dropdown-toggle');
      const menu = dd.querySelector<HTMLElement>('.dropdown-menu');
      const chevron = dd.querySelector<HTMLElement>('.dropdown-chevron');
      if (menu) menu.classList.add('hidden');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.classList.remove('rotate-180');
    });
  }

  navDropdowns.forEach((dd) => {
    const toggle = dd.querySelector<HTMLButtonElement>('.dropdown-toggle');
    const menu = dd.querySelector<HTMLElement>('.dropdown-menu');
    const chevron = dd.querySelector<HTMLElement>('.dropdown-chevron');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = !menu.classList.contains('hidden');
      closeAllDesktopDropdowns();
      if (!isCurrentlyOpen) {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        if (chevron) chevron.classList.add('rotate-180');
      }
    });

    // Close when any item inside this dropdown is clicked
    const links = menu.querySelectorAll<HTMLAnchorElement>('.dropdown-link');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        closeAllDesktopDropdowns();
      });
    });
  });

  // Close desktop dropdowns on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target || !target.closest('.nav-dropdown')) {
      closeAllDesktopDropdowns();
    }
  });

  // Close desktop dropdowns on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllDesktopDropdowns();
    }
  });

  // Mobile navigation toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function closeMobileNav() {
    if (toggleBtn && mobileNav && iconOpen && iconClose) {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileNav.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    }
  }

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Automatically close mobile menu when any navigation link is clicked
    const drawerLinks = mobileNav.querySelectorAll('a');
    drawerLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMobileNav();
      });
    });
  }

  // Smooth scroll handler for anchor links when on the homepage
  document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      const hash = href.startsWith('/#') ? href.slice(1) : href;
      if (window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '') {
        const targetElement = document.querySelector(hash);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth' });

          const targetId = hash.startsWith('#') ? hash.slice(1) : hash;
          const match = sectionsConfig.find(s => s.id === targetId);
          if (match) {
            handleNavClick(match.parentId, match.subTarget, hash);
          } else {
            handleNavClick('home', null, hash);
          }
        }
      }
    });
  });

  // Handle Home link and Logo link click
  document.querySelectorAll('a[href="/"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        handleNavClick('home', null, '#');
      }
    });
  });
</script>
