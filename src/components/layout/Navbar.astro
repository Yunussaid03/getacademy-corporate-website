---
import { Menu, X } from 'lucide-astro';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Courses', href: '/courses' },
  { label: 'Corporate Solutions', href: '/corporate-solutions' },
  { label: 'Our Trainers', href: '/trainers' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-border/80 transition-all shadow-sm">
  <!-- Main Navigation -->
  <div class="container-custom py-3.5 flex items-center justify-between">
    <!-- Logo and Identity -->
    <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-brand-sage rounded-lg p-1">
      <img 
        src="/assets/brand/GETA-Logo.png" 
        alt="GET Academy Logo" 
        class="h-11 w-auto object-contain transform transition group-hover:scale-105"
        width="115"
        height="112"
      />
      <div class="flex flex-col">
        <span class="font-extrabold text-xl sm:text-2xl tracking-tight text-brand-dark leading-none">
          GET <span class="text-brand-sage">ACADEMY</span>
        </span>
        <span class="text-[10px] sm:text-[11px] font-semibold text-brand-muted tracking-wider uppercase mt-1">
          Human Capital Development
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3.5 py-2 rounded-md text-sm font-semibold transition-all ${
            isActive(item.href)
              ? 'text-brand-sage bg-brand-sage-light font-bold border-b-2 border-brand-sage'
              : 'text-brand-text hover:text-brand-sage hover:bg-brand-light'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Action Buttons -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-sage"
      >
        Corporate Enquiry
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="lg:hidden p-2 rounded-lg text-brand-text hover:text-brand-sage hover:bg-brand-light focus:outline-none focus:ring-2 focus:ring-brand-sage"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <Menu id="menu-icon-open" class="w-6 h-6 block" />
      <X id="menu-icon-close" class="w-6 h-6 hidden" />
    </button>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-3 py-2.5 rounded-md text-base font-medium ${
          isActive(item.href)
            ? 'text-brand-sage bg-brand-sage-light font-bold'
            : 'text-brand-text hover:text-brand-sage hover:bg-brand-light'
        }`}
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 border-t border-brand-border mt-3">
      <a
        href="/contact"
        class="block w-full text-center px-4 py-2.5 text-sm font-bold rounded-lg text-white bg-brand-sage hover:bg-brand-sage-dark"
      >
        Corporate Enquiry
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile navigation toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
